+bool ShaderResources::ReadsGuestRange(std::uint64_t address, std::size_t bytes) const {
+    const auto overlaps=[&](std::uint64_t begin,std::uint64_t size) {
+        if (bytes == 0 || size == 0) return false;
+        // Subtractions avoid wrapping either end of the address range.
+        return begin >= address ? begin-address < bytes : address-begin < size;
+    };
+    if (HoldsLease()) return true; // Address-based reads have no complete descriptor bound.
+    for (const auto& allocation:allocations) if (allocation.guest && overlaps(allocation.address,allocation.size)) return true;
+    for (const auto& range:describedRanges) if (overlaps(range.address,range.bytes) || (range.dccAddress != 0 && overlaps(range.dccAddress,1u))) return true;
+    return ReadsOverlap(address,bytes);
 }
 
