--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/GpuColorSampleTiler.hpp
@@ -0,0 +1,65 @@
+#ifndef ANYPS5_GPU_COLOR_SAMPLE_TILER_HPP
+#define ANYPS5_GPU_COLOR_SAMPLE_TILER_HPP
+#include "prx/libSceAgcDriver/Graphics/include/State.hpp"
+#include <mutex>
+
+namespace AgcDriver::Graphics {
+// Full-buffer storage views created on the stated device. The caller owns the
+// buffers, supplies their real usage/state, and retains them until completion.
+struct ColorSampleTilingBufferAccess {
+    VkDevice device = VK_NULL_HANDLE;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceSize offset = 0, bytes = 0;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+
+// One device owns at most six immutable programs (2/4/8 samples, both directions).
+// The exact opt-in pixel-owned8 schema is captured once per owner; 2/4 retain
+// the original sample-owned schema, and existing owners never change variants.
+// No guest address is cached. Only uncompressed RGBA8 R64KB_X is qualified.
+class GpuColorSampleTiler {
+public:
+    explicit GpuColorSampleTiler(const Context& context);
+    ~GpuColorSampleTiler();
+    GpuColorSampleTiler(const GpuColorSampleTiler&) = delete;
+    GpuColorSampleTiler& operator=(const GpuColorSampleTiler&) = delete;
+    static bool Supports(const Context& context, const ColorTarget& color);
+    class Transfer {
+    public:
+        Transfer(GpuColorSampleTiler& owner, const ColorTarget& color);
+        ~Transfer();
+        Transfer(const Transfer&) = delete;
+        Transfer& operator=(const Transfer&) = delete;
+        // Retile preserves every padding word of the destination's prior seed.
+        // Each call retains distinct descriptors until this Transfer is destroyed.
+        // The owner and both buffers must outlive this Transfer and its GPU fence.
+        void Record(VkCommandBuffer commands, bool retile,
+                    ColorSampleTilingBufferAccess source, ColorSampleTilingBufferAccess destination,
+                    VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess);
+    private:
+        GpuColorSampleTiler& owner;
+        std::uint32_t samples;
+        std::array<std::uint32_t, 5> parameters;
+        std::vector<VkDescriptorPool> pools;
+    };
+private:
+    void release() noexcept;
