+// Only query support may enable native null descriptors. Other robustness2
+// features are deliberately left disabled, preserving their separate contracts.
+inline VkPhysicalDeviceRobustness2FeaturesEXT NativeNullDescriptorFeatures(bool extensionPresent, VkBool32 available) {
+    VkPhysicalDeviceRobustness2FeaturesEXT enabled{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ROBUSTNESS_2_FEATURES_EXT};
+    enabled.nullDescriptor = extensionPresent && available == VK_TRUE ? VK_TRUE : VK_FALSE;
+    return enabled;
+}
 
 inline bool StorageBufferUpdateAfterBindSupported(VkBool32 available, VkBool32 robustBufferAccess, const VkPhysicalDeviceDescriptorIndexingPropertiesEXT& properties) {
     return available == VK_TRUE && (robustBufferAccess == VK_FALSE || properties.robustBufferAccessUpdateAfterBind == VK_TRUE);
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/ImageDescriptorValidation.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/ImageDescriptorValidation.hpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/ImageDescriptorValidation.hpp
@@ -0,0 +1,40 @@
+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_IMAGEDESCRIPTORVALIDATION_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_IMAGEDESCRIPTORVALIDATION_HPP
+#include "prx/libSceAgcDriver/Graphics/include/Context.hpp"
+#include "Recompiler.hpp"
+#include <span>
+namespace AgcDriver::Graphics {
+inline void ValidateImageDescriptorPolicy(const Context& context) {
+    Require(ShaderRecompiler::ValidImageDescriptorPolicy(context.imageDescriptorPolicy), "invalid image descriptor policy");
+    Require(context.imageDescriptorPolicy == ShaderRecompiler::ImageDescriptorPolicyFor(context.nullDescriptors), "image descriptor policy disagrees with enabled native nullDescriptor");
+}
+// Validate the compact, selected physical heap, including present zero/padded
+// entries. Empty/inactive heaps are removed by DescriptorBindingBuilder, not by
+// treating a zero guest address as inactive here.
+inline void ValidateGuestImageDescriptors(const Context& context, const ShaderRecompiler::DescriptorBinding& binding, VkShaderStageFlags stages) {
+    ValidateImageDescriptorPolicy(context);
+    if (binding.kind == ShaderRecompiler::DescriptorKind::Sampler || context.imageDescriptorPolicy == ShaderRecompiler::ImageDescriptorPolicy::NativeNull) return;
+    Require(binding.role == ShaderRecompiler::DescriptorRole::GuestImages, "image policy requires a guest image binding");
+    Require(binding.guestDescriptor.size() == static_cast<std::size_t>(binding.count) * 8u, "image policy requires 8-dword guest descriptors");
+    for (std::uint32_t element = 0u; element < binding.count; ++element) {
+        const auto* words = binding.guestDescriptor.data() + static_cast<std::size_t>(element) * 8u;
+        if (words[0] == 0u && (words[1] & 0xffu) == 0u) {
+            throw std::runtime_error("AGC graphics: requires-valid-images rejects zero guest image descriptor (stages=" + std::to_string(stages) + ", set=" + std::to_string(binding.descriptorSet) + ", binding=" + std::to_string(binding.binding) + ", element=" + std::to_string(element) + ", kind=" + std::to_string(static_cast<std::uint32_t>(binding.kind)) + ", shape=" + (binding.imageShape.has_value() ? std::to_string(static_cast<std::uint32_t>(*binding.imageShape)) : "unspecified") + ")");
+        }
+    }
+}
+// Defense in depth before initial writes and deep-captured write replay. This
+// checks the actual Vulkan view, independently of the guest base validation.
+inline void ValidateImageDescriptorWrites(const Context& context, std::span<const VkWriteDescriptorSet> writes) {
+    ValidateImageDescriptorPolicy(context);
+    if (context.imageDescriptorPolicy == ShaderRecompiler::ImageDescriptorPolicy::NativeNull) return;
+    for (const auto& write : writes) {
+        if (write.descriptorType != VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE && write.descriptorType != VK_DESCRIPTOR_TYPE_STORAGE_IMAGE && write.descriptorType != VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER && write.descriptorType != VK_DESCRIPTOR_TYPE_INPUT_ATTACHMENT) continue;
+        Require(write.pImageInfo != nullptr, "image descriptor write is missing image info");
+        for (std::uint32_t element = 0u; element < write.descriptorCount; ++element) {
+            Require(write.pImageInfo[element].imageView != VK_NULL_HANDLE, "requires-valid-images rejects null Vulkan image view (binding=" + std::to_string(write.dstBinding) + ", element=" + std::to_string(write.dstArrayElement + element) + ")");
+        }
+    }
+}
+}
+#endif
