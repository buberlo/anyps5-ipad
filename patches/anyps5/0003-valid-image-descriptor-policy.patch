+std::vector<std::uint8_t> requestBytes(std::string_view text) {
+    constexpr std::string_view alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::vector<std::uint8_t> bytes;
+    std::uint32_t word = 0u;
+    std::uint32_t bits = 0u;
+    for (const char c : text) {
+        if (c == '=') break;
+        const auto value = alphabet.find(c);
+        require(value != std::string_view::npos, "invalid base64 in serializer fixture");
+        word = (word << 6u) | static_cast<std::uint32_t>(value);
+        bits += 6u;
+        if (bits >= 8u) { bits -= 8u; bytes.push_back(static_cast<std::uint8_t>(word >> bits)); }
+    }
+    return bytes;
+}
+
+std::string requestText(std::span<const std::uint8_t> bytes) {
+    constexpr std::string_view alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    std::string text;
+    std::uint32_t word = 0u;
+    std::uint32_t bits = 0u;
+    for (const auto byte : bytes) {
+        word = (word << 8u) | byte;
+        bits += 8u;
+        while (bits >= 6u) { bits -= 6u; text += alphabet[(word >> bits) & 63u]; }
+    }
+    if (bits != 0u) text += alphabet[(word << (6u - bits)) & 63u];
+    while (text.size() % 4u != 0u) text += '=';
+    return text;
+}
