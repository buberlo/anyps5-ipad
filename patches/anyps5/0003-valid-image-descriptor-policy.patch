+#ifndef CORE_SHADER_RECOMPILER_IMAGEDESCRIPTORPOLICY_HPP
+#define CORE_SHADER_RECOMPILER_IMAGEDESCRIPTORPOLICY_HPP
+#include <cstdint>
+namespace ShaderRecompiler {
+// Host descriptor legality policy. This does not advertise a SPIR-V capability
+// or emulate null image accesses; shader instructions remain unchanged.
+enum class ImageDescriptorPolicy : std::uint32_t {
+    RequiresValidImages = 0u,
+    NativeNull = 1u,
+};
+inline bool ValidImageDescriptorPolicy(ImageDescriptorPolicy policy) {
+    return policy == ImageDescriptorPolicy::RequiresValidImages || policy == ImageDescriptorPolicy::NativeNull;
+}
+inline ImageDescriptorPolicy ImageDescriptorPolicyFor(bool enabledNativeNull) {
+    return enabledNativeNull ? ImageDescriptorPolicy::NativeNull : ImageDescriptorPolicy::RequiresValidImages;
+}
+}
