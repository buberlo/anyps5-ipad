+    mismatch.imageDescriptorPolicy = ImageDescriptorPolicy::NativeNull;
+    expectFailure([&] { ValidateImageDescriptorPolicy(mismatch); }, "disagrees with enabled native nullDescriptor");
+    mismatch = native;
+    mismatch.imageDescriptorPolicy = ImageDescriptorPolicy::RequiresValidImages;
