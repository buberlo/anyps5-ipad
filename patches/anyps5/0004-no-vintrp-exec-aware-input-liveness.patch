+enum class Tag:unsigned char { Unknown, EntryLow, EntryHigh, Top };
+inline Tag Meet(Tag a,Tag b){if(a==Tag::Top)return b;if(b==Tag::Top)return a;return a==b?a:Tag::Unknown;}
+struct State {
+ std::bitset<256> clean;
+ std::array<Tag,110> tags{};
+ bool subset=true;
+ bool coversEntry=true;
+ bool wholeQuad=false;
+ bool operator==(const State&)const=default;
+};
+inline State Top(){State s;s.clean.set();s.tags.fill(Tag::Top);s.wholeQuad=true;return s;}
+inline State Entry(){State s;s.tags.fill(Tag::Unknown);s.tags[108]=Tag::EntryLow;s.tags[109]=Tag::EntryHigh;return s;}
+inline State Meet(State a,const State& b){a.clean&=b.clean;for(unsigned n=0;n<110;++n)a.tags[n]=Meet(a.tags[n],b.tags[n]);a.subset&=b.subset;a.coversEntry&=b.coversEntry;a.wholeQuad&=b.wholeQuad;return a;}
+// Top is optimistic only during the must-analysis. Reachable final states must
+// have no Top tag, so this predicate becomes exact during the final read pass.
+inline bool EntryMask(const State& s){return (s.tags[108]==Tag::EntryLow||s.tags[108]==Tag::Top)&&(s.tags[109]==Tag::EntryHigh||s.tags[109]==Tag::Top);}
+inline std::array<Tag,2> MaskSource(const State& s,const RdnaOperand& source){
+ const auto base=Scalar(source);if(base&&*base<109)return {s.tags[*base],s.tags[*base+1]};return {Tag::Unknown,Tag::Unknown};
+}
+inline bool Zero(const RdnaOperand& source){return (source.kind==RdnaOperandKind::IntegerInlineConstant||source.kind==RdnaOperandKind::LiteralConstant||source.kind==RdnaOperandKind::Null)&&source.value==0;}
+inline bool Transfer(State& state,const RdnaProgram& decoded,const BasicBlock& block,const std::vector<Effects>& effects,
+                     const std::bitset<256>& raw,bool checkReads){
+ std::bitset<256> scoped;
+ for(auto n=block.instructionBegin;n<block.instructionEnd;++n){
+  const auto& i=decoded.instructions[n];const auto& fx=effects[n];
+  if(checkReads&&i.op==RdnaOpcode::ImageSample){
+   // Implicit derivatives also observe neighboring helper coordinates. An
+   // entry-only overwrite cannot define their raw inputs. Admit a directly
+   // raw coordinate only after a full write in this same whole-quad epoch.
+   const auto coordinates=i.imageDimension==RdnaImageDimension::Dim2D?2u:i.imageDimension==RdnaImageDimension::Dim3D?3u:0u;
+   for(unsigned v=i.source0.reg;v<i.source0.reg+coordinates;++v)
+    if(raw[v]&&(!state.wholeQuad||!scoped[v]))return false;
+  }
+  if(checkReads)for(const auto& r:fx.reads)for(unsigned v=r.base;v<r.base+r.count;++v)
+   if(raw[v]&&!scoped[v]&&(!state.subset||!state.clean[v]))return false;
+  const auto source=MaskSource(state,i.source0);
+  const std::array<Tag,2> oldExec{state.tags[108],state.tags[109]};
+  for(const auto& r:fx.scalarWrites)for(unsigned s=r.base;s<r.base+r.count;++s)state.tags[s]=Tag::Unknown;
+  if(fx.mask==MaskEffect::Copy64){
