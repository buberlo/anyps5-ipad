+ // straight-line guest block; the older non-WQM CFG proof stays unchanged.
+ if(cfg.blocks.size()!=1u&&std::any_of(effects.begin(),effects.end(),[](const auto& f){return f.mask==MaskEffect::WholeQuad64;}))return false;
+ std::vector<unsigned> ids;for(const auto& b:cfg.blocks){if(std::find(ids.begin(),ids.end(),b.id)!=ids.end()||b.instructionBegin>=b.instructionEnd||b.instructionEnd>decoded.instructions.size())return false;ids.push_back(b.id);}
