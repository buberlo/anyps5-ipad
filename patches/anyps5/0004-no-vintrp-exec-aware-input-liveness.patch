+inline bool Prove(const RdnaProgram& decoded,const ControlFlowGraph& cfg,const std::set<unsigned>& rawSet){
+ if(decoded.instructions.empty()||decoded.instructions.size()>4096||cfg.blocks.empty()||cfg.blocks.size()>256||cfg.unsupported||cfg.irreducible||rawSet.empty()||rawSet.size()>14)return false;
