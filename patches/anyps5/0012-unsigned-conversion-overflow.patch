 #include <cwchar>
 #include <cstdio>
 #include <limits>
+#include <cerrno>
 
 #include "prx/libc/include/General.hpp"
 
+static unsigned long long GuestUnsignedConversion(const char* text, char** end, int base) {
+    // Some Windows CRTs negate a saturated negative magnitude, returning 1
+    // with ERANGE. The guest requires ULLONG_MAX on overflow of either sign.
+    const int saved = errno;
+    errno = 0;
+    const auto value = std::strtoull(text, end, base);
+    const int error = errno;
+    if (!error) errno = saved;
+    return error == ERANGE ? std::numeric_limits<unsigned long long>::max() : value;
+}
