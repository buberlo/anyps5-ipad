new file mode 100644
index 0000000000000000000000000000000000000000..98032928c7be1c03f48451c5d931e76c3632f4f7
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Execution/include/SwapchainImages.hpp
@@ -0,0 +1,20 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+namespace AgcDriver {
+inline std::uint32_t SelectSwapchainImages(std::uint32_t minimum, std::uint32_t maximum, const char* option) {
+    if (!minimum || (maximum && maximum < minimum))
+        throw std::runtime_error("Invalid surface swapchain image limits");
+    std::uint32_t requested = 3;
+    if (option) {
+        if (std::strcmp(option, "2") == 0) requested = 2;
+        else if (std::strcmp(option, "3") != 0)
+            throw std::invalid_argument("APS5_SWAPCHAIN_IMAGES must be 2 or 3");
+    }
+    const auto count = std::max(minimum, requested);
+    return maximum ? std::min(count, maximum) : count;
+}
+}
