+bool frameCountersEnabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("APS5_FRAME_COUNTERS");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+void noteFrameCounter(std::chrono::steady_clock::time_point started, std::chrono::steady_clock::duration vblankWait, std::chrono::steady_clock::duration presentWait) {
+    struct Window {
+        std::uint64_t frames = 0;
+        std::int64_t cpuNs = 0;
+        std::int64_t vblankWaitNs = 0;
+        std::int64_t presentNs = 0;
+        std::int64_t intervalNs = 0;
+        std::chrono::steady_clock::time_point opened{};
+        std::chrono::steady_clock::time_point previous{};
+    };
+    static Window window;
+    const auto finished = std::chrono::steady_clock::now();
+    if (window.opened == std::chrono::steady_clock::time_point{}) window.opened = finished;
+    if (window.previous != std::chrono::steady_clock::time_point{}) window.intervalNs += std::chrono::duration_cast<std::chrono::nanoseconds>(finished - window.previous).count();
+    window.previous = finished;
+    auto cpu = (finished - started) - vblankWait - presentWait;
+    if (cpu.count() < 0) cpu = {};
+    window.cpuNs += std::chrono::duration_cast<std::chrono::nanoseconds>(cpu).count();
+    window.vblankWaitNs += std::chrono::duration_cast<std::chrono::nanoseconds>(vblankWait).count();
+    window.presentNs += std::chrono::duration_cast<std::chrono::nanoseconds>(presentWait).count();
+    ++window.frames;
+    if (finished - window.opened < std::chrono::seconds(1)) return;
+    const auto frames = window.frames;
+    const auto averageMs = [&](std::int64_t ns) { return frames == 0 ? 0.0 : static_cast<double>(ns) / static_cast<double>(frames) / 1.0e6; };
+    std::fprintf(stderr, "[frame-counters] frames=%llu cpu_ms=%.3f vblank_wait_ms=%.3f present_ms=%.3f interval_ms=%.3f\n", static_cast<unsigned long long>(frames), averageMs(window.cpuNs), averageMs(window.vblankWaitNs), averageMs(window.presentNs), averageMs(window.intervalNs));
+    std::fflush(stderr);
+    window = {};
+    window.opened = finished;
+    window.previous = finished;
+}
