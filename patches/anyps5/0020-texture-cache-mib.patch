+std::uint64_t TextureCache::BudgetBytes() {
+    static const std::uint64_t bytes = [] {
+        const char* value = std::getenv("APS5_TEXTURE_CACHE_MIB");
+        if (value == nullptr || *value == '\0') return budget;
+        char* end = nullptr;
+        const unsigned long long mib = std::strtoull(value, &end, 10);
+        if (end == value || *end != '\0' || mib < 1 || mib > 4096) {
+            std::fprintf(stderr, "[texture-cache] APS5_TEXTURE_CACHE_MIB=%s ignored; cap stays 256 MiB\n", value);
+            return budget;
+        }
+        std::fprintf(stderr, "[texture-cache] cap %llu MiB (APS5_TEXTURE_CACHE_MIB)\n", mib);
+        return static_cast<std::uint64_t>(mib) << 20;
+    }();
+    return bytes;
+}
