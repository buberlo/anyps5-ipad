diff --git a/core/libs/tests/GuestShaderAlignment.cpp b/core/libs/tests/GuestShaderAlignment.cpp
new file mode 100644
index 00000000..41a2051e
--- /dev/null
+++ b/core/libs/tests/GuestShaderAlignment.cpp
@@ -0,0 +1,57 @@
+#include "SceShaders.hpp"
+#include "prx/libSceAgc/Shader/include/CreateShader.hpp"
+#include "prx/libSceAgc/Shader/include/ShaderConstants.hpp"
+#include <array>
+#include "prx/libc/include/general/VabiMacros.hpp"
+#include <new>
+#include <cstring>
+#include <stdexcept>
+
+extern "C" int APS5_VABI sceAgcCreateShader(Shader**, void*, const volatile void*);
+
+namespace {
+const Shader* registered = nullptr;
+void Require(bool value) { if (!value) throw std::runtime_error("guest shader header alignment regression"); }
+void Relative(void* field, const void* target) {
+    const auto relative = reinterpret_cast<std::uintptr_t>(target) - reinterpret_cast<std::uintptr_t>(field);
+    std::memcpy(field, &relative, sizeof(relative));
+}
+}
+// The registry is the test boundary; production CreateShader and ShaderUtils
+// perform the in-place relocations, register patching and validation.
+extern "C" void AgcDriverRegisterShader_nid_postfix(const Shader* shader) { registered = shader; }
+int main() {
+    using namespace ShaderRegs;
+    alignas(8) std::array<std::byte, 4 + sizeof(Shader) + sizeof(ShaderUserData) + 16> storage{};
+    auto* shader = new (storage.data() + 4) Shader{};
+    auto* user = new (storage.data() + 4 + sizeof(Shader)) ShaderUserData{};
+    auto* regs = new (storage.data() + 4 + sizeof(Shader) + sizeof(ShaderUserData)) ShaderRegister[2]{};
+    Require(reinterpret_cast<std::uintptr_t>(shader) % 8 == 4);
+    Require(reinterpret_cast<std::uintptr_t>(user) % 8 == 4);
+    alignas(256) std::array<std::uint32_t, 64> code{};
+    code[0] = 0xbf810000;
+    shader->file_header = SHADER_FILE_HEADER_MAGIC;
+    shader->version = SHADER_VERSION;
+    shader->header_size = sizeof(Shader);
+    shader->shader_size = sizeof(code);
+    shader->type = static_cast<std::uint8_t>(ShaderBinaryType::Cs);
+    shader->num_sh_registers = 2;
+    regs[0] = {COMPUTE_PGM_LO, 0}; regs[1] = {COMPUTE_PGM_LO + 1, 0};
+    Relative(&shader->user_data, user);
+    Relative(&shader->sh_registers, regs);
+    std::uint16_t resource = 3;
+    Relative(&user->direct_resource_offset, &resource);
+    Shader* output = nullptr;
+    Require(sceAgcCreateShader(&output, shader, code.data()) == 0);
+    Require(output == shader && registered == shader);
+    Require(shader->user_data == user && shader->sh_registers == regs && shader->code == code.data());
+    Require(user->direct_resource_offset == &resource);
+    Require(user->sharp_resource_offset[0] == nullptr && shader->cx_registers == nullptr);
+    const auto base = reinterpret_cast<std::uintptr_t>(code.data());
+    Require(regs[0].value == std::uint32_t(base >> 8) && regs[1].value == std::uint32_t(base >> 40));
+    // The changed header layout must not accept a misaligned code address.
+    bool rejected = false;
+    try { sceAgcCreateShader(&output, shader, reinterpret_cast<std::byte*>(code.data()) + 4); }
+    catch (const std::runtime_error&) { rejected = true; }
+    Require(rejected);
+}
