+void shaderEnginePartitionTests() {
+    auto queue = makeState();
+    const auto reference = AgcDriver::Graphics::DecodeState(queue);
+    const auto baselineRejection = AgcDriver::Graphics::DrawRejection(queue, false);
+    queue.context[0x293] = 0x06020000;
+    Require(AgcDriver::Graphics::DrawRejection(queue, false) == baselineRejection, "hardware shader-engine partition changed draw admission");
+    const auto state = AgcDriver::Graphics::DecodeState(queue);
+    Require(state.color.address == reference.color.address && state.topology == reference.topology && state.renderExtent.width == reference.renderExtent.width && state.renderExtent.height == reference.renderExtent.height, "hardware partition changed the logical draw");
+    for (const auto unsupported : {0x00010000u, 0x00004000u, 0x08000000u}) {
+        queue.context[0x293] = 0x06020000 | unsupported;
+        Require(AgcDriver::Graphics::DrawRejection(queue, false).find("sample iteration, primitive discard or out-of-order rasterization") != std::string::npos, "logical raster control was silently accepted");
+        expectFailure([&] { AgcDriver::Graphics::DecodeState(queue); }, "sample iteration, primitive discard or out-of-order rasterization");
+    }
+}
