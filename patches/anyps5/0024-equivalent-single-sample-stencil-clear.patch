+void equivalentStencilClearTests() {
+    auto queue = makeState();
+    queue.context[0x000] = 0x22;
+    queue.context[0x002] = 0;
+    queue.context[0x007] = (1u << 16u) | 3u;
+    queue.context[0x00a] = 0;
+    queue.context[0x00b] = 0;
+    queue.context[0x010] = 0xa0000183;
+    queue.context[0x011] = 0x20000181;
+    for (const auto offset : {0x012u, 0x014u}) queue.context[offset] = 0x100;
+    for (const auto offset : {0x013u, 0x015u}) queue.context[offset] = 0x200;
+    queue.context[0x10b] = 0x333;
+    queue.context[0x10c] = 0xffffff00;
+    queue.context[0x10d] = 0xffffff00;
+    queue.context[0x200] = 0x771;
+    queue.context[0x203] = 0x10;
+    const auto verify = [&] {
+        const auto state = AgcDriver::Graphics::DecodeState(queue);
+        Require(state.stencilTest && !state.depthTest && !state.depthWrite && !state.depthBoundsTest,
+                "equivalent stencil clear changed depth/stencil enables");
+        for (const auto& face : {state.stencilFront, state.stencilBack}) {
+            Require(face.compareOp == VK_COMPARE_OP_ALWAYS && face.writeMask == 0xff &&
+                    face.reference == state.depth->clearStencil &&
+                    face.failOp == VK_STENCIL_OP_REPLACE && face.passOp == VK_STENCIL_OP_REPLACE &&
+                    face.depthFailOp == VK_STENCIL_OP_REPLACE, "equivalent stencil clear lost replacement state");
+        }
+    };
+    verify();
+    queue.context[0x00a] = 0x7a;
+    queue.context[0x10c] |= 0x7a;
+    queue.context[0x10d] |= 0x7a;
+    queue.context[0x200] |= 0x700080; // independent back-face state
+    queue.context[0x10b] |= 0x333000;
+    verify();
+    std::vector<AgcDriver::Graphics::RegisterRead> reads;
+    AgcDriver::Graphics::RegisterReadLog() = &reads;
+    verify();
+    AgcDriver::Graphics::RegisterReadLog() = nullptr;
+    for (const auto read : reads) Require(AgcDriver::Graphics::DrawKeyCovers(read),
+                                         "DrawKeyRegisters lacks an equivalent stencil clear register");
+    const auto reject = [&](std::uint32_t offset, std::uint32_t value, const char* reason) {
+        const auto previous = queue.context[offset];
+        queue.context[offset] = value;
+        expectFailure([&] { AgcDriver::Graphics::DecodeState(queue); }, reason);
+        queue.context[offset] = previous;
+    };
+    reject(0x00a, 0x7b, "stencil clear");
+    reject(0x10c, 0xff7fff7a, "stencil clear"); // partial front write mask
+    reject(0x10d, 0xffffff7b, "stencil clear"); // different back reference
+    reject(0x10b, 0x333330, "stencil clear"); // front fail keeps
+    reject(0x10b, 0x330333, "stencil clear"); // back fail keeps
+    reject(0x200, 0x7007f3, "stencil clear"); // depth test enabled
+    reject(0x200, 0x7007f5, "stencil clear"); // depth write enabled
+    reject(0x200, 0x7007f9, "stencil clear"); // depth bounds enabled
+    reject(0x200, 0x7002f1, "stencil clear"); // front compare is equal
+    reject(0x200, 0x2007f1, "stencil clear"); // back compare is equal
+    reject(0x203, 0x50, "stencil clear"); // shader kill enabled
+    reject(0x203, 0x00, "stencil clear"); // early Z order
+    reject(0x002, 0x02000000, "stencil clear"); // read-only stencil
+    reject(0x011, 0x20000180, "stencil clear"); // no stencil plane
+    reject(0x010, 0xa000018f, "multisampled");
+    reject(0x2f8, 0x0030e003, "multisampling");
+    for (const auto bit : {0u, 2u, 3u, 4u, 7u, 8u, 12u})
+        reject(0x000, 0x22 | (1u << bit), "DB_RENDER_CONTROL");
+}
