+// A single-sample stencil clear can follow the ordinary stencil pipeline only
+// when that pipeline already replaces every covered stencil sample with exactly
+// DB_STENCIL_CLEAR. No depth/bounds test, partial write mask, shader kill, or
+// early depth/stencil side effects may change which samples are written.
+// This is not a general DB clear implementation: other maintenance draws remain
+// rejected, and geometry, scissor and sample coverage still run normally.
+void validateEquivalentStencilClear(const Registers& cx, std::uint32_t depthControl) {
+    const auto clear = read(cx, 0x00a) & 0xffu;
+    const auto face = [clear](std::uint32_t compare, std::uint32_t ops, std::uint32_t refMask) {
+        return compare == 7u && (ops & 0xfffu) == 0x333u &&
+               (refMask & 0xffu) == clear && ((refMask >> 16u) & 0xffu) == 0xffu;
+    };
+    const auto ops = read(cx, 0x10b);
+    const auto shader = read(cx, 0x203);
+    Require((depthControl & 0xfu) == 1u && (read(cx, 0x011) & 1u) != 0 &&
+            (read(cx, 0x002) & 0x02000000u) == 0 &&
+            (shader & 0x70u) == 0x10u && // Z_ORDER=LATE_Z, KILL_ENABLE=0
+            face((depthControl >> 8u) & 7u, ops, read(cx, 0x10c)) &&
+            ((depthControl & 0x80u) == 0 ||
+             face((depthControl >> 20u) & 7u, ops >> 12u, read(cx, 0x10d))),
+            "stencil clear is not equivalent to a late, always-pass full-mask replacement draw (DB_RENDER_CONTROL)");
+}
