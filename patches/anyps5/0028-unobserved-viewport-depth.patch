+VkViewport ResolveUnobservedViewportDepth(const Context& context, const State& state, std::span<const CompiledShader> shaders) {
+    auto viewport = state.viewport;
+    if (context.depthRangeUnrestricted ||
+        (viewport.minDepth >= 0 && viewport.minDepth <= 1 && viewport.maxDepth >= 0 && viewport.maxDepth <= 1) ||
+        !std::isfinite(viewport.minDepth) || !std::isfinite(viewport.maxDepth) ||
+        state.depthTest || state.depthWrite || state.depthBoundsTest || state.depthBias || state.depthClamp)
+        return viewport;
+    // Stencil tests do not consume Z. Preserve clip-space clipping (including
+    // negativeOneToOne), geometry, XY, interpolation and every stencil operation.
+    // Reject all FragCoord use conservatively, even an XY-only declaration, and
+    // any fragment depth export. ValidateShaders still validates the programs.
+    unsigned fragments = 0;
+    for (const auto& shader : shaders) {
+        if (shader.stage != ShaderRecompiler::ShaderStage::Fragment) continue;
+        if (++fragments != 1 || shader.program == nullptr) return viewport;
+        const auto& words = shader.program->spirv.Words();
+        if (words.size() < 5 || words[0] != 0x07230203u) return viewport;
+        unsigned entryPoints = 0;
+        for (std::size_t offset = 5; offset < words.size();) {
+            const auto count = words[offset] >> 16u;
+            const auto opcode = static_cast<spv::Op>(words[offset] & 0xffffu);
+            if (count == 0 || count > words.size() - offset) return viewport;
+            if (opcode == spv::OpEntryPoint &&
+                (++entryPoints != 1 || count < 4 || words[offset + 1] != spv::ExecutionModelFragment)) return viewport;
+            const auto observes = [](std::uint32_t builtin) {
+                return builtin == spv::BuiltInFragCoord || builtin == spv::BuiltInFragDepth;
+            };
+            if (opcode == spv::OpDecorate && count >= 4 && words[offset + 2] == spv::DecorationBuiltIn && observes(words[offset + 3])) return viewport;
+            if (opcode == spv::OpMemberDecorate && count >= 5 && words[offset + 3] == spv::DecorationBuiltIn && observes(words[offset + 4])) return viewport;
+            if (opcode == spv::OpDecorateId && count >= 3 && words[offset + 2] == spv::DecorationBuiltIn) return viewport;
+            if (opcode == spv::OpExecutionMode && count >= 3 && words[offset + 2] == spv::ExecutionModeDepthReplacing) return viewport;
+            offset += count;
+        }
+        if (entryPoints != 1) return viewport;
+    }
+    if (fragments == 1) {
+        viewport.minDepth = 0.0f;
+        viewport.maxDepth = 1.0f;
+    }
+    return viewport;
 }
 
