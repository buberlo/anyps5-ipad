+void ReplayUnobservedViewport(const char* registersPath, const char* fragmentPath) {
+    using namespace AgcDriver::Graphics;
+    std::ifstream file(registersPath, std::ios::binary | std::ios::ate);
+    Require(file && file.tellg() <= 2 * 1024 * 1024, "missing or oversized register capture");
+    file.seekg(0);
+    AgcDriver::QueueState queue;
+    for (std::string line; std::getline(file, line);) {
+        std::istringstream input(line);
+        std::string bank;
+        std::uint32_t offset, value;
+        if (!(input >> bank >> std::hex >> offset >> value)) continue;
+        if (bank == "context") queue.context[offset] = value;
+        if (bank == "shader") queue.shader[offset] = value;
+        if (bank == "uconfig") queue.userConfig[offset] = value;
+    }
+#ifdef _WIN32
+    // DecodeState validates color address ranges. Reserve empty scratch at the
+    // captured addresses solely for that range check; no captured image data or
+    // GPU work is consumed by this metadata replay. Never replace an existing map.
+    struct ScratchMaps {
+        std::vector<void*> values;
+        ~ScratchMaps() { for (void* value : values) VirtualFree(value, 0, MEM_RELEASE); }
+    } scratch;
+    const auto word = [&](std::uint32_t offset) {
+        const auto it = queue.context.find(offset);
+        return it == queue.context.end() ? 0u : it->second;
+    };
+    const auto active = word(0x8e) & word(0x8f);
+    std::set<std::uint64_t> bases;
+    for (unsigned slot = 0; slot < 8; ++slot) {
+        if ((active & (0xfu << (slot * 4))) == 0) continue;
+        const auto address = (static_cast<std::uint64_t>(word(0x390 + slot) & 0xffu) << 40u) |
+                             (static_cast<std::uint64_t>(word(0x318 + slot * 15)) << 8u);
+        const auto base = address & ~0xffffull;
+        Require(base >= 0x10000 && base < 0x1000000000000ull, "invalid captured color address");
+        if (!bases.insert(base).second) continue;
+        auto* requested = reinterpret_cast<void*>(static_cast<std::uintptr_t>(base));
+        void* allocated = VirtualAlloc(requested, 32u * 1024 * 1024, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        Require(allocated == requested, "cannot reserve isolated captured color range");
+        scratch.values.push_back(allocated);
+    }
+#else
+    throw std::runtime_error("register replay with scratch address reservations requires a Windows host");
+#endif
+    const auto state = DecodeState(queue);
+    std::ifstream module(fragmentPath, std::ios::binary | std::ios::ate);
+    Require(static_cast<bool>(module), "missing captured fragment SPIR-V");
+    const auto bytes = static_cast<std::streamoff>(module.tellg());
+    Require(bytes >= 20 && bytes <= 2 * 1024 * 1024 && bytes % 4 == 0, "invalid fragment byte size");
+    module.seekg(0);
+    std::vector<std::uint32_t> words(static_cast<std::size_t>(bytes) / 4);
+    module.read(reinterpret_cast<char*>(words.data()), bytes);
+    Require(static_cast<bool>(module), "incomplete fragment read");
+    ShaderRecompiler::RecompileResult fragment;
+    fragment.spirv = std::move(words);
+    const std::array<CompiledShader, 1> shaders{{{ShaderRecompiler::ShaderStage::Fragment, &fragment, 0}}};
+    Context restricted{};
+    restricted.depthClipControl = true;
+    restricted.limits.maxViewportDimensions[0] = restricted.limits.maxViewportDimensions[1] = 16384;
+    restricted.limits.viewportBoundsRange[0] = -32768;
+    restricted.limits.viewportBoundsRange[1] = 32767;
+    expectFailure([&] { ValidateViewport(restricted, state.viewport); }, "viewport depth outside [0, 1]");
+    const auto resolved = ResolveUnobservedViewportDepth(restricted, state, shaders);
+    ValidateViewport(restricted, resolved);
+    Require(!state.depthTest && !state.depthWrite && state.stencilTest && state.negativeOneToOne,
+            "capture is not the intended stencil-only negative clip convention");
+    std::cout << "Captured stencil viewport before=" << state.viewport.minDepth << "," << state.viewport.maxDepth
+              << " after=" << resolved.minDepth << "," << resolved.maxDepth
+              << " depthTest=" << state.depthTest << " depthWrite=" << state.depthWrite
+              << " stencil=" << state.stencilTest << " negativeOneToOne=" << state.negativeOneToOne << "\n";
+}
+
+void UnobservedViewportDepthTests() {
+    using namespace AgcDriver::Graphics;
+    using ShaderRecompiler::ShaderStage;
+    Context restricted{};
+    restricted.depthClipControl = true;
+    State stencil{};
+    stencil.viewport = {13, 17, 128, -64, -1, 1};
+    stencil.negativeOneToOne = true;
+    stencil.stencilTest = true;
+    // A valid, original no-depth/no-coordinate fragment module with an empty
+    // main function. The test checks eligibility without requiring a GPU.
+    ShaderRecompiler::RecompileResult fragment;
+    fragment.spirv = std::vector<std::uint32_t>{
+        0x07230203, 0x00010000, 0, 5, 0,
+        (2u << 16) | spv::OpCapability, spv::CapabilityShader,
+        (3u << 16) | spv::OpMemoryModel, spv::AddressingModelLogical, spv::MemoryModelGLSL450,
+        (5u << 16) | spv::OpEntryPoint, spv::ExecutionModelFragment, 3, 0x6e69616d, 0,
+        (3u << 16) | spv::OpExecutionMode, 3, spv::ExecutionModeOriginUpperLeft,
+        (2u << 16) | spv::OpTypeVoid, 1,
+        (3u << 16) | spv::OpTypeFunction, 2, 1,
+        (5u << 16) | spv::OpFunction, 1, 3, spv::FunctionControlMaskNone, 2,
+        (2u << 16) | spv::OpLabel, 4,
+        (1u << 16) | spv::OpReturn,
+        (1u << 16) | spv::OpFunctionEnd,
+    };
+    const std::array<CompiledShader, 1> shaders{{{ShaderStage::Fragment, &fragment, 0}}};
+    const auto same = [](const VkViewport& a, const VkViewport& b) {
+        return a.x == b.x && a.y == b.y && a.width == b.width && a.height == b.height && a.minDepth == b.minDepth && a.maxDepth == b.maxDepth;
+    };
+    const auto adapted = ResolveUnobservedViewportDepth(restricted, stencil, shaders);
+    Require(adapted.x == 13 && adapted.y == 17 && adapted.width == 128 && adapted.height == -64 && adapted.minDepth == 0 && adapted.maxDepth == 1,
+            "unobserved depth was not adapted without changing XY");
+    Require(stencil.viewport.minDepth == -1 && stencil.negativeOneToOne && stencil.stencilTest,
+            "guest depth or stencil/clip state was changed");
+    for (const auto flag : {&State::depthTest, &State::depthWrite, &State::depthBoundsTest, &State::depthBias, &State::depthClamp}) {
+        auto observed = stencil;
+        observed.*flag = true;
+        Require(same(ResolveUnobservedViewportDepth(restricted, observed, shaders), observed.viewport), "an observable depth operation was adapted");
+    }
+    auto native = restricted;
+    native.depthRangeUnrestricted = true;
+    Require(same(ResolveUnobservedViewportDepth(native, stencil, shaders), stencil.viewport), "native unrestricted range changed");
+    auto legal = stencil;
+    legal.viewport.minDepth = 0.8f;
+    legal.viewport.maxDepth = 0.2f;
+    Require(same(ResolveUnobservedViewportDepth(restricted, legal, shaders), legal.viewport), "legal reversed depth changed");
+    Require(same(ResolveUnobservedViewportDepth(restricted, stencil, {}), stencil.viewport), "missing fragment proof accepted");
+    const auto original = fragment.spirv;
+    for (const auto builtin : {spv::BuiltInFragCoord, spv::BuiltInFragDepth}) {
+        fragment.spirv = original;
+        fragment.spirv.insert(fragment.spirv.end(), {(4u << 16) | spv::OpDecorate, 7, spv::DecorationBuiltIn, static_cast<std::uint32_t>(builtin)});
+        Require(same(ResolveUnobservedViewportDepth(restricted, stencil, shaders), stencil.viewport), "a fragment depth/coordinate observer was adapted");
+        fragment.spirv = original;
+        fragment.spirv.insert(fragment.spirv.end(), {(5u << 16) | spv::OpMemberDecorate, 7, 0, spv::DecorationBuiltIn, static_cast<std::uint32_t>(builtin)});
+        Require(same(ResolveUnobservedViewportDepth(restricted, stencil, shaders), stencil.viewport), "an interface-block depth observer was adapted");
+    }
+    fragment.spirv = original;
+    fragment.spirv.insert(fragment.spirv.end(), {(3u << 16) | spv::OpExecutionMode, 3, spv::ExecutionModeDepthReplacing});
+    Require(same(ResolveUnobservedViewportDepth(restricted, stencil, shaders), stencil.viewport), "depth replacement accepted");
+    fragment.spirv = original;
+    fragment.spirv.insert(fragment.spirv.end(), {0});
+    Require(same(ResolveUnobservedViewportDepth(restricted, stencil, shaders), stencil.viewport), "malformed fragment module accepted");
+    fragment.spirv = std::vector<std::uint32_t>{0x07230203, 0x00010000, 0, 1, 0};
+    Require(same(ResolveUnobservedViewportDepth(restricted, stencil, shaders), stencil.viewport), "missing fragment entry point accepted");
+    fragment.spirv = original;
+    std::cout << "Unobserved viewport depth eligibility tests passed\n";
+}
