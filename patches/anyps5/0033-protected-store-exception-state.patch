+LONG WINAPI ReportCrashWithState(EXCEPTION_POINTERS* pointers) {
+    aps5_veh_state_info saved{};
+    const auto* fault = pointers->ExceptionRecord;
+    if (g_queryExceptionState && fault->ExceptionCode == EXCEPTION_ACCESS_VIOLATION && fault->NumberParameters >= 2) {
+        saved.version = 1;
+        saved.code = fault->ExceptionCode;
+        saved.direction = fault->ExceptionInformation[0];
+        saved.rip = pointers->ContextRecord->Rip;
+        saved.rsp = pointers->ContextRecord->Rsp;
+        saved.address = fault->ExceptionInformation[1];
+        ULONG bytes = 0;
+        const auto status = g_queryExceptionState(GetCurrentThread(), APS5_THREAD_VEH_STATE, &saved, sizeof(saved), &bytes);
+        if (!status && bytes == sizeof(saved)) pointers->ContextRecord->EFlags = saved.flags;
+        else saved.token = 0;
+    }
+    const auto result = ReportCrash(pointers);
+    if (result == EXCEPTION_CONTINUE_EXECUTION && g_requireExceptionState && !saved.token &&
+        fault->ExceptionCode == EXCEPTION_ACCESS_VIOLATION &&
+        !(g_isExceptionEcCode && (g_isExceptionEcCode(pointers->ContextRecord->Rip) ||
+                                  g_isExceptionEcCode(reinterpret_cast<ULONG_PTR>(fault->ExceptionAddress))))) {
+        Report("[veh-state] handled access violation has no matching native snapshot; refusing corrupted continuation\n");
+        TerminateProcess(GetCurrentProcess(), 0xc000000d);
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    if (result == EXCEPTION_CONTINUE_EXECUTION && saved.token) {
+        saved.operation = 1;
+        saved.resume_rip = pointers->ContextRecord->Rip;
+        saved.resume_rsp = pointers->ContextRecord->Rsp;
+        saved.flags = pointers->ContextRecord->EFlags;
+        ULONG bytes = 0;
+        const auto status = g_queryExceptionState(GetCurrentThread(), APS5_THREAD_VEH_STATE, &saved, sizeof(saved), &bytes);
+        if (status || bytes != sizeof(saved)) {
+            Report("[veh-state] failed to prepare restoration status=%lx; refusing corrupted continuation\n", static_cast<unsigned long>(status));
+            TerminateProcess(GetCurrentProcess(), 0xc000000d);
+            return EXCEPTION_CONTINUE_SEARCH;
+        }
+    }
+    return result;
+}
