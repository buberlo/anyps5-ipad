+static void CheckNativeCrtSharedWriteTracking() {
+#ifdef _WIN32
+    // Exercise a native ARM64EC CRT writer through the actual libc VEH, rather
+    // than an independent probe's handler. Both aliases must report the writes.
+    constexpr std::size_t page = 0x4000, length = page * 4;
+    using Copy = void* (__cdecl *)(void*, const void*, std::size_t);
+    using Fill = void* (__cdecl *)(void*, int, std::size_t);
+    const auto crt = GetModuleHandleW(L"ucrtbase.dll");
+    Require(crt != nullptr);
+    const auto copy = reinterpret_cast<Copy>(GetProcAddress(crt, "memcpy"));
+    const auto fill = reinterpret_cast<Fill>(GetProcAddress(crt, "memset"));
+    Require(copy != nullptr && fill != nullptr);
+    std::array<unsigned char, page * 2> source{};
+    for (std::size_t i = 0; i < source.size(); ++i) source[i] = static_cast<unsigned char>(i * 37 + 11);
+    std::int64_t phys = 0;
+    Require(sceKernelAllocateDirectMemory(0, 0x7fffffffffll, length, 0, 0, &phys) == 0);
+    std::array<void*, 2> aliases{};
+    for (auto& alias : aliases) Require(sceKernelMapDirectMemory(&alias, length, 3, 0, phys, 0) == 0);
+    const auto collect = [&](void* alias, bool clear = true) {
+        std::array<void*, 32> pages{};
+        std::size_t count = pages.size();
+        Require(GuestArena::GuestArenaCollectWrites_nid_postfix(reinterpret_cast<std::uintptr_t>(alias), length, pages.data(), &count, clear));
+        return count;
+    };
+    for (auto alias : aliases) { Require(collect(alias) == 16); Require(collect(alias) == 0); }
+    constexpr std::size_t offset = page - 7;
+    constexpr std::array<std::size_t, 9> sizes{1, 7, 16, 31, 128, 512, 4096, page, page * 2};
+    unsigned checks = 0;
+    for (auto alias : aliases) for (bool useFill : {false, true}) for (auto bytes : sizes) {
+        auto* destination = static_cast<unsigned char*>(alias) + offset;
+        auto* result = useFill ? fill(destination, 0xa5, bytes) : copy(destination, source.data(), bytes);
+        Require(result == destination);
+        for (auto view : aliases) {
+            const auto* data = static_cast<const unsigned char*>(view) + offset;
+            for (std::size_t i = 0; i < bytes; ++i) Require(data[i] == (useFill ? 0xa5 : source[i]));
+        }
+        const auto expected = ((offset + bytes - 1) / page + 1) * 4;
+        for (auto view : aliases) Require(collect(view, false) == expected);
+        for (auto view : aliases) { Require(collect(view) == expected); Require(collect(view) == 0); }
+        ++checks;
+    }
+    for (auto alias : aliases) Require(sceKernelMunmap(alias, length) == 0);
+    Require(sceKernelReleaseDirectMemory(phys, length) == 0);
+    std::fprintf(stderr, "Native CRT shared write tracking: %u checks passed.\n", checks);
 #endif
 }
 
