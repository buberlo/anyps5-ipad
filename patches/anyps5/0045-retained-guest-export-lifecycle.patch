+    bool RequiresGuestLifecycle() const {
+        if (ReplacementModule.empty()) return true;
+        // A companion HLE library owns its own state, not the state used by
+        // retained guest exports. Functions and data can depend on the guest's
+        // initialization and finalization, regardless of their symbol type.
+        // Absolute exports are constants and do not expose guest-owned state.
+        return std::any_of(Symbols.begin(), Symbols.end(), [](const GuestSymbol& symbol) {
+            return symbol.Section != 0 && symbol.Section != AbsoluteSection &&
+                (symbol.Info >> 4) != 0 && symbol.Visibility != 1 && symbol.Visibility != 2;
+        });
+    }
