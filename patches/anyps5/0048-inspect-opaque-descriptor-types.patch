+    void UniformDescriptor(std::uint32_t typeId, const ShaderRecompiler::DescriptorBinding& binding) const {
+        using Kind = ShaderRecompiler::DescriptorKind;
+        using Shape = ShaderRecompiler::DescriptorImageShape;
+        Require(binding.count != 0, "uniform descriptor binding count must be nonzero");
+        const auto& outer = Type(typeId);
+        if ((outer[0] & 0xffffu) == spv::OpTypeArray) {
+            Require(outer.size() == 4, "malformed uniform descriptor array");
+            const auto count = constants.find(outer[3]);
+            Require(count != constants.end() && count->second == binding.count,
+                    "uniform descriptor array length disagrees with recompiler binding count");
+            typeId = outer[2];
+        } else {
+            Require(binding.count == 1, "non-array uniform descriptor must have a binding count of one");
+        }
+        const auto& type = Type(typeId);
+        const auto op = static_cast<spv::Op>(type[0] & 0xffffu);
+        // The runtime binds images and samplers separately. OpTypeSampledImage
+        // is valid for intermediate OpSampledImage results, not a descriptor
+        // requiring VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER.
+        Require(op != spv::OpTypeSampledImage, "combined sampled image descriptors are unsupported");
+        if (binding.kind == Kind::Sampler) {
+            Require(op == spv::OpTypeSampler && type.size() == 2,
+                    "SPIR-V descriptor type disagrees with recompiler binding metadata");
+            Require(binding.role == ShaderRecompiler::DescriptorRole::GuestSamplers && !binding.imageShape,
+                    "sampler descriptor role or image shape disagrees with recompiler metadata");
+            return;
+        }
+        Require((binding.kind == Kind::SampledImage || binding.kind == Kind::StorageImage) &&
+                op == spv::OpTypeImage && (type.size() == 9 || type.size() == 10),
+                "SPIR-V descriptor type disagrees with recompiler binding metadata");
+        Require(binding.role == ShaderRecompiler::DescriptorRole::GuestImages,
+                "image descriptor role disagrees with recompiler metadata");
+        Require(type[4] <= 2 && type[5] <= 1 && type[6] <= 1 &&
+                type[7] == (binding.kind == Kind::SampledImage ? 1u : 2u),
+                "SPIR-V descriptor type disagrees with sampled/storage image metadata");
+        const auto& scalar = Type(type[2]);
+        Require(((scalar[0] & 0xffffu) == spv::OpTypeFloat && scalar.size() == 3) ||
+                ((scalar[0] & 0xffffu) == spv::OpTypeInt && scalar.size() == 4),
+                "image sampled type is not a scalar numerical type");
+        Require(binding.imageShape.has_value(), "image shape is absent from recompiler binding metadata");
+        std::uint32_t dim = spv::Dim2D, arrayed = 0, multisampled = 0;
+        switch (*binding.imageShape) {
+            case Shape::Image1D: dim = spv::Dim1D; break;
+            case Shape::Image2D: break;
+            case Shape::Image2DArray: arrayed = 1; break;
+            case Shape::ImageCube: dim = spv::DimCube; break;
+            case Shape::Image3D: dim = spv::Dim3D; break;
+            case Shape::Image1DArray: dim = spv::Dim1D; arrayed = 1; break;
+            case Shape::Image2DMsaa: multisampled = 1; break;
+            case Shape::Image2DMsaaArray: multisampled = arrayed = 1; break;
+            default: throw std::runtime_error("AGC graphics: unsupported descriptor image shape");
+        }
+        Require(type[3] == dim && type[5] == arrayed && type[6] == multisampled,
+                "SPIR-V image shape disagrees with recompiler binding metadata");
     }
 
