+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/InitialDescriptorWrites.hpp
@@ -0,0 +1,97 @@
+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_INITIALDESCRIPTORWRITES_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_INITIALDESCRIPTORWRITES_HPP
+
+#include <vulkan/vulkan.h>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <span>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace AgcDriver::Graphics {
+
+// Diagnostic experiment only. The default path neither saves descriptor infos
+// nor changes how a draw's read-only buffer snapshots are bound.
+inline bool ExplicitDrawDescriptorsEnabled() noexcept {
+    static const bool enabled = [] {
+        const char* value = std::getenv("APS5_EXPLICIT_DRAW_DESCRIPTORS");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+class InitialDescriptorWrites {
+public:
+    explicit InitialDescriptorWrites(std::span<const VkWriteDescriptorSet> writes) {
+        entries.reserve(writes.size());
+        for (const auto& write : writes) {
+            if (write.sType != VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET || write.pNext != nullptr ||
+                write.descriptorCount == 0 || write.pTexelBufferView != nullptr)
+                throw std::runtime_error("unsupported initial draw descriptor write");
+            Entry entry{write.dstBinding, write.dstArrayElement, write.descriptorCount, write.descriptorType};
+            switch (write.descriptorType) {
+                case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+                    if (write.pBufferInfo == nullptr || write.pImageInfo != nullptr)
+                        throw std::runtime_error("initial draw buffer descriptor has invalid infos");
+                    entry.buffers.assign(write.pBufferInfo, write.pBufferInfo + write.descriptorCount);
+                    break;
+                case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:
+                case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE:
+                case VK_DESCRIPTOR_TYPE_SAMPLER:
+                    if (write.pImageInfo == nullptr || write.pBufferInfo != nullptr)
+                        throw std::runtime_error("initial draw image descriptor has invalid infos");
+                    entry.images.assign(write.pImageInfo, write.pImageInfo + write.descriptorCount);
+                    break;
+                default:
+                    throw std::runtime_error("initial draw descriptor type is unsupported");
+            }
+            entries.push_back(std::move(entry));
+        }
+    }
+
+    // Returned pointers refer to this immutable owner, not the returned vector.
+    // Keep the owner alive until vkUpdateDescriptorSets has consumed every write.
+    std::vector<VkWriteDescriptorSet> ForSet(VkDescriptorSet set) const {
+        if (set == VK_NULL_HANDLE) throw std::runtime_error("initial draw descriptors need a destination set");
+        std::vector<VkWriteDescriptorSet> writes;
+        writes.reserve(entries.size());
+        for (const auto& entry : entries) {
+            VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+            write.dstSet = set;
+            write.dstBinding = entry.binding;
+            write.dstArrayElement = entry.arrayElement;
+            write.descriptorCount = entry.count;
+            write.descriptorType = entry.type;
+            write.pBufferInfo = entry.buffers.empty() ? nullptr : entry.buffers.data();
+            write.pImageInfo = entry.images.empty() ? nullptr : entry.images.data();
+            writes.push_back(write);
+        }
+        return writes;
+    }
+
+    std::size_t Size() const noexcept { return entries.size(); }
+
+private:
+    struct Entry {
+        std::uint32_t binding;
+        std::uint32_t arrayElement;
+        std::uint32_t count;
+        VkDescriptorType type;
+        std::vector<VkDescriptorBufferInfo> buffers;
+        std::vector<VkDescriptorImageInfo> images;
+    };
+    std::vector<Entry> entries;
+};
+
+inline std::unique_ptr<InitialDescriptorWrites> CaptureInitialDrawDescriptors(
+    std::span<const VkWriteDescriptorSet> writes) {
+    if (!ExplicitDrawDescriptorsEnabled()) return {};
+    return std::make_unique<InitialDescriptorWrites>(writes);
+}
+
+}
