+ColorResolveSnapshot CaptureColorResolveSource(const ColorTarget& source, bool diagnostics) {
+    // This helper has the same strict source qualification as RunColorResolve.
+    auto validation = ColorResolvePass{source, source};
+    validation.destination.samples = validation.destination.fragments = 1u;
+    validation.destination.bytes = ColorTargetLayout(source.extent.width, source.extent.height,
+        source.tileMode, source.elementBytes, 1u).Bytes();
+    ValidateColorResolve(validation);
+    const ColorTargetLayout layout(source.extent.width, source.extent.height,
+                                   source.tileMode, source.elementBytes, source.samples);
+    static const bool raw = [] {
+        const char* value = std::getenv("APS5_RAW_RESOLVE_SNAPSHOT");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    ColorResolveSnapshot result;
+    result.source = source;
+    const auto alignment = std::align_val_t(65536);
+    result.backing = {static_cast<std::byte*>(::operator new(source.bytes, alignment)),
+        [alignment](std::byte* memory) { ::operator delete(memory, alignment); }};
+    result.source.address = result.source.surfaceAddress = reinterpret_cast<std::uintptr_t>(result.backing.get());
+    auto bytes = std::span<std::byte>(result.backing.get(), static_cast<std::size_t>(source.bytes));
+    if (raw) {
+        GuestMemory::CheckRange(bytes.data(), bytes.size(), layout.Alignment(), true);
+        // Read keeps the existing pending-GPU flush and complete mapped-range
+        // validation. Never flush from inside the guest write-tracker lock.
+        GuestMemory::Read(source.address, bytes, layout.Alignment());
+        // Host allocations can recycle an address the tracker has seen. Keep
+        // driver-generation invalidation after the complete successful copy.
+        GuestMemory::MarkWritten(result.source.address, bytes.size());
+        result.rawCopy = true;
+        if (diagnostics) {
+            result.diagnosticPixels.resize(layout.LinearBytes());
+            layout.Detile(bytes, result.diagnosticPixels);
+        }
+        static std::atomic<bool> reported{false};
+        if (!reported.exchange(true, std::memory_order_relaxed))
+            std::fprintf(stderr, "[resolve-snapshot] raw tiled snapshot executed bytes=%llu; pending flush, immutable backing and write stamps retained\n",
+                static_cast<unsigned long long>(source.bytes));
+    } else {
+        std::vector<std::byte> linear(layout.LinearBytes());
+        ReadColorTarget(source, linear);
+        std::memset(bytes.data(), 0, bytes.size());
+        WriteColorTarget(result.source, linear);
+        if (diagnostics) result.diagnosticPixels = std::move(linear);
+    }
+    return result;
+}
