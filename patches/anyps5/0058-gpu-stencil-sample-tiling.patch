@@ -0,0 +1,28 @@
+#version 450
+// Original S8/8 SW_64KB_Z_X word-owned tiling. Only eight stored samples.
+layout(constant_id=0) const uint RETILE=0u;
+layout(local_size_x=8,local_size_y=8,local_size_z=1) in;
+layout(set=0,binding=0,std430) readonly buffer Input { uint words[]; } source;
+layout(set=0,binding=1,std430) writeonly buffer Output { uint words[]; } destination;
+layout(push_constant) uniform Parameters { uint width;uint height;uint blocksPerRow;uint tiledWords;uint linearWords; } parameters;
+uint offset(uvec2 pixel,uint sampleIndex) {
+    const uint equation[16]=uint[16](0x01000000u,0x02000000u,0x04000000u,0x00000001u,0x00001000u,0x00000002u,0x00002000u,0x00000004u,0x00008008u,0x00010010u,0x00020040u,0x00040020u,0x00008000u,0x00000010u,0x00040000u,0x00084000u);
+    uint result=0u;
+    for(uint bit=0u;bit<16u;++bit) {
+        uint mask=equation[bit];
+        uint selected=(pixel.x&mask&0xfffu)^((pixel.y<<12u)&mask&0xfff000u)^((sampleIndex<<24u)&mask&0x07000000u);
+        result|=(uint(bitCount(selected))&1u)<<bit;
+    }
+    uint block=(pixel.y/128u)*parameters.blocksPerRow+pixel.x/64u;
+    return block*65536u+result;
+}
+void main() {
+    uvec2 pixel=gl_GlobalInvocationID.xy;uint group=gl_GlobalInvocationID.z;
+    if(pixel.x>=parameters.width||pixel.y>=parameters.height||group>=2u)return;
+    // Low three address bits are samples0..7: each invocation owns four bytes.
+    uint tiledWord=offset(pixel,group*4u)/4u;
+    uint linearWord=(pixel.y*parameters.width+pixel.x)*2u+group;
+    if(tiledWord>=parameters.tiledWords||linearWord>=parameters.linearWords)return;
+    if(RETILE==0u)destination.words[linearWord]=source.words[tiledWord];
+    else destination.words[tiledWord]=source.words[linearWord];
+}
