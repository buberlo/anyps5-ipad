+struct StencilSampleProgramCache::State {
+    struct Key {
+        std::uint64_t domain;
+        VkDevice device;
+        VkFormat format;
+        std::uint32_t samples,nativeSamples,groups,schema=1;
+        std::array<std::uint32_t,16> orderedPositions{};
+        bool operator==(const Key&) const = default;
+    };
+    struct Entry { Key key; std::shared_ptr<const StencilSamplePrograms> programs; };
+    VkDevice device;
+    VkPhysicalDevice physical;
+    std::uint64_t domain;
+    std::size_t capacity;
+    std::mutex mutex;
+    std::once_flag hitNote;
+    std::list<Entry> entries;
+    State(const Context& context,std::size_t capacity):device(context.device),physical(context.physical),capacity(capacity) {
+        static std::atomic<std::uint64_t> nextDomain{1};domain=nextDomain.fetch_add(1);
+    }
+};
+StencilSampleProgramCache::StencilSampleProgramCache(const Context& context,std::size_t capacity) {
+    Require(context.device != VK_NULL_HANDLE && capacity > 0 && capacity <= 8,"invalid stencil program cache device/capacity");
+    state=std::make_unique<State>(context,capacity);
+}
+StencilSampleProgramCache::~StencilSampleProgramCache() = default;
+void StencilSampleProgramCache::Clear() { std::lock_guard lock(state->mutex);state->entries.clear(); }
+std::shared_ptr<const StencilSamplePrograms> StencilSampleProgramCache::Acquire(const Context& context,VkFormat format,
+    std::uint32_t samples,std::span<const VkSampleLocationEXT> positions) {
+    Require(context.device == state->device && context.physical == state->physical,"stencil program cache belongs to another device domain");
+    State::Key key{state->domain,context.device,format,samples,std::min(samples,4u),samples/std::min(samples,4u)};
+    for(std::uint32_t i=0;i<samples;++i) {key.orderedPositions[i*2]=std::bit_cast<std::uint32_t>(positions[i].x);key.orderedPositions[i*2+1]=std::bit_cast<std::uint32_t>(positions[i].y);}
+    std::lock_guard lock(state->mutex);
+    for(auto it=state->entries.begin();it!=state->entries.end();++it)if(it->key==key) {
+        std::call_once(state->hitNote, [] { std::fprintf(stderr,"[stencil-program-cache] immutable bundle reused; ordered sample positions matched\n"); });
+        const auto programs=it->programs;state->entries.splice(state->entries.begin(),state->entries,it);return programs;
+    }
+    auto programs=std::make_shared<StencilSamplePrograms>(context,format,samples,positions);
+    state->entries.push_front({key,programs});
+    if(state->entries.size()>state->capacity)state->entries.pop_back();
+    return programs;
+}
