+            extent.height <= context.limits.maxFramebufferHeight && extent.width <= context.limits.maxViewportDimensions[0] &&
+            extent.height <= context.limits.maxViewportDimensions[1], "stencil sample transfer extent is unsupported");
+    logicalBytes = std::uint64_t(extent.width) * extent.height * samples;
+    Require(logicalBytes <= std::numeric_limits<std::uint32_t>::max() - 3u, "stencil sample transfer indexing overflows");
+    packedBytes = (logicalBytes + 3u) & ~VkDeviceSize(3u);
