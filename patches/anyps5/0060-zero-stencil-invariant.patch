+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/StencilZeroInvariant.cpp
@@ -0,0 +1,179 @@
+#include "prx/libSceAgcDriver/Graphics/include/StencilZeroInvariant.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Shaders.hpp"
+#include <spirv/unified1/spirv.hpp>
+#include <algorithm>
+#include <bit>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <cstdio>
+#include <mutex>
+
+namespace AgcDriver::Graphics {
+bool ZeroStencilInvariantEnabled() {
+    static const bool enabled = [] { const auto* value = std::getenv("APS5_ZERO_STENCIL_INVARIANT");
+        return value != nullptr && std::strcmp(value, "1") == 0; }();
+    return enabled;
+}
+bool AllStencilBytesZero(std::span<const std::byte> bytes) noexcept {
+    std::size_t at = 0;
+    for (; bytes.size() - at >= sizeof(std::uint64_t); at += sizeof(std::uint64_t)) {
+        std::uint64_t word;
+        std::memcpy(&word, bytes.data() + at, sizeof(word)); // unaligned and alias-safe literal copy
+        if (word != 0) return false;
+    }
+    for (; at < bytes.size(); ++at) if (bytes[at] != std::byte{0}) return false;
+    return true;
+}
+namespace {
+bool zeroFace(const VkStencilOpState& face) {
+    const auto operation = [](VkStencilOp op) {
+        return op == VK_STENCIL_OP_KEEP || op == VK_STENCIL_OP_ZERO || op == VK_STENCIL_OP_REPLACE;
+    };
+    return face.compareOp == VK_COMPARE_OP_ALWAYS && face.compareMask == 255u && face.writeMask == 255u && face.reference == 0u &&
+           operation(face.failOp) && operation(face.passOp) && operation(face.depthFailOp);
+}
+bool noDepthOrStencilExport(std::span<const CompiledShader> shaders) {
+    unsigned fragments = 0;
+    for (const auto& shader : shaders) {
+        if (shader.program == nullptr) return false;
+        if (shader.stage != ShaderRecompiler::ShaderStage::Fragment) continue;
+        if (++fragments != 1u) return false;
+        const auto& words = shader.program->spirv.Words();
+        if (words.size() < 5u || words[0] != 0x07230203u) return false;
+        unsigned entries = 0;
+        for (std::size_t at = 5u; at < words.size();) {
+            const auto count = words[at] >> 16u;
+            const auto op = static_cast<spv::Op>(words[at] & 0xffffu);
+            if (count == 0u || count > words.size() - at) return false;
+            if (op == spv::OpEntryPoint && (++entries != 1u || count < 4u || words[at + 1u] != spv::ExecutionModelFragment)) return false;
+            const auto exported = [](std::uint32_t builtin) {
+                return builtin == spv::BuiltInFragDepth || builtin == spv::BuiltInFragStencilRefEXT;
+            };
+            if (op == spv::OpDecorate) {
+                if (count < 3u) return false;
+                if (words[at + 2u] == spv::DecorationBuiltIn && (count != 4u || exported(words[at + 3u]))) return false;
+            }
+            if (op == spv::OpMemberDecorate) {
+                if (count < 4u) return false;
+                if (words[at + 3u] == spv::DecorationBuiltIn && (count != 5u || exported(words[at + 4u]))) return false;
+            }
+            if (op == spv::OpDecorateId || op == spv::OpExecutionModeId) return false;
+            if (op == spv::OpExecutionMode) {
+                if (count < 3u) return false;
+                if (words[at + 2u] == spv::ExecutionModeDepthReplacing ||
+                    words[at + 2u] == spv::ExecutionModeStencilRefReplacingEXT) return false;
+            }
+            at += count;
+        }
+        if (entries != 1u) return false;
+    }
+    return fragments == 1u;
+}
+}
+bool PreservesZeroStencil(const State& state, std::span<const CompiledShader> shaders,
+                          std::span<const std::byte> original, std::size_t expectedBytes) {
+    if (!state.depth || !state.stencilTest || state.depthTest || state.depthWrite || state.depthBoundsTest ||
+        state.depthBias || state.depthClamp || state.depth->clearStencil != 0u || state.depth->stencilAddress == 0u ||
+        state.samples.count != 8u || state.samples.nativeCount != 4u || state.samples.groups != 2u ||
+        state.samples.mask != 255u || state.depth->samples != 8u ||
+        state.depth->format != VK_FORMAT_D32_SFLOAT_S8_UINT ||
+        expectedBytes == 0u || original.size() != expectedBytes ||
+        !zeroFace(state.stencilFront) || !zeroFace(state.stencilBack) || !noDepthOrStencilExport(shaders)) return false;
+    return AllStencilBytesZero(original);
+}
+StencilZeroTransfer::StencilZeroTransfer(const Context& context, VkImage image, VkFormat format,
+    std::span<const VkImageView> groupAttachments, VkExtent2D extent, std::uint32_t logicalSamples,
+    std::span<const VkSampleLocationEXT> guestPositions)
+    : context(context), image(image), samples(logicalSamples), nativeSamples(std::min(logicalSamples, 4u)), groups(0) {
+    Require(samples == 8u, "zero stencil transfer requires eight logical samples");
+    VkDeviceSize logicalBytes = 0, packedBytes = 0;
+    Require(format == VK_FORMAT_D32_SFLOAT_S8_UINT,
+            "zero stencil transfer requires the qualified D32S8 image format");
+    Require(image != VK_NULL_HANDLE && std::has_single_bit(samples) && samples >= 2 && samples <= 8,
+            "stencil sample transfer requires a valid 2/4/8 sample image");
+    groups = samples / nativeSamples;
+    Require(groupAttachments.size() == groups && std::all_of(groupAttachments.begin(), groupAttachments.end(),
+            [](auto view) { return view != VK_NULL_HANDLE; }), "stencil sample transfer attachment groups are unavailable");
+    Require(groups == 1u || context.multisampleArrayImage, "stencil sample transfer array feature is unavailable");
+    const auto& properties = context.sampleLocationProperties;
+    Require(context.sampleLocations && guestPositions.size() == samples &&
+            (properties.sampleLocationSampleCounts & nativeSamples) != 0 &&
+            properties.maxSampleLocationGridSize.width >= 1u && properties.maxSampleLocationGridSize.height >= 1u &&
+            properties.sampleLocationSubPixelBits >= 4u, "stencil sample transfer guest sample locations are unsupported");
+    for (std::uint32_t i = 0; i < samples; ++i) {
+        const auto position = guestPositions[i];
+        Require(std::isfinite(position.x) && std::isfinite(position.y) &&
+                position.x >= properties.sampleLocationCoordinateRange[0] && position.x <= properties.sampleLocationCoordinateRange[1] &&
+                position.y >= properties.sampleLocationCoordinateRange[0] && position.y <= properties.sampleLocationCoordinateRange[1],
+                "stencil sample position outside device coordinate range");
+        positions[i] = position;
+    }
+    Require(extent.width && extent.height && extent.width <= context.limits.maxFramebufferWidth &&
+            extent.height <= context.limits.maxFramebufferHeight && extent.width <= context.limits.maxViewportDimensions[0] &&
+            extent.height <= context.limits.maxViewportDimensions[1], "stencil sample transfer extent is unsupported");
+    logicalBytes = std::uint64_t(extent.width) * extent.height * samples;
+    Require(logicalBytes <= std::numeric_limits<std::uint32_t>::max() - 3u, "stencil sample transfer indexing overflows");
+    packedBytes = (logicalBytes + 3u) & ~VkDeviceSize(3u);
+    Require(packedBytes <= context.limits.maxStorageBufferRange, "stencil sample transfer exceeds storage buffer range");
+    Require(context.limits.maxPushConstantsSize >= 20 && context.limits.maxPerStageDescriptorStorageBuffers >= 1 &&
+            context.limits.maxPerStageDescriptorSampledImages >= 1 && context.limits.maxDescriptorSetStorageBuffers >= 1 &&
+            context.limits.maxDescriptorSetSampledImages >= 1, "stencil sample transfer descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 64 && context.limits.maxComputeWorkGroupInvocations >= 64 &&
+            (packedBytes / 4u + 63u) / 64u <= context.limits.maxComputeWorkGroupCount[0], "stencil sample transfer compute limits are unsupported");
+    Require(context.formatProperties && context.imageFormatProperties, "stencil sample transfer format queries are unavailable");
+    VkFormatProperties formatSupport{};
+    context.formatProperties(context.physical, format, &formatSupport);
+    constexpr VkFormatFeatureFlags features = VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    Require((formatSupport.optimalTilingFeatures & features) == features, "stencil sample transfer image format features are unavailable");
+    VkImageFormatProperties imageSupport{};
+    Check(context.imageFormatProperties(context.physical, format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL,
+        VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        VK_IMAGE_CREATE_SAMPLE_LOCATIONS_COMPATIBLE_DEPTH_BIT_EXT, &imageSupport), "stencil sample transfer image format query");
+    Require((imageSupport.sampleCounts & nativeSamples) != 0 && imageSupport.maxArrayLayers >= groups &&
+            imageSupport.maxExtent.width >= extent.width && imageSupport.maxExtent.height >= extent.height,
+            "stencil sample transfer image format limits are unsupported");
+}
+void StencilZeroTransfer::barrier(PFN_vkCmdPipelineBarrier operation, VkCommandBuffer commands,
+    VkPipelineStageFlags sourceStage, VkAccessFlags sourceAccess,
+    VkPipelineStageFlags destinationStage, VkAccessFlags destinationAccess) const {
+    for (std::uint32_t group = 0; group < groups; ++group) {
+        const VkSampleLocationsInfoEXT pattern{VK_STRUCTURE_TYPE_SAMPLE_LOCATIONS_INFO_EXT, nullptr,
+            static_cast<VkSampleCountFlagBits>(nativeSamples), {1, 1}, nativeSamples, positions.data() + group * nativeSamples};
+        VkImageMemoryBarrier value{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        value.pNext = &pattern;
+        value.srcAccessMask = sourceAccess; value.dstAccessMask = destinationAccess;
+        value.oldLayout = value.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+        value.srcQueueFamilyIndex = value.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        value.image = image;
+        value.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, group, 1};
+        operation(commands, sourceStage, destinationStage, 0, 0, nullptr, 0, nullptr, 1, &value);
+    }
+}
+void StencilZeroTransfer::RecordClear(VkCommandBuffer commands) const {
+    Require(commands != VK_NULL_HANDLE, "zero stencil transfer command buffer is unavailable");
+    // Both lookups may fail: resolve them before recording the first command.
+    const auto transition = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto clear = context.Function<PFN_vkCmdClearDepthStencilImage>("vkCmdClearDepthStencilImage");
+    constexpr auto tests = VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT;
+    constexpr auto attachment = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    barrier(transition, commands, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+        VK_ACCESS_TRANSFER_WRITE_BIT | attachment | VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+    const VkClearDepthStencilValue value{0.0f, 0u};
+    const VkImageSubresourceRange range{VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, groups};
+    clear(commands, image, VK_IMAGE_LAYOUT_GENERAL, &value, 1, &range);
+    barrier(transition, commands, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, tests, attachment);
+    static std::once_flag note;
+    std::call_once(note, [] { std::fprintf(stderr, "[zero-stencil] zero snapshot and invariant state used stencil-only clear; actual draw retained\n"); });
+}
+void StencilZeroTransfer::RecordFinish(VkCommandBuffer commands) const {
+    Require(commands != VK_NULL_HANDLE, "zero stencil transfer command buffer is unavailable");
+    const auto transition = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    // The removed readback no longer publishes an attachment->compute dependency.
+    // Keep the borrowed image's GENERAL endpoint visible to its later operations.
+    constexpr auto attachment = VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT;
+    barrier(transition, commands, VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+        attachment, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, attachment | VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+}
+}
