diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/ColorSampleSnapshotCopy.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/ColorSampleSnapshotCopy.hpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/include/ColorSampleSnapshotCopy.hpp
@@ -0,0 +1,30 @@
+#ifndef ANYPS5_COLOR_SAMPLE_SNAPSHOT_COPY_HPP
+#define ANYPS5_COLOR_SAMPLE_SNAPSHOT_COPY_HPP
+#include "prx/libSceAgcDriver/Graphics/include/GpuColorSampleTiler.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Resources.hpp"
+
+namespace AgcDriver::Graphics {
+bool ColorSampleStagingCopyEnabled();
+
+// One synchronous draw owns both coherent buffers. The baseline is never a
+// GPU destination, and remains immutable through fence/fault checks and the
+// final changed-byte commit. A full GPU copy seeds every result padding byte.
+class ColorSampleSnapshotCopy {
+public:
+    using Reader = void (*)(std::uint64_t, std::span<std::byte>, std::size_t);
+    ColorSampleSnapshotCopy(const Context& context, const ColorTarget& color, Reader read);
+    ColorSampleSnapshotCopy(const ColorSampleSnapshotCopy&) = delete;
+    ColorSampleSnapshotCopy& operator=(const ColorSampleSnapshotCopy&) = delete;
+    std::span<const std::byte> Original() const;
+    std::span<const std::byte> Result() const;
+    void RecordSeed(VkCommandBuffer commands);
+    ColorSampleTilingBufferAccess DetileSource() const;
+    ColorSampleTilingBufferAccess RetileDestination() const;
+private:
+    Context context;
+    std::unique_ptr<Buffer> baseline;
+    std::unique_ptr<Buffer> result;
+    bool seeded = false;
+};
+}
+#endif
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp
@@ -0,0 +1,68 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorSampleSnapshotCopy.hpp"
+#include <cstdlib>
+#include <cstring>
+
+namespace AgcDriver::Graphics {
+bool ColorSampleStagingCopyEnabled() {
+    static const bool enabled = [] {
+        const auto* value = std::getenv("APS5_GPU_COLOR_SAMPLE_STAGING_COPY");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+ColorSampleSnapshotCopy::ColorSampleSnapshotCopy(const Context& context,
+        const ColorTarget& color, Reader read) : context(context) {
+    Require(read != nullptr && GpuColorSampleTiler::Supports(context, color),
+        "sample staging copy requires its qualified color layout and reader");
+    const ColorTargetLayout layout(color.extent.width, color.extent.height,
+        color.tileMode, color.elementBytes, color.samples);
+    baseline = std::make_unique<Buffer>(context, layout.Bytes(),
+        VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    // Draw passes GuestMemory::Read: its pending-GPU flush and full mapped
+    // range validation precede this copy. No guest write or writable mapping.
+    read(color.address, baseline->Bytes(), layout.Alignment());
+    result = std::make_unique<Buffer>(context, layout.Bytes(),
+        VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+}
+std::span<const std::byte> ColorSampleSnapshotCopy::Original() const { return baseline->Bytes(); }
+std::span<const std::byte> ColorSampleSnapshotCopy::Result() const { return result->Bytes(); }
+
+void ColorSampleSnapshotCopy::RecordSeed(VkCommandBuffer commands) {
+    Require(commands != VK_NULL_HANDLE && !seeded && baseline->Handle() && result->Handle() &&
+        baseline->Handle() != result->Handle() && baseline->Bytes().size() == result->Bytes().size() &&
+        baseline->Bytes().size() % 4u == 0, "sample staging copy command/buffers are invalid");
+    // Resolve before recording: a missing entry point cannot leave half a copy.
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto copy = context.Resolved(&DeviceFunctions::cmdCopyBuffer, "vkCmdCopyBuffer");
+    std::array<VkBufferMemoryBarrier, 2> before{};
+    for (auto& item : before) {
+        item.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+        item.srcQueueFamilyIndex = item.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        item.offset = 0; item.size = baseline->Bytes().size();
+    }
+    before[0].buffer = baseline->Handle(); before[0].srcAccessMask = VK_ACCESS_HOST_WRITE_BIT;
+    before[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT;
+    // The distinct pooled result has no live prior commands: its previous owner
+    // completed its fence before return to BufferPool. No stale contents read.
+    before[1].buffer = result->Handle(); before[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier(commands, VK_PIPELINE_STAGE_HOST_BIT | VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        0, 0, nullptr, 2, before.data(), 0, nullptr);
+    const VkBufferCopy region{0, 0, baseline->Bytes().size()};
+    copy(commands, baseline->Handle(), result->Handle(), 1, &region);
+    seeded = true;
+}
+ColorSampleTilingBufferAccess ColorSampleSnapshotCopy::DetileSource() const {
+    Require(seeded, "sample staging copy must seed its result before detiling");
+    return {context.device, baseline->Handle(), 0, baseline->Bytes().size(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT};
+}
+ColorSampleTilingBufferAccess ColorSampleSnapshotCopy::RetileDestination() const {
+    Require(seeded, "sample staging copy must seed its padding before retiling");
+    // Retile overwrites logical words only; the full copy owns padding.
+    return {context.device, result->Handle(), 0, result->Bytes().size(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT};
+}
+}
