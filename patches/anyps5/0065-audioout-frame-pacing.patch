diff --git a/core/libs/prx/libSceAudioOut/src/AudioOutFramePacing.hpp b/core/libs/prx/libSceAudioOut/src/AudioOutFramePacing.hpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAudioOut/src/AudioOutFramePacing.hpp
@@ -0,0 +1,78 @@
+#pragma once
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+
+// Optional host cadence experiment, not a PS5 scheduling-contract assertion.
+namespace AudioOutFramePacing {
+inline bool EnabledValue(const char* value) {
+    return value != nullptr && std::strcmp(value, "1") == 0;
+}
+inline bool Enabled() {
+    static const bool enabled = EnabledValue(std::getenv("APS5_AUDIOOUT_FRAME_PACING"));
+    return enabled;
+}
+
+// Owned solely by the file-private Port under AudioOut's existing mutex.
+// No allocation, worker, new lock or public structure layout is involved.
+struct Cadence {
+    std::uint64_t wholeUs = 0;
+    std::uint64_t fraction = 0;
+    std::uint64_t denominator = 0;
+    std::uint64_t remainder = 0;
+    std::uint64_t deadlineUs = 0;
+    std::uint64_t lastCommitUs = 0;
+    std::uint32_t startupPackets = 0;
+    bool configured = false;
+    bool armed = false;
+
+    void Configure(std::uint32_t frames, std::uint32_t rate, std::uint64_t targetUs) {
+        *this = {};
+        if (frames == 0 || rate == 0) return;
+        const std::uint64_t numerator = static_cast<std::uint64_t>(frames) * 1000000ULL;
+        wholeUs = numerator / rate;
+        fraction = numerator % rate;
+        denominator = rate;
+        // The clock is in microseconds. Sub-microsecond blocks retain legacy pacing.
+        if (wholeUs == 0) return;
+        const std::uint64_t packets = targetUs / wholeUs + (targetUs % wholeUs != 0);
+        const std::uint64_t watermark = packets < 2 ? 2 : packets > 16 ? 16 : packets;
+        // The old strict > watermark check permits one additional current packet.
+        startupPackets = static_cast<std::uint32_t>(watermark + 1);
+        configured = true;
+    }
+    bool Configured() const { return configured; }
+    void ResetTimeline() {
+        armed = false;
+        deadlineUs = lastCommitUs = remainder = 0;
+        // A clear/drain/failure never grants another startup packet budget.
+    }
+    std::uint64_t Remaining(std::uint64_t nowUs) const {
+        if (!armed || nowUs < lastCommitUs || nowUs >= deadlineUs) return 0;
+        return deadlineUs - nowUs;
+    }
+    void Commit(std::uint64_t nowUs) {
+        if (!configured) return;
+        if (startupPackets != 0) {
+            --startupPackets;
+            if (startupPackets != 0) return;
+        }
+        const std::uint64_t grainCeil = wholeUs + (fraction != 0);
+        const bool reanchor = !armed || nowUs < lastCommitUs ||
+            (nowUs >= deadlineUs && nowUs - deadlineUs >= grainCeil);
+        const std::uint64_t base = reanchor ? nowUs : deadlineUs;
+        if (reanchor) remainder = 0;
+        remainder += fraction; // <2*UINT32_MAX; rate and frames originate as u32.
+        const std::uint64_t step = wholeUs + (remainder >= denominator);
+        if (remainder >= denominator) remainder -= denominator;
+        if (step > std::numeric_limits<std::uint64_t>::max() - base) {
+            ResetTimeline();
+            return;
+        }
+        deadlineUs = base + step;
+        lastCommitUs = nowUs;
+        armed = true;
+    }
+};
+} // namespace AudioOutFramePacing
