+bool IsUniformWaveBranchPredicate(const IrValue* value) {
+    // Any/all of one wave-uniform Boolean is that Boolean, including a partial
+    // subgroup. Prove only draw-wide scalar sources and a small pure expression
+    // closure. Do not reuse WaveUniformValues: a phi selected by divergent
+    // control flow can vary even when all its incoming operands are constants.
+    std::unordered_map<const IrValue*, bool> memo;
+    const auto prove = [&](const auto& self, const IrValue* current, unsigned depth) -> bool {
+        if (!current || depth > 64u) return false;
+        current = current->Resolve();
+        if (!current) return false;
+        if (current->HasImmediate()) return true;
+        if (const auto found = memo.find(current); found != memo.end()) return found->second;
+        if (memo.size() >= 256u) return false;
+        memo.emplace(current, false); // also breaks cycles, conservatively
+        switch (current->Opcode()) {
+        case IrOpcode::GetUserData:
+        case IrOpcode::GetShaderBase:
+            memo[current] = true;
+            return true;
+        case IrOpcode::GetBufferResource:
+        case IrOpcode::GetSrtResource:
+        case IrOpcode::ReadConst:
+        case IrOpcode::ReadConstBuffer:
+        case IrOpcode::BitCastF32U32:
+        case IrOpcode::BitCastU32F32:
+        case IrOpcode::BitwiseAnd32:
+        case IrOpcode::BitwiseOr32:
+        case IrOpcode::BitwiseXor32:
+        case IrOpcode::IEqual32:
+        case IrOpcode::INotEqual32:
+        case IrOpcode::LogicalNot:
+        case IrOpcode::LogicalAnd:
+        case IrOpcode::LogicalOr:
+        case IrOpcode::FPOrdEqual32:
+        case IrOpcode::FPUnordEqual32:
+        case IrOpcode::FPOrdNotEqual32:
+        case IrOpcode::FPUnordNotEqual32:
+        case IrOpcode::FPOrdLessThan32:
+        case IrOpcode::FPUnordLessThan32:
+        case IrOpcode::FPOrdGreaterThan32:
+        case IrOpcode::FPUnordGreaterThan32:
+        case IrOpcode::FPOrdLessThanEqual32:
+        case IrOpcode::FPUnordLessThanEqual32:
+        case IrOpcode::FPOrdGreaterThanEqual32:
+        case IrOpcode::FPUnordGreaterThanEqual32:
+            break;
+        default:
+            return false;
+        }
+        if (!current->ArgumentCount()) return false;
+        for (const IrValue* argument : current->Arguments())
+            if (!self(self, argument, depth + 1u)) return false;
+        memo[current] = true;
+        return true;
+    };
+    return prove(prove, value, 0u);
+}
