diff --git a/core/libs/prx/libSceAgcDriver/tests/ColorTargetSamples.cpp b/core/libs/prx/libSceAgcDriver/tests/ColorTargetSamples.cpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/ColorTargetSamples.cpp
@@ -0,0 +1,167 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorTargetTransfer.hpp"
+#include <algorithm>
+#include <bit>
+#include <cstring>
+#include <memory>
+#include <new>
+#include <string_view>
+
+namespace {
+using namespace AgcDriver::Graphics;
+
+template<class Action>
+void rejected(Action action, std::string_view reason) {
+    try { action(); }
+    catch (const std::runtime_error& error) {
+        Require(std::string_view(error.what()).find(reason) != std::string_view::npos,
+                std::string("unexpected color sample rejection: ") + error.what());
+        return;
+    }
+    throw std::runtime_error("expected color sample rejection: " + std::string(reason));
+}
+
+AgcDriver::QueueState colorState(std::uint64_t address, std::uint32_t samples,
+                                std::uint32_t slot = 0) {
+    AgcDriver::QueueState queue;
+    const auto stride = slot * 15u;
+    queue.context[0x318 + stride] = static_cast<std::uint32_t>(address >> 8u);
+    queue.context[0x390 + slot] = static_cast<std::uint32_t>(address >> 40u);
+    queue.context[0x31b + stride] = 0;
+    queue.context[0x31c + stride] = 0x28028u; // RGBA8 UNORM, no metadata compression.
+    const auto exponent = std::countr_zero(samples);
+    queue.context[0x31d + stride] = (exponent << 12u) | (exponent << 15u);
+    queue.context[0x3b0 + slot] = (256u << 14u) | 128u; // Odd extent crosses macroblocks.
+    queue.context[0x3b8 + slot] = 0x09000000u | (0x1bu << 14u); // 2D R64KB_X.
+    queue.context[0x2d5] = 0x2000;
+    queue.context[0x2f8] = 0;
+    queue.context[0x8e] = 0xfu << (4u * slot);
+    queue.context[0x8f] = 0xfu << (4u * slot);
+    queue.context[0x202] = 0xcc0010u;
+    queue.context[0x1c5] = 9u;
+    queue.context[0x1c3] = 4u;
+    queue.userConfig[0x242] = 4;
+    return queue;
+}
+}
+
+void RunColorTargetSampleTests() {
+    constexpr auto allocationSize = 2u * 1024u * 1024u;
+    constexpr auto alignment = std::align_val_t(65536);
+    const auto freeAligned = [](std::byte* p) { ::operator delete(p, alignment); };
+    const std::unique_ptr<std::byte, decltype(freeAligned)> memory(
+        static_cast<std::byte*>(::operator new(allocationSize, alignment)), freeAligned);
+    const auto address = reinterpret_cast<std::uintptr_t>(memory.get());
+    std::size_t transferred = 0;
+    for (const auto samples : {1u, 2u, 4u, 8u}) {
+        for (const auto slot : {0u, 7u}) {
+            auto queue = colorState(address, samples, slot);
+            const auto target = DecodeColorBuffer(queue.context, slot);
+            const ColorTargetLayout layout(257, 129, ColorTileMode::RenderTarget, 4, samples);
+            Require(target.samples == samples && target.fragments == samples && target.slot == slot,
+                    "color sample counts or slot were decoded incorrectly");
+            Require(target.bytes == layout.Bytes() && target.address == address &&
+                    target.extent.width == 257 && target.extent.height == 129,
+                    "color sample decode lost the complete guest allocation");
+            Require(target.bytes <= allocationSize, "color sample test allocation is too small");
+            std::fill_n(memory.get(), allocationSize, std::byte{0xa5});
+            std::vector<std::byte> linear(layout.LinearBytes());
+            std::vector<bool> used(target.bytes);
+            for (std::uint32_t y = 0; y < 129; ++y) {
+                for (std::uint32_t x = 0; x < 257; ++x) {
+                    for (std::uint32_t s = 0; s < samples; ++s) {
+                        const std::uint32_t value = 0x6e000000u | (y << 12u) | (x << 3u) | s;
+                        const auto linearOffset = ((static_cast<std::size_t>(y) * 257 + x) * samples + s) * 4;
+                        std::memcpy(linear.data() + linearOffset, &value, 4);
+                        const auto tiledOffset = layout.Offset(x, y, s);
+                        for (std::uint32_t b = 0; b < 4; ++b) used.at(tiledOffset + b) = true;
+                    }
+                }
+            }
+            WriteColorTarget(target, linear);
+            for (std::uint32_t y = 0; y < 129; ++y) {
+                for (std::uint32_t x = 0; x < 257; ++x) {
+                    for (std::uint32_t s = 0; s < samples; ++s) {
+                        std::uint32_t value;
+                        std::memcpy(&value, memory.get() + layout.Offset(x, y, s), 4);
+                        Require(value == (0x6e000000u | (y << 12u) | (x << 3u) | s),
+                                "a color sample was aliased, skipped or reordered on guest write");
+                    }
+                }
+            }
+            for (std::size_t b = 0; b < target.bytes; ++b) {
+                Require(used[b] || memory.get()[b] == std::byte{0xa5}, "color sample transfer changed tiled padding");
+            }
+            Require(std::ranges::all_of(std::span(memory.get() + target.bytes, allocationSize - target.bytes),
+                                       [](std::byte b) { return b == std::byte{0xa5}; }),
+                    "color sample transfer wrote beyond the decoded guest allocation");
+            std::vector<std::byte> returned(linear.size());
+            ReadColorTarget(target, returned);
+            Require(returned == linear, "color sample transfer failed its complete round trip");
+            auto shortBuffer = std::span(returned).first(returned.size() - 4);
+            rejected([&] { ReadColorTarget(target, shortBuffer); }, "transfer size mismatch");
+            rejected([&] { WriteColorTarget(target, shortBuffer); }, "transfer size mismatch");
+            auto eqaa = target;
+            eqaa.fragments = samples == 1 ? 2 : 1;
+            rejected([&] { ReadColorTarget(eqaa, returned); }, "FMASK sample mapping");
+            rejected([&] { WriteColorTarget(eqaa, returned); }, "FMASK sample mapping");
+            if (samples != 1) {
+                Require(DrawRejection(queue, false).find("sample-aware renderer") != std::string::npos,
+                        "a multisample color target bypassed the draw rejection with PA_SC_AA_CONFIG zero");
+                rejected([&] { DecodeState(queue); }, "sample-aware renderer");
+                queue.context[0x202] = 0xcc0020u;
+                rejected([&] { DecodeColorMetadataPass(queue); }, "multisampled color targets");
+            }
+            transferred += linear.size();
+        }
+    }
+    auto queue = colorState(address, 8);
+    const auto original = queue;
+    queue.context[0x31d] = (3u << 12u) | (2u << 15u);
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "EQAA");
+    queue = original;
+    queue.context[0x31d] = (4u << 12u) | (3u << 15u);
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "above eight");
+    for (const auto bit : {0x20u, 0x400u, 0x20000u, 0x80000000u}) {
+        queue = original;
+        queue.context[0x31d] |= bit;
+        rejected([&] { DecodeColorBuffer(queue.context, 0); }, "reserved attributes");
+    }
+    for (const auto bit : {0x4000u, 0x04000000u, 0x08000000u}) {
+        queue = original;
+        queue.context[0x31c] |= bit;
+        rejected([&] { DecodeColorBuffer(queue.context, 0); }, "FMASK color compression");
+    }
+    queue = original;
+    queue.context[0x31c] |= 0x10000000u;
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "multisampled DCC");
+    queue = original;
+    queue.context[0x31c] |= 0x2000u;
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "multisampled CMASK");
+    queue = original;
+    queue.context[0x3b8] = 0x09000000u;
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "R64KB_X");
+    queue = original;
+    queue.context[0x3b0] |= 1u << 28u;
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "multisampled mipmapped");
+    queue = original;
+    queue.context[0x31b] = 1u | (1u << 13u);
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "multisampled mipmapped");
+    queue = original;
+    queue.context[0x3b8] = 0x0a000001u | (0x1bu << 14u);
+    rejected([&] { DecodeColorBuffer(queue.context, 0); }, "multisampled mipmapped");
+    rejected([&] { DecodeColorBuffer(original.context, 8); }, "slot exceeds");
+    Require(transferred == 257u * 129u * 4u * 15u * 2u, "color sample transfer coverage changed");
+}
+
+#ifdef APS5_COLOR_SAMPLES_TEST_STANDALONE
+#include <iostream>
+int main() {
+    try {
+        RunColorTargetSampleTests();
+        std::cout << "Color sample state and transfer tests passed: 8 target/slot combinations, all samples preserved\n";
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
+#endif
