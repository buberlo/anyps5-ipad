@@ -0,0 +1,118 @@
+#include "prx/libSceAgcDriver/Graphics/include/DepthTargetLayout.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/DepthSampleSwizzleEquations.hpp"
+#include <bit>
+#include <cstring>
+#include <limits>
+#include <mutex>
+#include <stdexcept>
+#include <vector>
+
+namespace AgcDriver::Graphics {
+namespace {
+
+void require(bool condition, const char* reason) {
+    if (!condition) throw std::runtime_error(reason);
+}
+
+std::uint32_t parity(std::uint32_t value) {
+    return static_cast<std::uint32_t>(std::popcount(value)) & 1u;
+}
+
+struct SwizzleTables {
+    std::vector<std::uint32_t> x;
+    std::vector<std::uint32_t> y;
+};
+
+const SwizzleTables& tablesFor(const DepthSampleSwizzleEquation& equation) {
+    static std::once_flag once[4][3];
+    static SwizzleTables tables[4][3];
+    const auto sampleIndex = std::countr_zero(equation.samples);
+    const auto elementIndex = std::countr_zero(equation.elementBytes);
+    std::call_once(once[sampleIndex][elementIndex], [&] {
+        auto& table = tables[sampleIndex][elementIndex];
+        std::uint32_t used = 0;
+        for (const auto bit : equation.bits) used |= bit;
+        // Pipe XOR retains coordinate bits above a macroblock's dimensions.
+        // Cache the equation period rather than an entire surface-sized table.
+        table.x.resize(std::bit_ceil((used & 0xfffu) + 1u));
+        table.y.resize(std::bit_ceil(((used >> 12u) & 0xfffu) + 1u));
+        for (std::uint32_t x = 0; x < table.x.size(); ++x) {
+            std::uint32_t offset = 0;
+            for (std::uint32_t bit = 0; bit < 16u; ++bit) offset |= parity(x & equation.bits[bit] & 0xfffu) << bit;
+            table.x[x] = offset;
+        }
+        for (std::uint32_t y = 0; y < table.y.size(); ++y) {
+            std::uint32_t offset = 0;
+            for (std::uint32_t bit = 0; bit < 16u; ++bit) offset |= parity((y << 12u) & equation.bits[bit] & 0xfff000u) << bit;
+            table.y[y] = offset;
+        }
+    });
+    return tables[sampleIndex][elementIndex];
+}
+
+}
+
+DepthTargetLayout::DepthTargetLayout(std::uint32_t width, std::uint32_t height, DepthPlane plane, DepthLayoutParameters parameters)
+    : width(width), height(height), elementBytes(static_cast<std::uint32_t>(plane)), samples(parameters.samples) {
+    require(width != 0 && height != 0 && width <= 16384u && height <= 16384u, "AGC graphics: invalid depth/stencil surface extent");
+    require(plane == DepthPlane::Stencil8 || plane == DepthPlane::Depth16 || plane == DepthPlane::Depth32, "AGC graphics: unsupported depth/stencil plane format");
+    require(std::has_single_bit(samples) && samples <= 8u, "AGC graphics: unsupported depth/stencil sample count");
+    require(parameters.fragments == samples, "AGC graphics: depth/stencil coverage and stored samples differ");
+    require(parameters.swizzleMode == 24u, "AGC graphics: depth/stencil layout requires SW_64KB_Z_X");
+    require(parameters.pipeBankXor == 0u, "AGC graphics: nonzero depth/stencil pipe/bank XOR is unsupported");
+    require(!parameters.compressionEnabled, "AGC graphics: compressed depth/stencil plane requires HTILE interpretation");
+    const auto* equation = FindDepthSampleSwizzleEquation(elementBytes, samples);
+    require(equation != nullptr, "AGC graphics: no depth/stencil sample swizzle equation");
+    blockWidth = equation->blockWidth;
+    blockHeight = equation->blockHeight;
+    pitch = (width + blockWidth - 1u) / blockWidth * blockWidth;
+    paddedHeight = (height + blockHeight - 1u) / blockHeight * blockHeight;
+    require(parameters.pitchInElements == 0u || parameters.pitchInElements == pitch, "AGC graphics: noncanonical depth/stencil pitch is unsupported");
+    const auto size = static_cast<std::uint64_t>(pitch) * paddedHeight * elementBytes * samples;
+    require(size <= std::numeric_limits<std::size_t>::max(), "AGC graphics: depth/stencil surface size overflow");
+    bytes = static_cast<std::size_t>(size);
+    const auto& tables = tablesFor(*equation);
+    xOffsets = tables.x.data();
+    yOffsets = tables.y.data();
+    xMask = static_cast<std::uint32_t>(tables.x.size() - 1u);
+    yMask = static_cast<std::uint32_t>(tables.y.size() - 1u);
+    for (std::uint32_t sample = 0; sample < samples; ++sample) {
+        for (std::uint32_t bit = 0; bit < 16u; ++bit) sampleOffsets[sample] |= parity((sample << 24u) & equation->bits[bit]) << bit;
+    }
+}
+
+std::size_t DepthTargetLayout::offset(std::uint32_t x, std::uint32_t y, std::uint32_t sample) const {
+    const auto block = static_cast<std::size_t>(y / blockHeight) * BlocksPerRow() + x / blockWidth;
+    return block * Alignment() + (xOffsets[x & xMask] ^ yOffsets[y & yMask] ^ sampleOffsets[sample]);
+}
+
+std::size_t DepthTargetLayout::Offset(std::uint32_t x, std::uint32_t y, std::uint32_t sample) const {
+    require(x < width && y < height && sample < samples, "AGC graphics: depth/stencil surface coordinate out of range");
+    return offset(x, y, sample);
+}
+
+void DepthTargetLayout::Detile(std::span<const std::byte> source, std::span<std::byte> destination) const {
+    require(source.size() == Bytes() && destination.size() == LinearBytes(), "AGC graphics: depth/stencil detile buffer size mismatch");
+    for (std::uint32_t y = 0; y < height; ++y) {
+        auto* row = destination.data() + static_cast<std::size_t>(y) * width * elementBytes * samples;
+        for (std::uint32_t x = 0; x < width; ++x) {
+            for (std::uint32_t sample = 0; sample < samples; ++sample) {
+                std::memcpy(row + (static_cast<std::size_t>(x) * samples + sample) * elementBytes, source.data() + offset(x, y, sample), elementBytes);
+            }
+        }
+    }
+}
+
+void DepthTargetLayout::Tile(std::span<const std::byte> source, std::span<std::byte> destination) const {
+    require(source.size() == LinearBytes() && destination.size() == Bytes(), "AGC graphics: depth/stencil tile buffer size mismatch");
+    for (std::uint32_t y = 0; y < height; ++y) {
+        const auto* row = source.data() + static_cast<std::size_t>(y) * width * elementBytes * samples;
+        for (std::uint32_t x = 0; x < width; ++x) {
+            for (std::uint32_t sample = 0; sample < samples; ++sample) {
+                std::memcpy(destination.data() + offset(x, y, sample), row + (static_cast<std::size_t>(x) * samples + sample) * elementBytes, elementBytes);
+            }
+        }
+    }
+}
+
+}
