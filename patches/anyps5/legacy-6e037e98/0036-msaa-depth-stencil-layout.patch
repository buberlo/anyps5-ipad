+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_DEPTHTARGETLAYOUT_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_DEPTHTARGETLAYOUT_HPP
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+
+namespace AgcDriver::Graphics {
+
+// The guest stores depth and stencil in separate planes, not a packed host D/S texel.
+enum class DepthPlane : std::uint32_t {
+    Stencil8 = 1,
+    Depth16 = 2,
+    Depth32 = 4
+};
+
+struct DepthLayoutParameters {
+    std::uint32_t samples = 1;
+    std::uint32_t fragments = 1;
+    std::uint32_t swizzleMode = 24; // SW_64KB_Z_X
+    std::uint32_t pitchInElements = 0; // 0 selects the canonical padded pitch.
+    std::uint32_t pipeBankXor = 0;
+    bool compressionEnabled = false;
+};
+
+// Uncompressed, single-mip 2D plane at slice 0. Other slice/mip addressing and
+// HTILE interpretation must be qualified separately before using these bytes.
+class DepthTargetLayout {
+public:
+    DepthTargetLayout(std::uint32_t width, std::uint32_t height, DepthPlane plane, DepthLayoutParameters parameters = {});
+    std::size_t Bytes() const { return bytes; }
+    std::size_t LinearBytes() const { return static_cast<std::size_t>(width) * height * elementBytes * samples; }
+    std::size_t Alignment() const { return 65536u; }
+    std::uint32_t Pitch() const { return pitch; }
+    std::uint32_t PaddedHeight() const { return paddedHeight; }
+    std::uint32_t BlockWidth() const { return blockWidth; }
+    std::uint32_t BlockHeight() const { return blockHeight; }
+    std::uint32_t BlocksPerRow() const { return pitch / blockWidth; }
+    std::uint32_t Samples() const { return samples; }
+    std::uint32_t ElementBytes() const { return elementBytes; }
+    std::size_t Offset(std::uint32_t x, std::uint32_t y, std::uint32_t sample = 0) const;
+    // Linear buffers preserve every stored sample: ((y * width + x) * samples
+    // + sample) * elementBytes. Tile changes logical samples only, not padding.
+    void Detile(std::span<const std::byte> source, std::span<std::byte> destination) const;
+    void Tile(std::span<const std::byte> source, std::span<std::byte> destination) const;
+
+private:
+    std::size_t offset(std::uint32_t x, std::uint32_t y, std::uint32_t sample) const;
+    std::uint32_t width;
+    std::uint32_t height;
+    std::uint32_t pitch;
+    std::uint32_t paddedHeight;
+    std::uint32_t blockWidth;
+    std::uint32_t blockHeight;
+    std::uint32_t elementBytes;
+    std::uint32_t samples;
+    std::size_t bytes;
+    std::uint32_t xMask;
+    std::uint32_t yMask;
+    std::array<std::uint32_t, 8> sampleOffsets{};
+    const std::uint32_t* xOffsets;
+    const std::uint32_t* yOffsets;
+};
+
+}
+
+#endif
