+namespace AgcDriver::Graphics {
+
+// Uncompressed SW_64KB_Z_X planes, Navi1x non-RB+, 16 pipes, 256-byte interleave.
+// Generated by querying AMD AddrLib at PAL c5e800072a32f68b6ccc4422936d96167c6e0728.
+// The independent reference uses depth flags for 16/32-bit planes and stencil
+// flags for 8-bit planes. Each has samples == fragments, 1 slice, 1 mip and
+// pipeBankXor == 0. Coordinate masks: x bits 0..11, y bits 12..23, sample bits
+// 24..26. Full-surface coordinates retain pipe XOR above macroblock dimensions.
+struct DepthSampleSwizzleEquation {
+    std::uint32_t elementBytes;
+    std::uint32_t samples;
+    std::uint32_t blockWidth;
+    std::uint32_t blockHeight;
+    std::array<std::uint32_t, 16> bits;
+};
+
+inline constexpr DepthSampleSwizzleEquation kDepthSampleSwizzleEquations[] = {
+    {1u, 1u, 256u, 256u, {0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00000008u, 0x00010000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00040000u, 0x00000040u, 0x00080000u, 0x00000080u}},
+    {1u, 2u, 128u, 256u, {0x01000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00000008u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00010000u, 0x00040000u, 0x00000040u, 0x00080000u}},
+    {1u, 4u, 128u, 128u, {0x01000000u, 0x02000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00040000u, 0x00000040u}},
+    {1u, 8u, 64u, 128u, {0x01000000u, 0x02000000u, 0x04000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00040000u, 0x00084000u}},
+    {2u, 1u, 256u, 128u, {0x00000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00000008u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00010000u, 0x00000040u, 0x00040000u, 0x00000080u}},
+    {2u, 2u, 128u, 128u, {0x00000000u, 0x01000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00040000u, 0x00000040u}},
+    {2u, 4u, 128u, 64u, {0x00000000u, 0x01000000u, 0x02000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00000008u, 0x00010000u, 0x00000040u, 0x00044000u}},
+    {2u, 8u, 64u, 64u, {0x00000000u, 0x01000000u, 0x02000000u, 0x04000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00044000u, 0x00080004u}},
+    {4u, 1u, 128u, 128u, {0x00000000u, 0x00000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00004000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00040000u, 0x00000040u}},
+    {4u, 2u, 64u, 128u, {0x00000000u, 0x00000000u, 0x01000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00000004u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00040000u, 0x00084000u}},
+    {4u, 4u, 64u, 64u, {0x00000000u, 0x00000000u, 0x01000000u, 0x02000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00002000u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00008000u, 0x00000010u, 0x00044000u, 0x00080004u}},
+    {4u, 8u, 32u, 64u, {0x00000000u, 0x00000000u, 0x01000000u, 0x02000000u, 0x04000000u, 0x00000001u, 0x00001000u, 0x00000002u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00044020u, 0x00000008u, 0x00010000u, 0x00040004u, 0x00082000u}},
+};
+
+inline constexpr const DepthSampleSwizzleEquation* FindDepthSampleSwizzleEquation(std::uint32_t bytes, std::uint32_t samples) {
+    for (const auto& equation : kDepthSampleSwizzleEquations) {
+        if (equation.elementBytes == bytes && equation.samples == samples) return &equation;
+    }
+    return nullptr;
+}
+
+}
+#endif
