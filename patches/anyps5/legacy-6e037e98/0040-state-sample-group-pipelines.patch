+void Pipeline::validateSamples(const State& state) const {
+    Require(state.samples.count == sampleConfiguration.count && state.samples.mask == sampleConfiguration.mask,
+            "draw samples do not match the pipeline configuration");
+    if (sampleConfiguration.count > 1u) {
+        for (unsigned sample = 0; sample < sampleConfiguration.nativeCount; ++sample) {
+            const auto position = state.samples.positions[sampleGroup * sampleConfiguration.nativeCount + sample];
+            Require(position.x == samplePositions[sample].x && position.y == samplePositions[sample].y,
+                    "draw sample pattern does not match the pipeline configuration");
+        }
+    }
+}
