+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORSAMPLETRANSFER_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORSAMPLETRANSFER_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/Resources.hpp"
+
+namespace AgcDriver::Graphics {
+
+// Explicit state on this Context's queue. Queue ownership transfers and concurrent recording
+// are not supported. Buffer offsets are byte offsets; each packed word is little-endian RGBA8.
+struct ColorSampleBufferAccess {
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceSize offset = 0;
+    VkDeviceSize bytes = 0;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+struct ColorSampleImageAccess {
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+
+// A full-image, exact-sample RGBA8_UNORM transfer. Logical sample i is array layer
+// i/nativeSamples, native sample i%nativeSamples. Samples 2/4/8 are supported; single-sample
+// targets keep the existing copy path. No resolve, averaging, or sample-rate shading is used.
+// Keep this object, its RenderTarget, and all recorded buffers alive until their GPU fence has
+// completed. Each call retains a distinct descriptor pool, so a later call cannot rewrite a
+// pending call's bindings. Recording replaces pipeline/descriptor/viewport/scissor state.
+class ColorSampleTransfer {
+public:
+    ColorSampleTransfer(const Context& context, RenderTarget& target, const ColorTarget& color);
+    ~ColorSampleTransfer();
+    ColorSampleTransfer(const ColorSampleTransfer&) = delete;
+    ColorSampleTransfer& operator=(const ColorSampleTransfer&) = delete;
+    VkDeviceSize PackedBytes() const { return packedBytes; }
+    void RecordUpload(VkCommandBuffer commands, const ColorSampleBufferAccess& source,
+                      ColorSampleImageAccess before, ColorSampleImageAccess after);
+    // The output's prior state is supplied separately from its intended consumer state.
+    // This makes using one host-visible storage buffer for upload then readback explicit.
+    void RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                        ColorSampleImageAccess before, ColorSampleImageAccess after,
+                        VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess);
+private:
+    void release() noexcept;
+    void validateBuffer(const ColorSampleBufferAccess& buffer) const;
+    void validateImage(ColorSampleImageAccess state, bool allowUndefined) const;
+    VkDescriptorSet descriptor(bool upload, const ColorSampleBufferAccess& buffer);
+    Context context;
+    RenderTarget& target;
+    VkExtent2D extent;
+    std::uint32_t samples;
+    std::uint32_t nativeSamples;
+    VkDeviceSize packedBytes;
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    std::array<VkFramebuffer, 2> framebuffers{};
+    std::array<VkPipeline, 4> uploadPipelines{};
+    VkPipeline readbackPipeline = VK_NULL_HANDLE;
+    VkDescriptorSetLayout uploadDescriptors = VK_NULL_HANDLE;
+    VkDescriptorSetLayout readbackDescriptors = VK_NULL_HANDLE;
+    VkPipelineLayout uploadLayout = VK_NULL_HANDLE;
+    VkPipelineLayout readbackLayout = VK_NULL_HANDLE;
+    std::vector<VkDescriptorPool> retainedPools;
+    PFN_vkDestroyFramebuffer destroyFramebuffer = nullptr;
+    PFN_vkDestroyRenderPass destroyRenderPass = nullptr;
+    PFN_vkDestroyPipeline destroyPipeline = nullptr;
+    PFN_vkDestroyPipelineLayout destroyPipelineLayout = nullptr;
+    PFN_vkDestroyDescriptorSetLayout destroyDescriptorSetLayout = nullptr;
+    PFN_vkDestroyDescriptorPool destroyDescriptorPool = nullptr;
+};
+}
+#endif
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp
@@ -0,0 +1,331 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorSampleTransfer.hpp"
+#include "prx/libSceAgcDriver/Graphics/shaders/ColorSampleTransfer_spv.h"
+#include <bit>
+#include <limits>
+
+namespace AgcDriver::Graphics {
+namespace {
+void ImageBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                  const RenderTarget& target, ColorSampleImageAccess before,
+                  ColorSampleImageAccess after) {
+    VkImageMemoryBarrier image{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    image.srcAccessMask = before.access;
+    image.dstAccessMask = after.access;
+    image.oldLayout = before.layout;
+    image.newLayout = after.layout;
+    image.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    image.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    image.image = target.Image();
+    image.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, target.Groups()};
+    barrier(commands, before.stage, after.stage, 0, 0, nullptr, 0, nullptr, 1, &image);
+}
+void BufferBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                   const ColorSampleBufferAccess& before, VkDeviceSize bytes,
+                   VkPipelineStageFlags afterStage, VkAccessFlags afterAccess) {
+    VkBufferMemoryBarrier buffer{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    buffer.srcAccessMask = before.access;
+    buffer.dstAccessMask = afterAccess;
+    buffer.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.buffer = before.buffer;
+    buffer.offset = before.offset;
+    buffer.size = bytes;
+    barrier(commands, before.stage, afterStage, 0, 0, nullptr, 1, &buffer, 0, nullptr);
+}
+constexpr ColorSampleImageAccess AttachmentAccess{
+    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+    VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT};
+constexpr ColorSampleImageAccess ReadbackAccess{
+    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+    VK_ACCESS_SHADER_READ_BIT};
+}
+
+ColorSampleTransfer::ColorSampleTransfer(const Context& context, RenderTarget& target,
+                                         const ColorTarget& color)
+    : context(context), target(target), extent(color.extent), samples(color.samples),
+      nativeSamples(static_cast<std::uint32_t>(target.NativeSamples())), packedBytes(0) {
+    Require(color.format == VK_FORMAT_R8G8B8A8_UNORM && target.Format() == color.format, "color sample transfer requires matching RGBA8_UNORM format");
+    Require(target.Extent().width == extent.width && target.Extent().height == extent.height && target.Device() == context.device,
+            "color sample transfer target extent/device mismatch");
+    Require(std::has_single_bit(samples) && samples >= 2 && samples <= 8 && color.fragments == samples,
+            "color sample transfer requires equal 2/4/8 sample and fragment counts");
+    Require(nativeSamples == (samples > 4 ? 4u : samples) && target.Groups() == samples / nativeSamples,
+            "color sample transfer target group/count mismatch");
+    Require(target.Image() != VK_NULL_HANDLE && target.SampledView() != VK_NULL_HANDLE,
+            "color sample transfer target is unavailable");
+    Require(extent.width && extent.height && extent.width <= context.limits.maxFramebufferWidth &&
+            extent.height <= context.limits.maxFramebufferHeight, "color sample transfer extent is unsupported");
+    Require(extent.width <= context.limits.maxViewportDimensions[0] && extent.height <= context.limits.maxViewportDimensions[1],
+            "color sample transfer extent exceeds viewport limits");
+    const auto words = std::uint64_t(extent.width) * extent.height * samples;
+    Require(words <= std::numeric_limits<std::uint32_t>::max(), "color sample transfer indexing overflows");
+    packedBytes = words * 4u;
+    Require(packedBytes <= context.limits.maxStorageBufferRange, "color sample transfer exceeds storage buffer range");
+    Require(context.limits.maxPushConstantsSize >= 16 && context.limits.maxPerStageDescriptorStorageBuffers >= 1 &&
+            context.limits.maxPerStageDescriptorSampledImages >= 1 && context.limits.maxDescriptorSetStorageBuffers >= 1 &&
+            context.limits.maxDescriptorSetSampledImages >= 1, "color sample transfer descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 8 && context.limits.maxComputeWorkGroupSize[1] >= 8 &&
+            context.limits.maxComputeWorkGroupInvocations >= 64 && (extent.width + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[0] &&
+            (extent.height + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[1], "color sample transfer compute limits are unsupported");
+    // Resolve destructors before making anything: partial-construction cleanup cannot fail
+    // because a later vkGetDeviceProcAddr lookup happens to be absent.
+    destroyFramebuffer = context.Function<PFN_vkDestroyFramebuffer>("vkDestroyFramebuffer");
+    destroyRenderPass = context.Function<PFN_vkDestroyRenderPass>("vkDestroyRenderPass");
+    destroyPipeline = context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+    destroyPipelineLayout = context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+    destroyDescriptorSetLayout = context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+    destroyDescriptorPool = context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool");
+    const auto destroyModule = context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule");
+    std::array<VkShaderModule, 3> modules{};
+    try {
+        const VkDescriptorSetLayoutBinding uploadBinding{0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo descriptorInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        descriptorInfo.bindingCount = 1;
+        descriptorInfo.pBindings = &uploadBinding;
+        const auto createDescriptors = context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout");
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &uploadDescriptors), "vkCreateDescriptorSetLayout color sample upload");
+        const std::array<VkDescriptorSetLayoutBinding, 2> readbackBindings{{
+            {0, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr}}};
+        descriptorInfo.bindingCount = 2;
+        descriptorInfo.pBindings = readbackBindings.data();
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &readbackDescriptors), "vkCreateDescriptorSetLayout color sample readback");
+        VkPushConstantRange push{VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1;
+        layoutInfo.pSetLayouts = &uploadDescriptors;
+        layoutInfo.pushConstantRangeCount = 1;
+        layoutInfo.pPushConstantRanges = &push;
+        const auto createLayout = context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout");
+        Check(createLayout(context.device, &layoutInfo, nullptr, &uploadLayout), "vkCreatePipelineLayout color sample upload");
+        layoutInfo.pSetLayouts = &readbackDescriptors;
+        push.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        Check(createLayout(context.device, &layoutInfo, nullptr, &readbackLayout), "vkCreatePipelineLayout color sample readback");
+        VkAttachmentDescription attachment{};
+        attachment.format = color.format;
+        attachment.samples = target.NativeSamples();
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        VkAttachmentReference reference{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+        VkSubpassDescription subpass{};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.colorAttachmentCount = 1;
+        subpass.pColorAttachments = &reference;
+        VkRenderPassCreateInfo passInfo{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        passInfo.attachmentCount = 1;
+        passInfo.pAttachments = &attachment;
+        passInfo.subpassCount = 1;
+        passInfo.pSubpasses = &subpass;
+        Check(context.Function<PFN_vkCreateRenderPass>("vkCreateRenderPass")(context.device, &passInfo, nullptr, &renderPass), "vkCreateRenderPass color sample upload");
+        for (std::uint32_t group = 0; group < target.Groups(); ++group) {
+            const auto view = target.View(group);
+            VkFramebufferCreateInfo framebufferInfo{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+            framebufferInfo.renderPass = renderPass;
+            framebufferInfo.attachmentCount = 1;
+            framebufferInfo.pAttachments = &view;
+            framebufferInfo.width = extent.width;
+            framebufferInfo.height = extent.height;
+            framebufferInfo.layers = 1;
+            Check(context.Function<PFN_vkCreateFramebuffer>("vkCreateFramebuffer")(context.device, &framebufferInfo, nullptr, &framebuffers[group]), "vkCreateFramebuffer color sample group");
+        }
+        const std::array<std::span<const std::uint32_t>, 3> programs{
+            COLOR_SAMPLE_UPLOAD_VERT_SPV, COLOR_SAMPLE_UPLOAD_FRAG_SPV, COLOR_SAMPLE_READBACK_COMP_SPV};
+        const auto createModule = context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule");
+        for (std::uint32_t i = 0; i < modules.size(); ++i) {
+            VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            moduleInfo.codeSize = programs[i].size_bytes();
+            moduleInfo.pCode = programs[i].data();
+            Check(createModule(context.device, &moduleInfo, nullptr, &modules[i]), "vkCreateShaderModule color sample transfer");
+        }
+        const std::array<VkPipelineShaderStageCreateInfo, 2> stages{{
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, modules[0], "main", nullptr},
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, modules[1], "main", nullptr}}};
+        VkPipelineVertexInputStateCreateInfo vertices{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        VkPipelineInputAssemblyStateCreateInfo assembly{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo viewport{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        viewport.viewportCount = viewport.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo raster{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        raster.polygonMode = VK_POLYGON_MODE_FILL;
+        raster.cullMode = VK_CULL_MODE_NONE;
+        raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        raster.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo multisample{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        multisample.rasterizationSamples = target.NativeSamples();
+        // One selected native sample per raster invocation; sampleRateShading is unnecessary.
+        VkSampleMask sampleMask = 1;
+        multisample.pSampleMask = &sampleMask;
+        VkPipelineColorBlendAttachmentState blending{};
+        blending.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+        VkPipelineColorBlendStateCreateInfo blend{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        blend.attachmentCount = 1;
+        blend.pAttachments = &blending;
+        const std::array<VkDynamicState, 2> dynamicStates{VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+        VkPipelineDynamicStateCreateInfo dynamic{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dynamic.dynamicStateCount = static_cast<std::uint32_t>(dynamicStates.size());
+        dynamic.pDynamicStates = dynamicStates.data();
+        VkGraphicsPipelineCreateInfo graphics{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        graphics.stageCount = static_cast<std::uint32_t>(stages.size());
+        graphics.pStages = stages.data();
+        graphics.pVertexInputState = &vertices;
+        graphics.pInputAssemblyState = &assembly;
+        graphics.pViewportState = &viewport;
+        graphics.pRasterizationState = &raster;
+        graphics.pMultisampleState = &multisample;
+        graphics.pColorBlendState = &blend;
+        graphics.pDynamicState = &dynamic;
+        graphics.layout = uploadLayout;
+        graphics.renderPass = renderPass;
+        const auto createGraphics = context.Function<PFN_vkCreateGraphicsPipelines>("vkCreateGraphicsPipelines");
+        for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+            sampleMask = 1u << sample;
+            Check(createGraphics(context.device, context.pipelineCache, 1, &graphics, nullptr, &uploadPipelines[sample]), "vkCreateGraphicsPipelines color sample upload");
+        }
+        VkComputePipelineCreateInfo compute{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        compute.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        compute.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        compute.stage.module = modules[2];
+        compute.stage.pName = "main";
+        compute.layout = readbackLayout;
+        Check(context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(context.device, context.pipelineCache, 1, &compute, nullptr, &readbackPipeline), "vkCreateComputePipelines color sample readback");
+        for (auto& module : modules) { destroyModule(context.device, module, nullptr); module = VK_NULL_HANDLE; }
+    } catch (...) {
+        for (const auto module : modules) if (module) destroyModule(context.device, module, nullptr);
+        release();
+        throw;
+    }
+}
+ColorSampleTransfer::~ColorSampleTransfer() { release(); }
+void ColorSampleTransfer::release() noexcept {
+    for (const auto pool : retainedPools) destroyDescriptorPool(context.device, pool, nullptr);
+    for (const auto framebuffer : framebuffers) if (framebuffer) destroyFramebuffer(context.device, framebuffer, nullptr);
+    for (const auto pipeline : uploadPipelines) if (pipeline) destroyPipeline(context.device, pipeline, nullptr);
+    if (readbackPipeline) destroyPipeline(context.device, readbackPipeline, nullptr);
+    if (renderPass) destroyRenderPass(context.device, renderPass, nullptr);
+    if (uploadLayout) destroyPipelineLayout(context.device, uploadLayout, nullptr);
+    if (readbackLayout) destroyPipelineLayout(context.device, readbackLayout, nullptr);
+    if (uploadDescriptors) destroyDescriptorSetLayout(context.device, uploadDescriptors, nullptr);
+    if (readbackDescriptors) destroyDescriptorSetLayout(context.device, readbackDescriptors, nullptr);
+}
+void ColorSampleTransfer::validateBuffer(const ColorSampleBufferAccess& buffer) const {
+    Require(buffer.buffer != VK_NULL_HANDLE && buffer.bytes >= packedBytes && buffer.stage != 0,
+            "color sample transfer buffer/range/state is unavailable");
+    const auto alignment = std::max<VkDeviceSize>(4, context.limits.minStorageBufferOffsetAlignment);
+    Require(buffer.offset % alignment == 0 && buffer.offset <= std::numeric_limits<VkDeviceSize>::max() - packedBytes,
+            "color sample transfer buffer offset is invalid");
+}
+void ColorSampleTransfer::validateImage(ColorSampleImageAccess state, bool allowUndefined) const {
+    Require(state.stage != 0, "color sample transfer image stage is missing");
+    Require(state.layout == VK_IMAGE_LAYOUT_GENERAL || state.layout == VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL || state.layout == VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL || (allowUndefined && state.layout == VK_IMAGE_LAYOUT_UNDEFINED),
+            "color sample transfer image layout is unsupported");
+    Require(state.layout != VK_IMAGE_LAYOUT_UNDEFINED || state.access == 0, "undefined color image cannot have prior access");
+}
+VkDescriptorSet ColorSampleTransfer::descriptor(bool upload, const ColorSampleBufferAccess& buffer) {
+    // Resolve every fallible host operation before recording any GPU commands.
+    const auto createPool = context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool");
+    const auto allocateSet = context.Function<PFN_vkAllocateDescriptorSets>("vkAllocateDescriptorSets");
+    const auto updateSet = context.Function<PFN_vkUpdateDescriptorSets>("vkUpdateDescriptorSets");
+    const std::array<VkDescriptorPoolSize, 2> sizes{{{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1}, {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1}}};
+    VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    poolInfo.maxSets = 1;
+    poolInfo.poolSizeCount = upload ? 1 : 2;
+    poolInfo.pPoolSizes = sizes.data();
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    Check(createPool(context.device, &poolInfo, nullptr, &pool), "vkCreateDescriptorPool color sample transfer");
+    try {
+        const auto layout = upload ? uploadDescriptors : readbackDescriptors;
+        VkDescriptorSetAllocateInfo allocation{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        allocation.descriptorPool = pool;
+        allocation.descriptorSetCount = 1;
+        allocation.pSetLayouts = &layout;
+        VkDescriptorSet set = VK_NULL_HANDLE;
+        Check(allocateSet(context.device, &allocation, &set), "vkAllocateDescriptorSets color sample transfer");
+        const VkDescriptorBufferInfo bufferInfo{buffer.buffer, buffer.offset, packedBytes};
+        const VkDescriptorImageInfo imageInfo{VK_NULL_HANDLE, target.SampledView(), ReadbackAccess.layout};
+        std::array<VkWriteDescriptorSet, 2> writes{};
+        writes[0].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        writes[0].dstSet = set;
+        writes[0].dstBinding = upload ? 0 : 1;
+        writes[0].descriptorCount = 1;
+        writes[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        writes[0].pBufferInfo = &bufferInfo;
+        if (!upload) {
+            writes[1].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+            writes[1].dstSet = set;
+            writes[1].dstBinding = 0;
+            writes[1].descriptorCount = 1;
+            writes[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+            writes[1].pImageInfo = &imageInfo;
+        }
+        updateSet(context.device, upload ? 1u : 2u, writes.data(), 0, nullptr);
+        retainedPools.push_back(pool);
+        return set;
+    } catch (...) { destroyDescriptorPool(context.device, pool, nullptr); throw; }
+}
+void ColorSampleTransfer::RecordUpload(VkCommandBuffer commands, const ColorSampleBufferAccess& source,
+                                     ColorSampleImageAccess before, ColorSampleImageAccess after) {
+    Require(commands != VK_NULL_HANDLE, "color sample transfer command buffer is unavailable");
+    validateBuffer(source); validateImage(before, true); validateImage(after, false);
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto begin = context.Resolved(&DeviceFunctions::cmdBeginRenderPass, "vkCmdBeginRenderPass");
+    const auto end = context.Resolved(&DeviceFunctions::cmdEndRenderPass, "vkCmdEndRenderPass");
+    const auto bind = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSet = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto viewport = context.Resolved(&DeviceFunctions::cmdSetViewport, "vkCmdSetViewport");
+    const auto scissor = context.Resolved(&DeviceFunctions::cmdSetScissor, "vkCmdSetScissor");
+    const auto draw = context.Resolved(&DeviceFunctions::cmdDraw, "vkCmdDraw");
+    const auto set = descriptor(true, source);
+    BufferBarrier(barrier, commands, source, packedBytes, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+    ImageBarrier(barrier, commands, target, before, AttachmentAccess);
+    const VkViewport viewportValue{0, 0, float(extent.width), float(extent.height), 0, 1};
+    const VkRect2D scissorValue{{0, 0}, extent};
+    for (std::uint32_t group = 0; group < target.Groups(); ++group) {
+        VkRenderPassBeginInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        pass.renderPass = renderPass;
+        pass.framebuffer = framebuffers[group];
+        pass.renderArea = scissorValue;
+        begin(commands, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        viewport(commands, 0, 1, &viewportValue);
+        scissor(commands, 0, 1, &scissorValue);
+        bindSet(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadLayout, 0, 1, &set, 0, nullptr);
+        for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+            bind(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadPipelines[sample]);
+            const std::array<std::uint32_t, 4> parameters{extent.width, extent.height, samples, group * nativeSamples + sample};
+            push(commands, uploadLayout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(parameters), parameters.data());
+            draw(commands, 3, 1, 0, 0);
+        }
+        end(commands);
+    }
+    ImageBarrier(barrier, commands, target, AttachmentAccess, after);
+}
+void ColorSampleTransfer::RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                                       ColorSampleImageAccess before, ColorSampleImageAccess after,
+                                       VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess) {
+    Require(commands != VK_NULL_HANDLE && consumerStage != 0, "color sample readback command/consumer stage is unavailable");
+    validateBuffer(outputBefore); validateImage(before, false); validateImage(after, false);
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto bind = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSet = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto dispatch = context.Resolved(&DeviceFunctions::cmdDispatch, "vkCmdDispatch");
+    const auto set = descriptor(false, outputBefore);
+    BufferBarrier(barrier, commands, outputBefore, packedBytes, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+    ImageBarrier(barrier, commands, target, before, ReadbackAccess);
+    bind(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackPipeline);
+    bindSet(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackLayout, 0, 1, &set, 0, nullptr);
+    const std::array<std::uint32_t, 4> parameters{extent.width, extent.height, samples, nativeSamples};
+    push(commands, readbackLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters), parameters.data());
+    dispatch(commands, (extent.width + 7u) / 8u, (extent.height + 7u) / 8u, 1);
