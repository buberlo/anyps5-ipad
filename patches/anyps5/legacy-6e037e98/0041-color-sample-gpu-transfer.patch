@@ -0,0 +1,15 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 8, local_size_y = 8) in;
+layout(set = 0, binding = 0) uniform texture2DMSArray colorSamples;
+layout(set = 0, binding = 1, std430) writeonly buffer Packed { uint values[]; } destination;
+layout(push_constant) uniform Parameters { uint width; uint height; uint samples; uint nativeSamples; } parameters;
+void main() {
+    uvec2 pixel = gl_GlobalInvocationID.xy;
+    if (pixel.x >= parameters.width || pixel.y >= parameters.height) return;
+    uint base = (pixel.y * parameters.width + pixel.x) * parameters.samples;
+    for (uint sampleIndex = 0; sampleIndex < parameters.samples; ++sampleIndex) {
+        vec4 color = texelFetch(colorSamples, ivec3(pixel, sampleIndex / parameters.nativeSamples), int(sampleIndex % parameters.nativeSamples));
+        destination.values[base + sampleIndex] = packUnorm4x8(color);
+    }
+}
