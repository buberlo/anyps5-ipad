+void guestWriteClassificationTests() {
+    using namespace ShaderRecompiler;
+    using namespace AgcDriver::Graphics;
+    auto context = mockContext();
+    context.limits.maxStorageBufferRange = 1u << 27;
+    const auto color = DecodeState(makeState()).color;
+    const std::array<std::uint32_t, 2> capabilities{spv::CapabilityShader, spv::CapabilityTessellation};
+    SpirvTarget target{};
+    target.vulkanVersion = VK_API_VERSION_1_1;
+    target.spirvVersion = 0x00010300u;
+    target.supportedCapabilities = capabilities;
+    target.tessellation = TessellationTargetLimits{32, 128, 128, 120, 4096, 128, 128};
+    RecompileResult vertex;
+    vertex.spirv = makeModule({});
+    RecompileResult fragment;
+    fragment.spirv = makeModule({.fragment = true});
+    const auto rectangle = BuildRectListShaders(vertex, fragment, target);
+    const std::array<CompiledShader, 4> stages{{{ShaderStage::Vertex, &vertex, 0},
+        {ShaderStage::TessellationControl, &rectangle.control, 0},
+        {ShaderStage::TessellationEvaluation, &rectangle.evaluation, 0},
+        {ShaderStage::Fragment, &fragment, 0}}};
+    Require(SplitRectListShaderRejection(stages, target).empty(), "factory rectangle was not statically qualified");
+    mock = MockVulkan{};
+    {
+        ShaderResources resources(context, stages, color, 0, 0);
+        Require(resources.NeedsCompletion() && resources.WritesMemory(), "rectangle fault diagnostics lost their completion requirement");
+        Require(!resources.HoldsLease() && !resources.HasCopiedWrites() && resources.GpuWrites().empty() && !resources.WritesGuestMemory(),
+                "a host-only rectangle fault buffer was classified as a guest write");
+        const auto descriptor = findWrite(rectangle.control.bindings.at(0).binding).buffers.at(0);
+        auto& fault = mock.memories.at(mock.bufferMemory.at(descriptor.buffer));
+        Require(std::all_of(fault.begin(), fault.end(), [](auto byte) { return byte == std::byte{}; }), "rectangle fault buffer was not cleared");
+        const BdaAbi::Fault report{BdaAbi::FaultState::Ready, BdaAbi::FaultReason::InvalidRectangle, 0, 0, 0, 0, 0};
+        std::memcpy(fault.data(), &report, sizeof(report));
+        expectFailure([&] { resources.WriteBackBuffers(); }, "rect-list requires");
+        std::memset(fault.data(), 0, fault.size());
+        resources.WriteBackBuffers();
+    }
+    Require(mock.live == 0, "host-only rectangle resources leaked Vulkan objects");
+
+    // The recompiler's per-element classification, not a descriptor's readOnly
+    // decoration flag, controls guest buffer writes. Missing entries stay written.
+    for (const auto classification : {0u, 1u, 2u}) {
+        mock = MockVulkan{};
+        RecompileResult guest;
+        auto binding = makeBinding(Role::GuestBuffers, 3, 1, vsharp(guestThird.data(), sizeof(guestThird)));
+        if (classification != 2) binding.bufferWritten = {classification == 1};
+        guest.bindings.push_back(std::move(binding));
+        const CompiledShader shader{ShaderStage::Compute, &guest, 0};
+        {
+            ShaderResources resources(context, shader);
+            const bool written = classification != 0;
+            Require(!resources.HoldsLease(), "descriptor-only resource unexpectedly holds an address-space lease");
+            Require(resources.WritesGuestMemory() == written && resources.WritesMemory() == written && resources.HasCopiedWrites() == written,
+                    "guest buffer write classification lost a real or unclassified write");
+            Require(resources.NeedsCompletion() == written && resources.GpuWrites().empty() == !written,
+                    "guest buffer completion or written ranges disagree with its classification");
+            const auto before = guestThird;
+            const auto descriptor = findWrite(3).buffers.at(0);
+            const std::uint32_t changed = before[0] ^ 0xffffffffu;
+            std::memcpy(mock.memories.at(mock.bufferMemory.at(descriptor.buffer)).data(), &changed, sizeof(changed));
+            resources.WriteBackBuffers();
+            Require(guestThird[0] == (written ? changed : before[0]), "guest buffer write-back disagrees with its classification");
+            guestThird = before;
+        }
+        Require(mock.live == 0, "classified guest buffer resources leaked Vulkan objects");
+    }
+
+    // Read-only address-based shaders still hold an unknown allocation lease.
+    // They cannot become eligible just because their BDA table has no writable ranges.
+    mock = MockVulkan{};
+    context.bufferDeviceAddress = true;
