+    const CompiledShader shader{ShaderStage::Compute, &addressBased, 0};
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Add(guestSecond.data(), sizeof(guestSecond), true, false);
+    }
+    try {
+        {
+            ShaderResources resources(context, shader);
+            Require(resources.HoldsLease() && resources.NeedsCompletion() && resources.WritesMemory() && resources.WritesGuestMemory(),
+                    "a read-only BDA allocation lease was treated as a proven guest-write-free resource");
+            Require(resources.GpuWrites().empty() && !resources.HasCopiedWrites(), "read-only BDA fixture unexpectedly declares guest writes");
+            resources.WriteBackBuffers();
+            Require(!resources.HoldsLease(), "completed read-only BDA resource retained its allocation lease");
+        }
+    } catch (...) {
+        GuestAllocations::Mutation mutation;
+        mutation.Remove(guestSecond.data());
+        throw;
+    }
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Remove(guestSecond.data());
+    }
+    Require(mock.live == 0, "read-only BDA resource classification leaked Vulkan objects");
+}
