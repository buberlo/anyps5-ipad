+bool canonicalBinding(const ShaderRecompiler::DescriptorBinding& actual,
+                      const ShaderRecompiler::DescriptorBinding& expected) {
+    const auto fields = [](const ShaderRecompiler::DescriptorBinding& binding) {
+        return std::tie(binding.kind, binding.role, binding.descriptorSet, binding.binding,
+            binding.count, binding.guestDescriptor, binding.readOnly, binding.imageShape,
+            binding.samplerDepthCompare, binding.imageWritten, binding.imageDepthCompare,
+            binding.imageAtomic, binding.imageAtomic64, binding.bufferAtomic,
+            binding.bufferWritten, binding.samplerUnnormalized, binding.imageUnnormalized,
+            binding.imageSamplers, binding.imageLogicalSamples, binding.imageNativeSamples);
+    };
+    return fields(actual) == fields(expected);
+}
+
+bool canonicalRectStage(const ShaderRecompiler::RecompileResult& actual,
+                        const ShaderRecompiler::RecompileResult& expected) {
+    // The factory emits no guest vertex inputs or fragment interpolation
+    // metadata. Reject extra metadata even if the SPIR-V itself is unchanged.
+    return actual.spirv == expected.spirv && actual.bindings.size() == expected.bindings.size() &&
+        std::equal(actual.bindings.begin(), actual.bindings.end(), expected.bindings.begin(), canonicalBinding) &&
+        actual.pushConstants == expected.pushConstants && actual.memoryOffsetDword == expected.memoryOffsetDword &&
+        actual.bdaAbiVersion == expected.bdaAbiVersion && actual.vertexAttributes.empty() && expected.vertexAttributes.empty() &&
+        actual.vertexOffsetSgpr == expected.vertexOffsetSgpr && actual.instanceOffsetSgpr == expected.instanceOffsetSgpr &&
+        actual.vertexOffsetShared == expected.vertexOffsetShared && actual.instanceOffsetShared == expected.instanceOffsetShared &&
+        actual.vertexOffsetConflict == expected.vertexOffsetConflict && actual.instanceOffsetConflict == expected.instanceOffsetConflict &&
+        actual.hostSubgroupSize == expected.hostSubgroupSize && actual.parameterExports == expected.parameterExports &&
+        actual.fragmentParameters.empty() && expected.fragmentParameters.empty() &&
+        actual.cacheHit == expected.cacheHit && actual.variantId == expected.variantId;
+}
+
+}
+
+std::string SplitRectListShaderRejection(std::span<const CompiledShader> shaders,
+                                       const ShaderRecompiler::SpirvTarget& target) {
+    using Stage = ShaderRecompiler::ShaderStage;
+    if (shaders.size() != 4 || shaders[0].stage != Stage::Vertex ||
+        shaders[1].stage != Stage::TessellationControl || shaders[2].stage != Stage::TessellationEvaluation ||
+        shaders[3].stage != Stage::Fragment) return "split rectangle draw requires ordered vertex/control/evaluation/fragment stages";
+    for (const auto& shader : shaders)
+        if (shader.program == nullptr) return "split rectangle draw is missing a compiled shader";
+    if (shaders[1].pushConstantOffset != 0 || shaders[2].pushConstantOffset != 0)
+        return "split rectangle intermediate stages have noncanonical push constant offsets";
+    const std::array original{shaders[0], shaders[3]};
+    if (const auto rejection = SplitDrawShaderRejection(original); !rejection.empty()) return rejection;
+    try {
+        const auto expected = ShaderRecompiler::BuildRectListShaders(*shaders[0].program, *shaders[3].program, target);
+        if (!canonicalRectStage(*shaders[1].program, expected.control))
+            return "split rectangle control shader is not the canonical factory result";
+        if (!canonicalRectStage(*shaders[2].program, expected.evaluation))
+            return "split rectangle evaluation shader is not the canonical factory result";
+    } catch (const std::exception& error) {
+        return std::string("split rectangle factory: ") + error.what();
+    }
+    return {};
+}
+
+}
