+std::optional<ColorResolvePass> DecodeColorResolvePass(const QueueState& queue) {
+    const auto& cx = queue.context;
+    const auto control = find(cx, 0x202);
+    if (control == cx.end() || ((control->second >> 4u) & 7u) != 3u) return std::nullopt;
+    Require(control->second == 0xcc0030u, "CB resolve requires the standard ROP and no degamma");
+    Require(read(queue.userConfig, 0x242, RegisterBank::UserConfig) == 7u,
+            "CB resolve requires rect-list geometry");
+    Require((read(cx, 0x200) & 0xfu) == 0 && (read(cx, 0x0) & 0xfu) == 0,
+            "CB resolve with depth or stencil work is unsupported");
+    Require(read(cx, 0x8e) == 0xfu && read(cx, 0x8f) == 0xfu,
+            "CB resolve requires all four MRT0 components and no other shader outputs");
+    zero(cx, 0x292, ~3u, "CB resolve raster flags");
+    const auto source = DecodeColorBuffer(cx, 0);
+    const auto destination = DecodeColorBuffer(cx, 1);
+    const auto samples = DecodeSampleConfiguration(cx, true);
+    Require(samples.count == source.samples, "CB resolve raster/storage coverage sample counts disagree");
+    // Truncating destination conversion is distinct from the normal UNORM
+    // attachment conversion. Do not silently turn it into round-by-half.
+    Require((read(cx, 0x32b) & 0x40000u) == 0,
+            "CB resolve truncating destination rounding is unsupported");
+    ColorResolvePass pass{source, destination};
+    ValidateColorResolve(pass);
+    return pass;
+}
+
+QueueState ColorResolveRasterQueue(const QueueState& queue, const ColorResolvePass& pass) {
+    ValidateColorResolve(pass);
+    auto raster = queue;
+    // The source is a read-only image, not a raster attachment. Copy the
+    // complete destination slot (including view and extended address).
+    for (std::uint32_t i = 0; i < 15u; ++i) {
+        const auto word = find(queue.context, 0x327 + i);
+        // DecodeColorResolvePass already checked every required field. Pitch,
+        // metadata and clear words may be absent for uncompressed GC10 views;
+        // erase the previous source's optional value rather than retain it.
+        if (word == queue.context.end()) raster.context.erase(0x318 + i);
+        else raster.context[0x318 + i] = word->second;
+    }
+    raster.context[0x390] = read(queue.context, 0x391);
+    const auto dccHigh = find(queue.context, 0x3a9);
+    if (dccHigh == queue.context.end()) raster.context.erase(0x3a8);
+    else raster.context[0x3a8] = dccHigh->second;
+    raster.context[0x3b0] = read(queue.context, 0x3b1);
+    raster.context[0x3b8] = read(queue.context, 0x3b9);
+    raster.context[0x202] = 0xcc0010u;
+    raster.context[0x2f8] = 0;
+    raster.context[0x201] = 0;
+    raster.context[0x292] &= 2u;
+    raster.context[0x1e0] = 0; // CB fixed-function resolve bypasses normal blending.
+    return raster;
+}
