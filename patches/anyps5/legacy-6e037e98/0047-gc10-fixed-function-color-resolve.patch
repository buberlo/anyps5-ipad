diff --git a/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp
new file mode 100644
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp
@@ -0,0 +1,104 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorResolve.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/ColorTargetTransfer.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/SplitDrawShaderValidation.hpp"
+#include "prx/libSceAgcDriver/Execution/include/GuestMemory.hpp"
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <new>
+
+namespace AgcDriver::Graphics {
+
+void ValidateColorResolve(const ColorResolvePass& pass) {
+    const auto& source = pass.source;
+    const auto& destination = pass.destination;
+    Require(source.format == VK_FORMAT_R8G8B8A8_UNORM && destination.format == source.format &&
+            source.elementBytes == 4u && destination.elementBytes == 4u &&
+            source.componentMapping == destination.componentMapping,
+            "CB resolve supports matching RGBA8_UNORM formats only");
+    Require((source.samples == 2u || source.samples == 4u || source.samples == 8u) &&
+            source.fragments == source.samples, "CB resolve source requires 2/4/8 equal samples and fragments; EQAA is unsupported");
+    Require(destination.samples == 1u && destination.fragments == 1u,
+            "CB resolve destination must be single-sampled");
+    Require(source.extent.width != 0 && source.extent.height != 0 &&
+            source.extent.width == destination.extent.width && source.extent.height == destination.extent.height,
+            "CB resolve source and destination dimensions disagree");
+    Require(source.tileMode == ColorTileMode::RenderTarget && destination.tileMode == source.tileMode,
+            "CB resolve requires matching R64KB_X source and destination tiling");
+    Require(source.depth == 1u && destination.depth == 1u && source.depthSlice == 0u && destination.depthSlice == 0u &&
+            source.mip == 0u && destination.mip == 0u && source.mipCount == 1u && destination.mipCount == 1u,
+            "CB resolve mipmapped, array or volume views are unsupported");
+    Require(source.dccAddress == 0 && destination.dccAddress == 0 && source.cmaskAddress == 0 && destination.cmaskAddress == 0,
+            "CB resolve compressed or fast-cleared color targets are unsupported");
+    for (const auto* color : {&source, &destination}) {
+        const ColorTargetLayout layout(color->extent.width, color->extent.height, color->tileMode, 4u, color->samples);
+        Require(color->bytes == layout.Bytes(), "CB resolve color allocation size disagrees with its layout");
+        Require(color->address != 0 && color->address % layout.Alignment() == 0 &&
+                color->bytes <= std::numeric_limits<std::uint64_t>::max() - color->address,
+                "CB resolve invalid or overflowing guest range");
+    }
+}
+
+
+void ColorResolveReference(const ColorResolvePass& pass,
+    std::span<const std::byte> source, std::span<std::byte> destination) {
+    ValidateColorResolve(pass);
+    const auto samples = pass.source.samples;
+    const auto bytes = static_cast<std::size_t>(pass.source.extent.width) * pass.source.extent.height * 4u;
+    Require(destination.size() == bytes && source.size() == bytes * samples, "CB resolve reference buffer size mismatch");
+    // Original scalar oracle: round-by-half after the complete logical-sample
+    // mean. Native floating-point UNORM conversion may differ by one at ties.
+    for (std::size_t pixel = 0; pixel < bytes / 4u; ++pixel) {
+        for (unsigned channel = 0; channel < 4u; ++channel) {
+            unsigned sum = 0;
+            for (unsigned sample = 0; sample < samples; ++sample)
+                sum += std::to_integer<unsigned>(source[(pixel * samples + sample) * 4u + channel]);
+            destination[pixel * 4u + channel] = static_cast<std::byte>((sum + samples / 2u) / samples);
+        }
+    }
+}
+
+void RunColorResolve(const Context& context, const ColorResolvePass& pass,
+    const State& raster, const Pm4::DrawParameters& draw,
+    const ShaderRecompiler::RecompileResult& vertex,
+    std::span<const GuestMemorySnapshot> snapshots,
+    const ShaderRecompiler::SpirvTarget& target) {
+    ValidateColorResolve(pass);
+    Require(raster.rectList && raster.samples.count == 1u && raster.colors.size() == 1u &&
+            raster.color.address == pass.destination.address && !raster.depthTest && !raster.depthWrite && !raster.stencilTest,
+            "CB resolve requires its checked single-sample rectangle state");
+    Require(!draw.indirect && !draw.indexed && draw.indexCount == 3u && draw.instanceCount == 1u,
+            "CB resolve requires one direct three-vertex rectangle");
+    // Read through the production flush hook before the destination can change:
+    // pending GPU writes land first, including when source and destination alias.
+    const ColorTargetLayout layout(pass.source.extent.width, pass.source.extent.height,
+                                   pass.source.tileMode, 4u, pass.source.samples);
+    std::vector<std::byte> linear(layout.LinearBytes());
+    ReadColorTarget(pass.source, linear);
+    const auto alignment = std::align_val_t(65536);
+    auto snapshot = std::shared_ptr<std::byte>(static_cast<std::byte*>(::operator new(pass.source.bytes, alignment)),
+        [alignment](std::byte* memory) { ::operator delete(memory, alignment); });
+    std::memset(snapshot.get(), 0, pass.source.bytes);
+    auto immutable = pass.source;
+    immutable.address = immutable.surfaceAddress = reinterpret_cast<std::uintptr_t>(snapshot.get());
+    WriteColorTarget(immutable, linear);
+    auto fragment = BuildColorResolveFragment(immutable, vertex);
+    auto rectangle = ShaderRecompiler::BuildRectListShaders(vertex, fragment, target);
+    using Stage = ShaderRecompiler::ShaderStage;
+    const std::array<CompiledShader, 4> shaders{{
+        {Stage::Vertex, &vertex, 0}, {Stage::TessellationControl, &rectangle.control, 0},
+        {Stage::TessellationEvaluation, &rectangle.evaluation, 0}, {Stage::Fragment, &fragment, 0}
+    }};
+    const auto reason = SplitRectListShaderRejection(shaders, target);
+    Require(reason.empty(), reason);
+    // Single destination attachment: normal draw validation, load/store,
+    // retained descriptors, barriers, fault-buffer completion and alias stamps
+    // still apply. This executes actual geometry, including partial rectangles.
+    Draw(context, raster, draw, shaders, snapshots, nullptr, &target);
+    // Retain the guest-address backing at least through every recorded upload
+    // and read. A synchronous draw already finished; a later batch keeps it
+    // until all earlier work on this queue has completed.
+    if (context.recorder != nullptr) context.recorder->Keep(snapshot, pass.source.bytes);
+}
+
+}
