+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+// Each embedded original program has one exact logical count (2/4/8).
+#ifndef APS5_RESOLVE_SAMPLES
+#define APS5_RESOLVE_SAMPLES 8
+#endif
+const int logicalSamples = APS5_RESOLVE_SAMPLES;
+layout(set = 0, binding = 0) uniform texture2DMSArray sourceSamples;
+layout(location = 0) out vec4 color;
+void main() {
+    ivec2 pixel = ivec2(gl_FragCoord.xy);
+    int nativeSamples = min(logicalSamples, 4);
+    vec4 sum = vec4(0.0);
+    for (int sampleIndex = 0; sampleIndex < logicalSamples; ++sampleIndex) {
+        sum += texelFetch(sourceSamples,
+            ivec3(pixel, sampleIndex / nativeSamples), sampleIndex % nativeSamples);
+    }
+    color = sum / float(logicalSamples);
+}
