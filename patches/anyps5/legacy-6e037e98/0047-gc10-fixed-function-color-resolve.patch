+namespace AgcDriver::Graphics {
+
+ShaderRecompiler::RecompileResult BuildColorResolveFragment(
+    const ColorTarget& source, const ShaderRecompiler::RecompileResult& vertex) {
+    // DecodeTextureResource's GC10 T# uses a 14-bit width and height and a
+    // 48-bit address. NUM_FRAGMENTS is duplicated in LAST_LEVEL and word5.
+    Require(source.format == VK_FORMAT_R8G8B8A8_UNORM && source.elementBytes == 4u &&
+            source.fragments == source.samples && (source.samples == 2u || source.samples == 4u || source.samples == 8u),
+            "CB resolve fragment source must be 2/4/8-sample RGBA8_UNORM");
+    Require(source.tileMode == ColorTileMode::RenderTarget && source.extent.width > 0 && source.extent.width <= 16384u &&
+            source.extent.height > 0 && source.extent.height <= 16384u && source.address != 0 && source.address < (1ull << 48u) &&
+            source.address % 65536u == 0, "CB resolve source cannot be represented by the GC10 image descriptor");
+    std::uint32_t bindingIndex = 0;
+    for (const auto& binding : vertex.bindings) {
+        Require(binding.binding < std::numeric_limits<std::uint32_t>::max(), "CB resolve descriptor binding overflow");
+        bindingIndex = std::max(bindingIndex, binding.binding + 1u);
+    }
+    const std::span<const std::uint32_t> words = source.samples == 2u ? std::span<const std::uint32_t>(COLOR_RESOLVE_2_SPV) :
+        source.samples == 4u ? std::span<const std::uint32_t>(COLOR_RESOLVE_4_SPV) : std::span<const std::uint32_t>(COLOR_RESOLVE_8_SPV);
+    ShaderRecompiler::RecompileResult fragment{};
+    std::vector<std::uint32_t> code(words.begin(), words.end());
+    unsigned patched = 0;
+    for (std::size_t at = 5; at < code.size();) {
+        const auto count = code[at] >> 16u;
+        Require(count > 0 && count <= code.size() - at, "CB resolve embedded SPIR-V is malformed");
