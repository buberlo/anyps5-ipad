+int APS5_VABI sceAudio3dObjectSetAttributes(uint32_t port_id, uint32_t object_id,
+                                           uint64_t num_attributes, const Audio3dAttribute* attributes) {
+    static_assert(sizeof(Audio3dAttribute) == 0x18 && offsetof(Audio3dAttribute, value) == 8 &&
+                  offsetof(Audio3dAttribute, value_size) == 0x10);
+    static_assert(sizeof(Audio3dPcm) == 0x18 && offsetof(Audio3dPcm, sample_buffer) == 8 &&
+                  offsetof(Audio3dPcm, num_samples) == 0x10);
+    std::lock_guard lock(g_mutex);
+    if (!PortIsOpen(port_id)) return AUDIO3D_ERROR_INVALID_PORT;
+    if (!g_port.objects.contains(object_id)) return AUDIO3D_ERROR_INVALID_OBJECT;
+    if (num_attributes == 0 || num_attributes > std::numeric_limits<std::uint64_t>::max() / sizeof(Audio3dAttribute) ||
+        !AddressRangeFits(attributes, num_attributes * sizeof(Audio3dAttribute))) return AUDIO3D_ERROR_INVALID_PARAMETER;
+
+    bool needs_renderer = false;
+    for (std::uint64_t i = 0; i < num_attributes; ++i) {
+        Audio3dAttribute attribute;
+        std::memcpy(&attribute, reinterpret_cast<const unsigned char*>(attributes) + i * sizeof(attribute), sizeof(attribute));
+        if (attribute.attribute_id == AUDIO3D_ATTRIBUTE_RESET_STATE) {
+            // RESET_STATE consumes no payload, including when its ignored fields are nonzero.
+            continue;
+        }
+        if (attribute.value_size == 0 || !AddressRangeFits(attribute.value, attribute.value_size)) {
+            return AUDIO3D_ERROR_INVALID_PARAMETER;
+        }
+        if (attribute.attribute_id == AUDIO3D_ATTRIBUTE_PCM) {
+            if (attribute.value_size < sizeof(Audio3dPcm)) return AUDIO3D_ERROR_INVALID_PARAMETER;
+            Audio3dPcm pcm;
+            std::memcpy(&pcm, attribute.value, sizeof(pcm));
+            if (pcm.format > 1 || pcm.num_samples == 0 ||
+                !AddressRangeFits(pcm.sample_buffer, std::uint64_t{pcm.num_samples} * (pcm.format == 0 ? 2 : 4))) {
+                return AUDIO3D_ERROR_INVALID_PARAMETER;
+            }
+            if ((reinterpret_cast<std::uintptr_t>(pcm.sample_buffer) & (pcm.format == 0 ? 1 : 3)) != 0) {
+                return AUDIO3D_ERROR_INVALID_PARAMETER;
+            }
+        } else if (attribute.attribute_id == AUDIO3D_ATTRIBUTE_GAIN && attribute.value_size < sizeof(float)) {
+            return AUDIO3D_ERROR_INVALID_PARAMETER;
+        }
+        // Do not consume PCM or accept render parameters until object mixing exists.
+        needs_renderer = true;
+    }
+    if (needs_renderer) return AUDIO3D_ERROR_NOT_SUPPORTED;
+    // Only RESET_STATE remains. Reserved objects have no accepted PCM or persistent render
+    // attributes, so their audio state is already empty; their reservation must survive reset.
+    return 0;
+}
