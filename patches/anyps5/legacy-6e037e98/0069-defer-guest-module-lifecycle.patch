diff --git a/core/relinker/elfpatcher/src/windows/WindowsGuestLifecycleBuilder.cpp b/core/relinker/elfpatcher/src/windows/WindowsGuestLifecycleBuilder.cpp
new file mode 100644
--- /dev/null
+++ b/core/relinker/elfpatcher/src/windows/WindowsGuestLifecycleBuilder.cpp
@@ -0,0 +1,119 @@
+#include <elfpatcher/windows/WindowsGuestLifecycleBuilder.hpp>
+#include <elfpatcher/windows/WindowsStubEmitter.hpp>
+
+namespace Elfpatcher::Windows {
+
+void BuildGuestLifecycle(Domain::GuestRuntime& runtime, std::vector<PeSection>& sections, std::uint32_t& nextRva) {
+    constexpr std::uint64_t HostPage = 0x4000;
+    const auto alignHostPage = [](const std::uint64_t value) {
+        return CheckedRva((static_cast<std::uint64_t>(CheckedRva(value)) + HostPage - 1) & ~(HostPage - 1));
+    };
+    // 0=unstarted, 1=starting, 2=started, 3=stopping, 4=stopped,
+    // 5=failed start, 6=failed stop. Finalization cannot be rolled back: failed
+    // stop is terminal, retains the image and original error, and never retries
+    // callbacks that may already have destroyed guest state.
+    // iPad protects 16 KiB host pages. Keep mutable state, executable wrappers,
+    // and following read-only PE metadata on distinct complete host pages.
+    const auto alignedState = alignHostPage(nextRva);
+    if (alignedState != nextRva) {
+        // Preserve the writer's contiguous section invariant and the previous
+        // section's protection while completing its last host page.
+        sections.push_back({".glpad", nextRva, sections.back().Characteristics,
+            std::vector<std::uint8_t>(alignedState - nextRva)});
+    }
+    nextRva = alignedState;
+    const auto state = nextRva;
+    sections.push_back({".gstate", nextRva, SectionRead | SectionWrite | 0x40u, std::vector<std::uint8_t>(HostPage)});
+    nextRva = alignHostPage(nextRva + HostPage);
+    WindowsStubEmitter code(nextRva);
+    const auto finish = [&] { code.Emit({0x41, 0x5d, 0x41, 0x5c, 0x5b, 0xc3}); };
+    const auto publish = [&](const std::uint32_t value) {
+        code.Emit({0xb9}); code.U32(value);
+        code.Rip({0x89, 0x0d}, state);
+    };
+    const auto arrayCall = [&](const std::uint32_t slot) {
+        code.Rip({0x48, 0x8b, 0x05}, slot);
+        code.Emit({0x48, 0x85, 0xc0});
+        const auto skip = code.Branch({0x0f, 0x84});
+        code.Emit({0x31, 0xff, 0x31, 0xf6, 0x31, 0xd2, 0xff, 0xd0});
+        code.PatchBranch(skip, code.GetRva());
+    };
+    const auto lifecycleCall = [&](const std::uint32_t rva) {
+        if (rva == 0) { code.Emit({0x31, 0xdb}); return; }
+        code.Emit({0x4c, 0x89, 0xe7, 0x4c, 0x89, 0xee, 0x31, 0xd2});
+        code.Rip({0xe8}, rva);
+        // Only explicit deferred Sony modules opt into the int-return module
+        // start/stop contract. Keep the previous eager ELF lifecycle policy,
+        // whose DT_INIT/DT_FINI functions may have a void return type.
+        if (runtime.DeferredLifecycle) code.Emit({0x89, 0xc3});
+        else code.Emit({0x31, 0xdb});
+    };
+    const auto emit = [&](const bool starting) {
+        const auto entry = code.GetRva();
+        // Three saved registers keep the SysV call stack aligned to 16 bytes.
+        code.Emit({0x53, 0x41, 0x54, 0x41, 0x55, 0x49, 0x89, 0xfc, 0x49, 0x89, 0xf5, 0xb8});
+        code.U32(starting ? 0 : 2);
+        code.Emit({0xb9}); code.U32(starting ? 1 : 3);
+        code.Rip({0xf0, 0x0f, 0xb1, 0x0d}, state);
+        const auto notOwned = code.Branch({0x0f, 0x85});
+        if (starting) {
+            lifecycleCall(runtime.InitRva);
+            code.Emit({0x85, 0xdb});
+            const auto failed = code.Branch({0x0f, 0x85});
+            for (const auto slot : runtime.InitArrayRvas) arrayCall(slot);
+            publish(2);
+            code.Emit({0x31, 0xc0}); finish();
+            code.PatchBranch(failed, code.GetRva());
+            code.Rip({0x89, 0x1d}, state + 4);
+            publish(5);
+            code.Emit({0x89, 0xd8}); finish();
+        } else {
+            for (auto slot = runtime.FiniArrayRvas.rbegin(); slot != runtime.FiniArrayRvas.rend(); ++slot) arrayCall(*slot);
+            lifecycleCall(runtime.FiniRva);
+            code.Rip({0x89, 0x1d}, state + 8);
+            code.Emit({0x85, 0xdb});
+            const auto failed = code.Branch({0x0f, 0x85});
+            publish(4);
+            code.Emit({0x89, 0xd8}); finish();
+            code.PatchBranch(failed, code.GetRva());
+            publish(6);
+            code.Emit({0x89, 0xd8}); finish();
+        }
+        code.PatchBranch(notOwned, code.GetRva());
+        std::vector<std::size_t> zeroBranches;
+        std::vector<std::size_t> storedBranches;
+        for (const auto value : (starting ? std::vector<unsigned>{2} : std::vector<unsigned>{0, 5})) {
+            code.Emit({0x83, 0xf8, static_cast<std::uint8_t>(value)});
+            zeroBranches.push_back(code.Branch({0x0f, 0x84}));
+        }
+        code.Emit({0x83, 0xf8, static_cast<std::uint8_t>(starting ? 5 : 4)});
+        storedBranches.push_back(code.Branch({0x0f, 0x84}));
+        if (!starting) {
+            code.Emit({0x83, 0xf8, 6});
+            storedBranches.push_back(code.Branch({0x0f, 0x84}));
+        }
+        if (starting) {
+            code.Emit({0x83, 0xf8, 6});
+            const auto failedStop = code.Branch({0x0f, 0x84});
+            code.Emit({0x83, 0xf8, 4});
+            const auto active = code.Branch({0x0f, 0x85});
+            code.PatchBranch(failedStop, code.GetRva());
+            code.Emit({0x48, 0xb8}); code.U64(std::uint64_t{0x80020016u} << 32); finish(); // Wrapper EINVAL: completed lifecycle cannot restart.
+            code.PatchBranch(active, code.GetRva());
+        }
+        code.Emit({0x48, 0xb8}); code.U64(std::uint64_t{0x80020010u} << 32); finish(); // Wrapper EBUSY: never wait recursively.
+        for (const auto branch : zeroBranches) code.PatchBranch(branch, code.GetRva());
+        code.Emit({0x31, 0xc0}); finish();
+        for (const auto branch : storedBranches) code.PatchBranch(branch, code.GetRva());
+        code.Rip({0x8b, 0x05}, state + (starting ? 4 : 8)); finish();
+        return entry;
+    };
+    runtime.StartRva = emit(true);
+    runtime.StopRva = emit(false);
+    auto bytes = code.TakeBytes();
+    bytes.resize(alignHostPage(bytes.size()));
+    sections.push_back({".glife", nextRva, SectionRead | SectionExecute | 0x20u, std::move(bytes)});
+    nextRva = alignHostPage(nextRva + sections.back().Data.size());
+}
+
+}
