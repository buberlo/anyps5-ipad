+#ifndef ELFPATCHER_WINDOWSGUESTLIFECYCLEBUILDER_HPP
+#define ELFPATCHER_WINDOWSGUESTLIFECYCLEBUILDER_HPP
+
+#include <domain/GuestRuntime.hpp>
+#include <elfpatcher/windows/WindowsPeFormat.hpp>
+
+namespace Elfpatcher::Windows {
+
+inline constexpr char GuestStartExport[] = "__anyps5_guest_start_v1";
+inline constexpr char GuestStopExport[] = "__anyps5_guest_stop_v1";
+
+// Both exports use the guest SysV ABI: uint64_t(size_t args, const void* argp).
+// High 32 bits are wrapper status, low 32 bits the exact module callback result.
+// This separates guard EBUSY from a module that itself returns that same value.
+// State is shared by all loader references to this image.
+void BuildGuestLifecycle(Domain::GuestRuntime& runtime, std::vector<PeSection>& sections, std::uint32_t& nextRva);
+
+}
+#endif
