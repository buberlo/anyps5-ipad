+#include "GuestKernelModuleLifecycleFixture.hpp"
+#include "SceTypes.hpp"
+#include "prx/libkernel/KernelErrors.hpp"
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <future>
+#include <limits>
+#include <thread>
+extern "C" {
+void* APS5_VABI dlopen_nid_postfix(const char*, int);
+void* APS5_VABI dlsym_nid_postfix(void*, const char*);
+int APS5_VABI dlclose_nid_postfix(void*);
+KernelModule APS5_VABI sceKernelLoadStartModule(const char*, std::size_t, const void*, std::uint32_t, const KernelLoadModuleOpt*, int*);
+int APS5_VABI sceKernelStopUnloadModule(KernelModule, std::size_t, const void*, std::uint32_t, const KernelUnloadModuleOpt*, int*);
+}
+static void Check(bool value, int line) {
+    if (!value) { std::fprintf(stderr, "kernel lifecycle contract failed at line %d\n", line); std::abort(); }
+}
+#define Require(value) Check((value), __LINE__)
+using namespace std::chrono_literals;
+struct Observation {
+    std::atomic<int> starts{0};
+    std::atomic<int> stops{0};
+    std::size_t expectedArgs = 0;
+    const void* expectedArgp = nullptr;
+    const char* reentryPath = nullptr;
+    std::int32_t startResult = 0;
+    std::int32_t stopResult = 0;
+    std::int32_t startStatus = 0;
+    std::int32_t stopStatus = 0;
+    bool blockStop = false;
+    std::promise<void> entered;
+    std::promise<void> release;
+    std::shared_future<void> released = release.get_future().share();
+};
+static std::uint64_t Packed(std::int32_t status, std::int32_t result) {
+    return (static_cast<std::uint64_t>(static_cast<std::uint32_t>(status)) << 32) |
+        static_cast<std::uint32_t>(result);
+}
+static std::uint64_t APS5_VABI Observe(void* opaque, bool stop, std::size_t args, const void* argp) {
+    auto& observation = *static_cast<Observation*>(opaque);
+    Require(args == observation.expectedArgs && argp == observation.expectedArgp);
+    if (stop) {
+        ++observation.stops;
+        if (observation.blockStop) {
+            observation.entered.set_value();
+            Require(observation.released.wait_for(5s) == std::future_status::ready);
+        }
+        return Packed(observation.stopStatus, observation.stopResult);
+    }
+    ++observation.starts;
+    if (observation.reentryPath) {
+        void* nested = dlopen_nid_postfix(observation.reentryPath, 2);
+        Require(nested != nullptr);
+        Require(dlsym_nid_postfix(nested, "GuestLifecycleNativeMarker") != nullptr);
+        Require(dlclose_nid_postfix(nested) == 0);
+    }
+    return Packed(observation.startStatus, observation.startResult);
+}
+static void* Handle(KernelModule module) { return reinterpret_cast<void*>(static_cast<std::intptr_t>(module)); }
+int main(int argc, char** argv) {
+    Require(argc == 4);
+    // A callback reentering all three loader APIs must complete without a registry-lock deadlock.
+    Observation observation;
+    KernelModuleLifecyclePayload payload{Observe, &observation, nullptr};
+    observation.expectedArgs = sizeof(payload);
+    observation.expectedArgp = &payload;
+    observation.reentryPath = argv[3];
+    int result = -1;
+    auto loading = std::async(std::launch::async, [&] {
+        return sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    });
+    Require(loading.wait_for(5s) == std::future_status::ready);
+    KernelModule module = loading.get();
+    Require(module > 0 && result == 0 && observation.starts == 1);
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 0);
+    Require(result == 0 && observation.stops == 1);
+    Require(sceKernelStopUnloadModule(module, 0, nullptr, 0, nullptr, &result) == SCE_KERNEL_ERROR_ESRCH);
+
+    // Module return values are distinct from the loader's handle/status, including positive returns.
+    observation.reentryPath = nullptr;
+    observation.startResult = 17;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == 17 && observation.starts == 2);
+    observation.stopResult = 23;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 23);
+    Require(result == 23 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopResult = -91;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == -91);
+    Require(result == -91 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    // The synthetic fixture has no once guard; the relinker suite tests the real generated guards.
+    Require(dlclose_nid_postfix(Handle(module)) == 0);
+    observation.startResult = -31;
+    observation.stopResult = 0;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == -31);
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, nullptr) == 0);
+
+    // A module's negative SCE value is never heuristically classified as a guard status.
+    observation.startResult = SCE_KERNEL_ERROR_EBUSY;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == SCE_KERNEL_ERROR_EBUSY);
+    observation.stopResult = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY);
+    Require(result == SCE_KERNEL_ERROR_EBUSY && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopResult = 0;
+    observation.stopStatus = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY);
+    Require(result == 0 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopStatus = 0;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 0);
+    observation.startResult = 0;
+    static std::atomic<int> busyImageUnloads{0};
+    payload.imageUnloads = &busyImageUnloads;
+    observation.startStatus = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY && result == 0);
+#ifdef _WIN32
+    Require(busyImageUnloads == 1); // Failed LoadStart releases its newly loaded reference.
+#endif
+    observation.startStatus = SCE_KERNEL_ERROR_EINVAL;
+    Require(sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EINVAL && result == 0);
+#ifdef _WIN32
+    Require(busyImageUnloads == 2);
+#endif
+    observation.startStatus = 0;
+    payload.imageUnloads = nullptr;
+
+    // Invalid requests are rejected before any guest callback or image load.
+    const int starts = observation.starts;
+    const int stops = observation.stops;
+    KernelLoadModuleOpt loadOpt{sizeof(loadOpt)};
+    KernelUnloadModuleOpt stopOpt{sizeof(stopOpt)};
+    Require(sceKernelLoadStartModule(nullptr, 0, nullptr, 0, nullptr, &result) == SCE_KERNEL_ERROR_EFAULT && result == 0);
+    Require(sceKernelLoadStartModule("", 0, nullptr, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_EINVAL);
+    Require(sceKernelLoadStartModule(argv[1], 1, nullptr, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_EFAULT);
+    Require(sceKernelLoadStartModule(argv[1], 2, reinterpret_cast<const void*>(std::numeric_limits<std::uintptr_t>::max()), 0, nullptr, nullptr) == SCE_KERNEL_ERROR_EFAULT);
+    Require(sceKernelLoadStartModule(argv[1], 0, nullptr, 1, nullptr, nullptr) == SCE_KERNEL_ERROR_EINVAL);
+    Require(sceKernelLoadStartModule(argv[1], 0, nullptr, 0, &loadOpt, nullptr) == SCE_KERNEL_ERROR_EOPNOTSUPP);
+    Require(sceKernelLoadStartModule("anyps5-missing-kernel-module.prx", 0, nullptr, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_ENOENT);
+    Require(sceKernelLoadStartModule(argv[2], sizeof(payload), &payload, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_ENOEXEC);
+    Require(sceKernelStopUnloadModule(-1, 0, nullptr, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_ESRCH);
+    Require(sceKernelStopUnloadModule(0, 1, nullptr, 0, nullptr, nullptr) == SCE_KERNEL_ERROR_EFAULT);
+    Require(sceKernelStopUnloadModule(0, 0, nullptr, 1, nullptr, nullptr) == SCE_KERNEL_ERROR_EINVAL);
+    Require(sceKernelStopUnloadModule(0, 0, nullptr, 0, &stopOpt, nullptr) == SCE_KERNEL_ERROR_EOPNOTSUPP);
+    Require(observation.starts == starts && observation.stops == stops);
+
+    // A native/HLE module may depend on a guest image: only its own raw wrappers count.
+    module = sceKernelLoadStartModule(argv[3], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == 0 && observation.starts == starts);
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 0);
+    Require(result == 0 && observation.stops == stops);
+
+    // Hold a guest stop callback across removal of its last registry handle.
+    // A copied function pointer without a shared module owner would execute unmapped code on return.
+    Observation pinned;
+    static std::atomic<int> imageUnloads{0};
+    KernelModuleLifecyclePayload pinnedPayload{Observe, &pinned, &imageUnloads};
+    pinned.expectedArgs = sizeof(pinnedPayload);
+    pinned.expectedArgp = &pinnedPayload;
+    pinned.blockStop = true;
+    module = sceKernelLoadStartModule(argv[1], sizeof(pinnedPayload), &pinnedPayload, 0, nullptr, &result);
+    Require(module > 0 && result == 0);
+    auto entered = pinned.entered.get_future();
+    auto stopping = std::async(std::launch::async, [&] {
+        return sceKernelStopUnloadModule(module, sizeof(pinnedPayload), &pinnedPayload, 0, nullptr, &result);
+    });
+    Require(entered.wait_for(5s) == std::future_status::ready);
+    Require(stopping.wait_for(0s) == std::future_status::timeout);
+    Require(dlclose_nid_postfix(Handle(module)) == 0);
+    // This also observes pin lifetime without relying on a stale code pointer fault.
+    Require(imageUnloads == 0);
+    pinned.release.set_value();
+    Require(stopping.wait_for(5s) == std::future_status::ready);
+    Require(stopping.get() == SCE_KERNEL_ERROR_ESRCH && result == 0 && pinned.stops == 1);
+#ifdef _WIN32
+    // The product host unloads the fixture at its last native reference. macOS may retain dylibs.
+    Require(imageUnloads == 1);
+#endif
+}
