 // arrays of its own and merges them into the shared totals every 1000 of its builds (and when it
 // ends), so no build takes the shared mutex per phase; the totals lag by up to 999 builds per
 // worker.
+std::uint32_t SetDescriptorLimit(const Context& context, VkDescriptorType type, bool updateAfterBind) {
+    if (updateAfterBind) Require(context.storageBufferUpdateAfterBind, "storage buffer update-after-bind is unavailable");
+    switch (type) {
+    case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER:
+        return updateAfterBind ? context.descriptorIndexingLimits.maxDescriptorSetUpdateAfterBindStorageBuffers : context.limits.maxDescriptorSetStorageBuffers;
+    case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE: return updateAfterBind ? std::min(context.limits.maxDescriptorSetSampledImages, context.descriptorIndexingLimits.maxDescriptorSetUpdateAfterBindSampledImages) : context.limits.maxDescriptorSetSampledImages;
+    case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE: return updateAfterBind ? std::min(context.limits.maxDescriptorSetStorageImages, context.descriptorIndexingLimits.maxDescriptorSetUpdateAfterBindStorageImages) : context.limits.maxDescriptorSetStorageImages;
+    case VK_DESCRIPTOR_TYPE_SAMPLER: return updateAfterBind ? std::min(context.limits.maxDescriptorSetSamplers, context.descriptorIndexingLimits.maxDescriptorSetUpdateAfterBindSamplers) : context.limits.maxDescriptorSetSamplers;
+    default: Require(false, "unsupported descriptor pool type"); return 0;
+    }
+}
+
+void ValidateDescriptorLayout(const Context& context, std::span<const VkDescriptorSetLayoutBinding> bindings, bool updateAfterBind) {
+    if (updateAfterBind) Require(context.storageBufferUpdateAfterBind, "storage buffer update-after-bind is unavailable");
+    const auto maxResources = updateAfterBind ? context.descriptorIndexingLimits.maxPerStageUpdateAfterBindResources : context.limits.maxPerStageResources;
+    const auto maxBuffers = updateAfterBind ? context.descriptorIndexingLimits.maxPerStageDescriptorUpdateAfterBindStorageBuffers : context.limits.maxPerStageDescriptorStorageBuffers;
+    std::map<VkDescriptorType, std::uint64_t> totals;
+    std::map<std::pair<VkShaderStageFlags, VkDescriptorType>, std::uint64_t> stageTotals;
+    std::map<VkShaderStageFlags, std::uint64_t> resources;
+    for (const auto& binding : bindings) {
+        Require(binding.descriptorCount != 0, "empty descriptor binding");
+        const auto total = totals[binding.descriptorType] += binding.descriptorCount;
+        Require(total <= SetDescriptorLimit(context, binding.descriptorType, updateAfterBind), "descriptor set exceeds the device's per-set descriptor limit");
+        for (unsigned bit = 0; bit < 32; ++bit) {
+            const VkShaderStageFlags stage = VkShaderStageFlags(1u) << bit;
+            if ((binding.stageFlags & stage) == 0) continue;
+            const auto count = stageTotals[{stage, binding.descriptorType}] += binding.descriptorCount;
+            const auto all = resources[stage] += binding.descriptorType == VK_DESCRIPTOR_TYPE_SAMPLER ? 0u : binding.descriptorCount;
+            Require(all <= maxResources, "shader descriptors exceed per-stage resource limits");
+            switch (binding.descriptorType) {
+            case VK_DESCRIPTOR_TYPE_STORAGE_BUFFER: Require(count <= maxBuffers, "shader descriptors exceed per-stage limits"); break;
+            case VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE: Require(count <= context.limits.maxPerStageDescriptorSampledImages && (!updateAfterBind || count <= context.descriptorIndexingLimits.maxPerStageDescriptorUpdateAfterBindSampledImages), "shader sampled-image descriptors exceed per-stage limits"); break;
+            case VK_DESCRIPTOR_TYPE_STORAGE_IMAGE: Require(count <= context.limits.maxPerStageDescriptorStorageImages && (!updateAfterBind || count <= context.descriptorIndexingLimits.maxPerStageDescriptorUpdateAfterBindStorageImages), "shader storage-image descriptors exceed per-stage limits"); break;
+            case VK_DESCRIPTOR_TYPE_SAMPLER: Require(count <= context.limits.maxPerStageDescriptorSamplers && (!updateAfterBind || count <= context.descriptorIndexingLimits.maxPerStageDescriptorUpdateAfterBindSamplers), "shader sampler descriptors exceed per-stage limits"); break;
+            default: Require(false, "unsupported descriptor layout type");
+            }
+        }
+    }
+}
+
+VkDescriptorSetLayout CreateSetLayout(const Context& context, std::span<const VkDescriptorSetLayoutBinding> bindings, bool updateAfterBind) {
+    ValidateDescriptorLayout(context, bindings, updateAfterBind);
+    std::vector<VkDescriptorBindingFlags> flags;
+    for (const auto& binding : bindings) flags.push_back(updateAfterBind && binding.descriptorType == VK_DESCRIPTOR_TYPE_STORAGE_BUFFER ? VK_DESCRIPTOR_BINDING_UPDATE_AFTER_BIND_BIT : 0);
+    VkDescriptorSetLayoutBindingFlagsCreateInfo bindingFlags{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_BINDING_FLAGS_CREATE_INFO};
+    bindingFlags.bindingCount = static_cast<std::uint32_t>(flags.size());
+    bindingFlags.pBindingFlags = flags.data();
+    VkDescriptorSetLayoutCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    info.pNext = updateAfterBind ? &bindingFlags : nullptr;
+    info.flags = updateAfterBind ? VK_DESCRIPTOR_SET_LAYOUT_CREATE_UPDATE_AFTER_BIND_POOL_BIT : 0;
+    info.bindingCount = static_cast<std::uint32_t>(bindings.size());
+    info.pBindings = bindings.data();
+    VkDescriptorSetLayout layout = VK_NULL_HANDLE;
+    Check(context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout")(context.device, &info, nullptr, &layout), "vkCreateDescriptorSetLayout");
+    return layout;
+}
+
+VkDescriptorPool CreateSetPool(const Context& context, std::span<const VkDescriptorPoolSize> sizes, bool updateAfterBind) {
+    for (const auto& size : sizes) Require(size.descriptorCount <= SetDescriptorLimit(context, size.type, updateAfterBind), "descriptor set exceeds the device's per-set descriptor limit");
+    VkDescriptorPoolCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    info.flags = updateAfterBind ? VK_DESCRIPTOR_POOL_CREATE_UPDATE_AFTER_BIND_BIT : 0;
+    info.maxSets = 1;
+    info.poolSizeCount = static_cast<std::uint32_t>(sizes.size());
+    info.pPoolSizes = sizes.data();
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    Check(context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool")(context.device, &info, nullptr, &pool), "vkCreateDescriptorPool");
+    return pool;
+}
