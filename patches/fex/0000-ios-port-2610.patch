+  const int fd = ::openat(AT_FDCWD, fextl::string(directory).c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0) return;
+  DIR* stream = ::fdopendir(fd);
+  if (!stream) { ::close(fd); return; }
+  while (const auto* entry = ::readdir(stream)) {
+    const std::string_view child = entry->d_name;
+    if (child == "." || child == "..") continue;
