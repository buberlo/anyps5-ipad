+    } else if (Signed < 0 && Signed >= -4095) {
+      sub(ARMEmitter::Size::i64Bit, Tmp, AddrReg, static_cast<uint64_t>(-Signed));
+    } else {
+      LoadConstant(ARMEmitter::Size::i64Bit, Tmp, Const);
