+  for (const char C : Tok) {
+    int D;
+    if (C >= '0' && C <= '9') {
+      D = C - '0';
+    } else if (C >= 'a' && C <= 'f') {
+      D = C - 'a' + 10;
+    } else if (C >= 'A' && C <= 'F') {
