+static bool RecursiveRemoveDirectory(int parent, const char* name) {
+  const int fd = ::openat(parent, name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0) return errno == ENOENT;
+  DIR* stream = ::fdopendir(fd);
+  if (!stream) { ::close(fd); return false; }
+  bool result = true;
+  while (true) {
+    errno = 0;
+    const auto* entry = ::readdir(stream);
+    if (!entry) { result = errno == 0; break; }
+    const std::string_view child = entry->d_name;
+    if (child == "." || child == "..") continue;
+    bool directory {};
+    if (!IsDirectory(fd, *entry, directory) ||
+        (directory && !RecursiveRemoveDirectory(fd, entry->d_name))) {
+      result = false;
+      break;
+    }
+    if (::unlinkat(fd, entry->d_name, directory ? AT_REMOVEDIR : 0) != 0 && errno != ENOENT) {
+      result = false;
+      break;
+    }
+  }
+  if (::closedir(stream) != 0) result = false;
+  return result;
+}
