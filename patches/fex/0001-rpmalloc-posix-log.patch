+/* The iOS fork logs with Win32 WriteFile even in the POSIX build. Linux has
+ * unistd.h write(2) and no WriteFile. */
+#if PLATFORM_POSIX
+static int rpm_log_write(const void* buf, unsigned long len) {
+	ssize_t wrote = write(STDERR_FILENO, buf, (size_t)len);
+	(void)wrote;
+	return 1;
+}
+#define GetStdHandle(n) ((void*)(intptr_t)STDERR_FILENO)
+#define WriteFile(h, buf, n, written, overlapped) \
+	((void)(h), (void)(overlapped), (*(written) = (unsigned long)(n)), rpm_log_write((buf), (unsigned long)(n)))
+#endif
 
 #if defined(__linux__) || defined(__ANDROID__)
 #include <sys/prctl.h>
