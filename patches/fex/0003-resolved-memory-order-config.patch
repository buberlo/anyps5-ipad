+    if (TraceConfig && strcmp(TraceConfig, "1") == 0) {
+      FEX_CONFIG_OPT(TSO, TSOENABLED);
+      FEX_CONFIG_OPT(VectorTSO, VECTORTSOENABLED);
+      FEX_CONFIG_OPT(MemcpyTSO, MEMCPYSETTSOENABLED);
+      FEX_CONFIG_OPT(HalfBarrierTSO, HALFBARRIERTSOENABLED);
+      LogMan::Msg::EFmt("[fex-config] tso={} vector-tso={} memcpy-set-tso={} half-barrier-tso={}",
+                       bool(TSO()), bool(VectorTSO()), bool(MemcpyTSO()), bool(HalfBarrierTSO()));
+    }
+#endif
     CTX = FEXCore::Context::Context::CreateNewContext(HostFeatures);
   }
 
