+#ifdef FEX_IOS_HOST
+static bool GuestArgsTraceActive() {
+  static const bool enabled = [] { const auto* value = getenv("MADEIRA_TRACE_GUEST_ARGS"); return value && strcmp(value, "1") == 0; }();
+  return enabled;
+}
+static bool GuestArgsTraceRecord() {
+  static std::atomic<unsigned> records{0};
+  const auto count = records.fetch_add(1, std::memory_order_relaxed);
+  if (count == 4096) LogMan::Msg::EFmt("[guest-args] record limit reached");
+  return count < 4096;
+}
+#endif
+
 static void
 PrintValue(uint64_t Value) {
+#ifdef FEX_IOS_HOST
+  if (GuestArgsTraceActive()) {
+    if (GuestArgsTraceRecord()) LogMan::Msg::EFmt("[guest-args] value={:#018x}", Value);
+    return;
+  }
+#endif
   LogMan::Msg::DFmt("Value: 0x{:x}", Value);
 }
 
 static void PrintMsg(const char* Value) {
+#ifdef FEX_IOS_HOST
+  if (GuestArgsTraceActive()) {
+    if (GuestArgsTraceRecord()) LogMan::Msg::EFmt("{}", Value);
+    return;
+  }
+#endif
   LogMan::Msg::DFmt("{}", Value);
 }
 
