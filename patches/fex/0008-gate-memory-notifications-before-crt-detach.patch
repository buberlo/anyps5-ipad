 namespace {
+#ifdef FEX_IOS_HOST
+// MinGW runs C++ destructors at DLL detach. Heap frees made by those
+// destructors still issue Wine memory notifications; an engaged optional
+// does not establish that its contained tracker/context is still alive.
+// An early PE TLS callback closes the notification gate before any CRT
+// detach callback or global destructor can destroy those objects.
+// The flag has static storage and no destructor; the callback allocates
+// nothing and does not consult TEB/TLS, which is not initialized on attach.
+static std::atomic<bool> IosRuntimeDetaching {false};
+static void NTAPI IosBeginRuntimeDetach(PVOID, DWORD Reason, PVOID) {
+  if (Reason == DLL_PROCESS_DETACH) {
+    IosRuntimeDetaching.store(true, std::memory_order_release);
+  }
+}
+__attribute__((section(".CRT$XLB"), used))
+static PIMAGE_TLS_CALLBACK IosRuntimeDetachCallback = IosBeginRuntimeDetach;
+#endif
+
+static bool RuntimeMemoryNotificationsAvailable() {
+#ifdef FEX_IOS_HOST
+  if (IosRuntimeDetaching.load(std::memory_order_acquire)) {
+    return false;
+  }
+#endif
+  return true;
+}
