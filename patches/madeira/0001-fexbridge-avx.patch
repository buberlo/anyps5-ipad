+    //
+    // MADEIRA_FEX_AVX=0 restores the old hard off switch. Any other value,
+    // including an unset variable, enables AVX in this in-process FEXCore.
+    // PS5 titles emit AVX2 without a CPUID check, so a default of off is a
+    // SIGILL on the first VEX instruction. The ARM64EC copy inside xtajit64
+    // (FEX/Source/Windows/Common/CPUFeatures.cpp) still defaults off and turns
+    // on only for MADEIRA_FEX_AVX=1; set that for a game session.
+    {
+        const char *avx = std::getenv("MADEIRA_FEX_AVX");
+        Features.SupportsAVX = !(avx && avx[0] == '0' && avx[1] == '\0');
+    }
     Features.SupportsSVE128 = false;
     Features.SupportsSVE256 = false;
+    if (Features.SupportsAVX && Features.SupportsAES) Features.SupportsAES256 = true;
+    fex_log("  Host AVX/AVX2=%s (128-bit emulation, SVE not required; MADEIRA_FEX_AVX=%s)",
