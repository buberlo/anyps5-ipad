diff --git a/build/win32u-unix/config_ios.h b/build/win32u-unix/config_ios.h
index a7927f2..b9436e8 100644
--- a/build/win32u-unix/config_ios.h
+++ b/build/win32u-unix/config_ios.h
@@ -4,6 +4,11 @@
  *
  * The stripped macros gate code paths we compile out for the initial
  * iOS port (no freetype, fontconfig, egl, vulkan, gnutls on device).
+ *
+ * Vulkan is opt-in: build/win32u-unix/vulkan_ios.c re-defines
+ * SONAME_LIBVULKAN to "MoltenVK" after this header's #undef when
+ * MADEIRA_WITH_VULKAN=1. Leaving the #undef here keeps every other
+ * translation unit on the stub path.
  */
 #ifndef WIN32U_IOS_CONFIG_H
 #define WIN32U_IOS_CONFIG_H
diff --git a/build/win32u-unix/moltenvk_static_loader.h b/build/win32u-unix/moltenvk_static_loader.h
new file mode 100644
index 0000000..1ec4c24
--- /dev/null
+++ b/build/win32u-unix/moltenvk_static_loader.h
@@ -0,0 +1,22 @@
+/* MoltenVK load path for Madeira's single-process Wine.
+ *
+ * win32u's unix vulkan.c does dlopen(SONAME_LIBVULKAN) and then dlsym's
+ * vkGetInstanceProcAddr / vkGetDeviceProcAddr. On iOS those two symbols are
+ * linked into the same Mach-O (MoltenVK.a merged into the app, same pattern
+ * as freetype). dlopen of a dylib still wins when one is embedded; otherwise
+ * the loader binds the process-global symbols.
+ *
+ * This file does not include Wine headers so it can be compile-checked on
+ * Linux. vulkan_ios.c renames dlopen/dlsym/dlclose to the functions here
+ * before including Wine's vulkan.c.
+ */
+#ifndef MADEIRA_MOLTENVK_STATIC_LOADER_H
+#define MADEIRA_MOLTENVK_STATIC_LOADER_H
+
+int madeira_vk_path_is_icd(const char *path);
+void *madeira_vk_static_sentinel(void);
+void *madeira_vk_dlopen(const char *path, int mode);
+void *madeira_vk_dlsym(void *handle, const char *symbol);
+int madeira_vk_dlclose(void *handle);
+
+#endif
diff --git a/build/wine-i386/build.sh b/build/wine-i386/build.sh
index 52d9045..5a36f6d 100755
--- a/build/wine-i386/build.sh
+++ b/build/wine-i386/build.sh
@@ -46,7 +46,12 @@ if [ ! -f "$B/config.status" ]; then
     mkdir -p "$B"
     # --enable-winegstreamer: the PE half never touches GStreamer, but configure
     # drops the module without GStreamer's development files (docs/MEDIA.md).
-    (cd "$B" && ../configure --enable-archs=i386 --without-x --without-vulkan \
+    # MADEIRA_WITH_VULKAN=1 keeps winevulkan/vulkan-1 in the i386 farm.
+    # AnyPS5's Windows PE is x86-64, so the arm64ec farm (build/wine-pe) is
+    # the one that has to ship vulkan-1.dll; this switch is the 32-bit twin.
+    vulkan_args=(--without-vulkan)
+    if [ "${MADEIRA_WITH_VULKAN:-}" = "1" ]; then vulkan_args=(); fi
+    (cd "$B" && ../configure --enable-archs=i386 --without-x "${vulkan_args[@]}" \
                              --without-freetype --without-gnutls --disable-tests \
                              --enable-winegstreamer)
 fi
@@ -60,7 +65,7 @@ SKIP_REASON=(
   "xtajit.dll|xtajit64.dll|wow64.dll|wow64win.dll|wow64cpu.dll=64-bit side of WoW64, never i386"
   "winemac.drv=macOS display driver; the display goes through win32u + Winios"
   "wineps.drv=PostScript/CUPS; no CUPS unix side on iOS"
-  "winevulkan.dll|vulkan-1.dll=tree is --without-vulkan; graphics go through DXMT"
+  "winevulkan.dll|vulkan-1.dll=skipped unless MADEIRA_WITH_VULKAN=1; DXMT remains the D3D path"
   "opencl.dll|wpcap.dll=wrappers over host unix libraries that are not built for iOS"
   "wow32.dll|winevdm.exe|vga.dll|hal.dll|w32skrnl.dll=16-bit layer; no 16-bit modules in a WoW64 tree"
   "winemenubuilder.exe=writes host desktop menu entries; there is no host desktop"
@@ -72,7 +77,14 @@ SKIP_REASON=(
   "d3d9.dll=DXMT-owned: the shim and the emulated frontend are installed below"
 )
 SKIP=()
-for e in "${SKIP_REASON[@]}"; do IFS='|' read -r -a n <<< "${e%%=*}"; SKIP+=("${n[@]}"); done
+for e in "${SKIP_REASON[@]}"; do
+    names="${e%%=*}"
+    if [ "${MADEIRA_WITH_VULKAN:-}" = "1" ] && [ "$names" = "winevulkan.dll|vulkan-1.dll" ]; then
+        continue
+    fi
+    IFS='|' read -r -a n <<< "$names"
+    SKIP+=("${n[@]}")
+done
 is_in() { local x="$1"; shift; for y in "$@"; do [ "$x" = "$y" ] && return 0; done; return 1; }
 
 TARGETS=()
diff --git a/build/wine-pe/build-modules.sh b/build/wine-pe/build-modules.sh
index b874b29..b41b93c 100755
--- a/build/wine-pe/build-modules.sh
+++ b/build/wine-pe/build-modules.sh
@@ -40,7 +40,16 @@ STRIP="$TC/arm64ec-w64-mingw32-strip"
 case "${1:-}" in
     -h|--help) sed -n '2,/^set -eu/p' "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
 esac
-[ $# -gt 0 ] || set -- cryptsp d3dx11_43 msvcp110 msvcr110 xaudio2_7
+default_modules=0
+[ $# -gt 0 ] || { default_modules=1; set -- cryptsp d3dx11_43 msvcp110 msvcr110 xaudio2_7; }
+# AnyPS5 loads vulkan-1.dll. The arm64ec configure does not pass
+# --without-vulkan; these two PE modules are the ICD the guest imports.
+# The unix side is the iOS static MoltenVK link (build/win32u-unix), not
+# this configure's dlopen. Pass the names explicitly, or set
+# MADEIRA_WITH_VULKAN=1 to append them to the default list.
+if [ "$default_modules" = 1 ] && [ "${MADEIRA_WITH_VULKAN:-}" = "1" ]; then
+    set -- "$@" winevulkan vulkan-1
+fi
 [ -x "$STRIP" ] || { echo "llvm-mingw not found at $TC (docs/BUILDING.md)" >&2; exit 1; }
 
 targets=()
@@ -53,7 +62,9 @@ for m in "$@"; do
         */*|.*|"") echo "$m: name a module directory under wine/dlls" >&2; exit 1 ;;
     esac
     [ -f "$R/wine/dlls/$m/Makefile.in" ] || { echo "$m: no wine/dlls/$m/Makefile.in" >&2; exit 1; }
-    case "$m" in *.*) f="$m" ;; *) f="$m.dll" ;; esac
+    # vulkan-1 is a directory whose product is vulkan-1.dll. The '*.*' rule
+    # exists for modules that already include their extension (winecoreaudio.drv).
+    case "$m" in vulkan-1) f="vulkan-1.dll" ;; *.*) f="$m" ;; *) f="$m.dll" ;; esac
     targets+=("dlls/$m/arm64ec-windows/$f")
 done
 
