diff --git a/build/winevulkan-unix/binder.h b/build/winevulkan-unix/binder.h
new file mode 100644
--- /dev/null
+++ b/build/winevulkan-unix/binder.h
@@ -0,0 +1,30 @@
+/* winevulkan's ARM64EC PE calls this native 64-bit Unix table. */
+#ifndef MADEIRA_WINEVULKAN_BINDER_H
+#define MADEIRA_WINEVULKAN_BINDER_H
+
+#include <stddef.h>
+#include <string.h>
+#include <strings.h>
+
+extern const void *winevulkan_unix_call_funcs[];
+
+static int madeira_winevulkan_matches(const char *name)
+{
+    const char *base, *backslash;
+    if (!name) return 0;
+    base = strrchr(name, '/');
+    base = base ? base + 1 : name;
+    backslash = strrchr(base, '\\');
+    if (backslash) base = backslash + 1;
+    return !strcasecmp(base, "winevulkan.dll") || !strcasecmp(base, "winevulkan.so")
+        || !strcasecmp(base, "winevulkan");
+}
+
+static const void *madeira_winevulkan_table(int wow)
+{
+    /* The first iOS Vulkan path is x64/ARM64EC. Generated wow64 thunks
+     * have not been adapted to Madeira's 32-bit pointer mapping. */
+    return wow ? NULL : (const void *)winevulkan_unix_call_funcs;
+}
+
+#endif
