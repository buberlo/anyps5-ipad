diff --git a/build/win32u-unix/moltenvk_static_loader.c b/build/win32u-unix/moltenvk_static_loader.c
new file mode 100644
index 0000000..c8edaec
--- /dev/null
+++ b/build/win32u-unix/moltenvk_static_loader.c
@@ -0,0 +1,83 @@
+#include "moltenvk_static_loader.h"
+
+#include <dlfcn.h>
+#include <string.h>
+
+#if defined(MADEIRA_VK_STATIC_LINK)
+/* These strong references keep the ICD entry points in a static app link.
+ * The loader has no Vulkan-header dependency; both dispatchable handles and
+ * function addresses use the platform ABI's pointer representation. */
+typedef void (*madeira_vk_proc)(void);
+extern madeira_vk_proc vkGetInstanceProcAddr(void *instance, const char *name);
+extern madeira_vk_proc vkGetDeviceProcAddr(void *device, const char *name);
+#endif
+
+/* glibc 2.35 (Ubuntu 22.04) hides RTLD_DEFAULT unless _GNU_SOURCE.
+ * The value is the same one current glibc publishes by default. */
+#ifndef RTLD_DEFAULT
+#define RTLD_DEFAULT ((void *)0)
+#endif
+
+static int g_static_icd_sentinel;
+
+static void *static_entry(const char *symbol)
+{
+    if (!symbol) return NULL;
+#if defined(MADEIRA_VK_STATIC_LINK)
+    if (strcmp(symbol, "vkGetInstanceProcAddr") == 0) return (void *)vkGetInstanceProcAddr;
+    if (strcmp(symbol, "vkGetDeviceProcAddr") == 0) return (void *)vkGetDeviceProcAddr;
+    return NULL;
+#else
+    return dlsym(RTLD_DEFAULT, symbol);
+#endif
+}
+
+int madeira_vk_path_is_icd(const char *path)
+{
+    if (!path) return 0;
+    return strstr(path, "MoltenVK") != NULL
+        || strstr(path, "libvulkan") != NULL
+        || strstr(path, "vulkan.framework") != NULL;
+}
+
+void *madeira_vk_static_sentinel(void)
+{
+    return &g_static_icd_sentinel;
+}
+
+void *madeira_vk_dlopen(const char *path, int mode)
+{
+    if (!path) return NULL;
+#if defined(MADEIRA_VK_STATIC_LINK)
+    /* An explicit static build always uses its pinned ICD, even if a host
+     * also has a Vulkan dylib. It never hands our sentinel to system dlsym. */
+    if (madeira_vk_path_is_icd(path)) return madeira_vk_static_sentinel();
+#endif
+    void *handle = dlopen(path, mode);
+    if (handle) return handle;
+    if (!madeira_vk_path_is_icd(path)) return NULL;
+    /* Static MoltenVK: the two entry points Wine resolves are already in
+     * this process. Any other ICD path that failed to dlopen stays a miss. */
+    if (static_entry("vkGetInstanceProcAddr") && static_entry("vkGetDeviceProcAddr"))
+        return madeira_vk_static_sentinel();
+    return NULL;
+}
+
+void *madeira_vk_dlsym(void *handle, const char *symbol)
+{
+    if (!handle || !symbol) return NULL;
+    if (handle == madeira_vk_static_sentinel())
+    {
+        /* Wine's vulkan_init_once only looks these two up on the ICD. */
+        if (strcmp(symbol, "vkGetInstanceProcAddr") != 0 && strcmp(symbol, "vkGetDeviceProcAddr") != 0)
+            return NULL;
+        return static_entry(symbol);
+    }
+    return dlsym(handle, symbol);
+}
+
+int madeira_vk_dlclose(void *handle)
+{
+    if (!handle || handle == madeira_vk_static_sentinel()) return 0;
+    return dlclose(handle);
+}
diff --git a/build/winevulkan-unix/binder.h b/build/winevulkan-unix/binder.h
new file mode 100644
index 0000000..fa87300
--- /dev/null
+++ b/build/winevulkan-unix/binder.h
@@ -0,0 +1,30 @@
+/* winevulkan's ARM64EC PE calls this native 64-bit Unix table. */
+#ifndef MADEIRA_WINEVULKAN_BINDER_H
+#define MADEIRA_WINEVULKAN_BINDER_H
+
+#include <stddef.h>
+#include <string.h>
+#include <strings.h>
+
+extern const void *winevulkan_unix_call_funcs[];
+
+static int madeira_winevulkan_matches(const char *name)
+{
+    const char *base, *backslash;
+    if (!name) return 0;
+    base = strrchr(name, '/');
+    base = base ? base + 1 : name;
+    backslash = strrchr(base, '\\');
+    if (backslash) base = backslash + 1;
+    return !strcasecmp(base, "winevulkan.dll") || !strcasecmp(base, "winevulkan.so")
+        || !strcasecmp(base, "winevulkan");
+}
+
+static const void *madeira_winevulkan_table(int wow)
+{
+    /* The first iOS Vulkan path is x64/ARM64EC. Generated wow64 thunks
+     * have not been adapted to Madeira's 32-bit pointer mapping. */
+    return wow ? NULL : (const void *)winevulkan_unix_call_funcs;
+}
+
+#endif
diff --git a/build/winevulkan-unix/build.sh b/build/winevulkan-unix/build.sh
new file mode 100755
index 0000000..bd3c337
--- /dev/null
+++ b/build/winevulkan-unix/build.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+# Build the actual Unix side that winevulkan.dll calls on iOS.
+set -euo pipefail
+here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+madeira="$(cd "$here/../.." && pwd)"
+wine="${WINE_SRC:-$madeira/wine}"
+configured="${WINE_BUILD:-$wine/build-macos}"
+out="${WINEVULKAN_BUILD_DIR:-$here/obj}"
+sdk="$(xcrun --sdk iphoneos --show-sdk-path)"
+test -f "$configured/include/config.h" || {
+    echo "Wine generated headers missing: $configured/include/config.h" >&2
+    exit 1
+}
+mkdir -p "$out"
+objects=()
+for name in vulkan vulkan_thunks; do
+    source="$wine/dlls/winevulkan/$name.c"
+    if [ "$name" = vulkan ]; then source="$here/vulkan_ios.c"; fi
+    xcrun --sdk iphoneos clang -arch arm64 -isysroot "$sdk" \
+        -miphoneos-version-min=17.0 -O2 -fPIC -fvisibility=hidden \
+        -fno-stack-protector -fno-strict-aliasing \
+        -Werror=implicit-function-declaration \
+        -include "$configured/include/config.h" \
+        -include "$madeira/build/ntdll-unix/shims/wine_ios_exit.h" \
+        -I"$here" -I"$configured/include" -I"$wine/include" \
+        -I"$configured/dlls/winevulkan" -I"$wine/dlls/winevulkan" \
+        -D__WINESRC__ -D_NTSYSTEM_ -D_ACRTIMP= -DWINBASEAPI= \
+        -DWINE_UNIX_LIB -DWINE_IOS=1 \
+        -D__wine_unix_call_funcs=winevulkan_unix_call_funcs \
+        -D__wine_unix_call_wow64_funcs=winevulkan_unix_call_wow64_funcs \
+        -c "$source" -o "$out/$name.o"
+    objects+=("$out/$name.o")
+done
+xcrun --sdk iphoneos libtool -static -o "$out/libwinevulkan_unix.a" "${objects[@]}"
+xcrun nm -g "$out/libwinevulkan_unix.a" > "$out/symbols.txt"
+grep -Eq ' [BDRS] _winevulkan_unix_call_funcs$' "$out/symbols.txt"
+grep -q ' T _aps5_vulkan_present_count$' "$out/symbols.txt"
+cp "$out/libwinevulkan_unix.a" "$madeira/app/Madeira/libwinevulkan_unix.a"
+echo "Built iOS winevulkan Unix archive: $out/libwinevulkan_unix.a"
