index a0a635d..1c194d4 100755
--- a/build/win32u-unix/build.sh
+++ b/build/win32u-unix/build.sh
@@ -10,14 +10,23 @@ set -e
 
 BUILD_DIR="$(cd "$(dirname "$0")" && pwd)"
 REPO_ROOT="$(cd "$BUILD_DIR/../.." && pwd)"
-WINE_SRC="$REPO_ROOT/wine"
-WINE_BUILD="$WINE_SRC/build-macos"
+WINE_SRC="${WINE_SRC:-$REPO_ROOT/wine}"
+WINE_BUILD="${WINE_BUILD:-$WINE_SRC/build-macos}"
 NTDLL_SHIMS="$REPO_ROOT/build/ntdll-unix/shims"
 SDK=$(xcrun --sdk iphoneos --show-sdk-path)
 OBJ_DIR="$BUILD_DIR/obj"
 APP_LIB="$REPO_ROOT/app/Madeira/libwin32u_unix.a"
 
 mkdir -p "$OBJ_DIR"
+# Rebuilding with Vulkan disabled must not retain old Vulkan objects.
+rm -f "$OBJ_DIR"/*.o "$OBJ_DIR/libwin32u_unix.a"
+VULKAN_FLAGS=()
+if [ "${MADEIRA_WITH_VULKAN:-}" = "1" ]; then
+    VULKAN_FLAGS=(-DMADEIRA_WITH_VULKAN=1)
+    if [ "${MADEIRA_VK_STATIC_LINK:-1}" = "1" ]; then
+        VULKAN_FLAGS+=(-DMADEIRA_VK_STATIC_LINK=1)
+    fi
+fi
 
 SUCCEEDED=0
 FAILED=0
@@ -53,7 +62,7 @@ compile_one() {
         -USONAME_LIBVULKAN \
         -USONAME_LIBGNUTLS \
         -UHAVE_FT2BUILD_H \
-        "$@" \
+        "${VULKAN_FLAGS[@]}" "$@" \
         -c "$src" -o "$OBJ_DIR/$name.o" 2>"$OBJ_DIR/$name.err"; then
         echo "OK"
         SUCCEEDED=$((SUCCEEDED + 1))
@@ -127,11 +136,25 @@ for src in $WINE_SRC/dlls/win32u/*.c $WINE_SRC/dlls/win32u/dibdrv/*.c; do
                 -I"$REPO_ROOT/research/freetype/include"
             continue
             ;;
+        vulkan)
+            # Default tree still compiles upstream vulkan.c with SONAME_LIBVULKAN
+            # undefined (config_ios.h). MADEIRA_WITH_VULKAN=1 swaps in the
+            # MoltenVK static-link wrapper. See vulkan_ios.c.
+            if [ "${MADEIRA_WITH_VULKAN:-}" = "1" ]; then
+                compile_one "$BUILD_DIR/vulkan_ios.c" "vulkan" -DMADEIRA_WITH_VULKAN=1
+                continue
+            fi
+            ;;
     esac
 
     compile_one "$src" "$name"
 done
 
+if [ "${MADEIRA_WITH_VULKAN:-}" = "1" ]; then
+    compile_one "$BUILD_DIR/vulkan_metal_ios.c" "vulkan_metal_ios"
+    compile_one "$BUILD_DIR/moltenvk_static_loader.c" "moltenvk_static_loader"
+fi
+
 echo ""
 echo "Results: $SUCCEEDED succeeded, $FAILED failed"
 if [ -n "$FAILED_FILES" ]; then
