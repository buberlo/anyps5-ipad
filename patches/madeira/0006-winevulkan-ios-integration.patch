diff --git a/build/winevulkan-unix/vulkan_ios.c b/build/winevulkan-unix/vulkan_ios.c
new file mode 100644
index 0000000..bc923b7
--- /dev/null
+++ b/build/winevulkan-unix/vulkan_ios.c
@@ -0,0 +1,56 @@
+/* Compile Wine's native Vulkan ICD into the iOS app. The PE loader and
+ * generated thunks stay at the same pinned Wine revision. */
+#define init_vulkan winevulkan_base_init_vulkan
+#include "vulkan.c"
+#undef init_vulkan
+
+#ifndef _WIN64
+#error The iOS winevulkan Unix library requires the 64-bit Wine ABI
+#endif
+
+#include <stdatomic.h>
+#include "present_count.h"
+
+static _Atomic(uint64_t) aps5_presented;
+static struct vulkan_funcs aps5_vulkan_functions;
+static const struct vulkan_funcs *aps5_vulkan_driver;
+static pthread_once_t aps5_vulkan_functions_once = PTHREAD_ONCE_INIT;
+
+__attribute__((visibility("default"))) uint64_t aps5_vulkan_present_count(void)
+{
+    return atomic_load_explicit(&aps5_presented, memory_order_relaxed);
+}
+
+static VkResult aps5_vkQueuePresentKHR(VkQueue queue, const VkPresentInfoKHR *info)
+{
+    VkResult result = aps5_vulkan_driver->p_vkQueuePresentKHR(queue, info);
+    uint64_t accepted = 0;
+    /* On an early error the driver may not have populated pResults. Never
+     * count a caller's zero-initialized output slots as successful presents. */
+    if (result != VK_SUCCESS && result != VK_SUBOPTIMAL_KHR) return result;
+    for (uint32_t i = 0; i < info->swapchainCount; ++i)
+    {
+        VkResult status = info->pResults ? info->pResults[i] : result;
+        if (status == VK_SUCCESS || status == VK_SUBOPTIMAL_KHR) ++accepted;
+    }
+    /* Counts presentations accepted by Vulkan, not completed GPU work or
+     * physical display scans. Device acceptance still needs visible frames. */
+    atomic_fetch_add_explicit(&aps5_presented, accepted, memory_order_relaxed);
+    return result;
+}
+
+static void aps5_init_vulkan_functions(void)
+{
+    aps5_vulkan_driver = vk_funcs;
+    aps5_vulkan_functions = *vk_funcs;
+    aps5_vulkan_functions.p_vkQueuePresentKHR = aps5_vkQueuePresentKHR;
+}
+
+NTSTATUS init_vulkan(void *args)
+{
+    NTSTATUS status = winevulkan_base_init_vulkan(args);
+    if (status) return status;
+    pthread_once(&aps5_vulkan_functions_once, aps5_init_vulkan_functions);
+    vk_funcs = &aps5_vulkan_functions;
+    return STATUS_SUCCESS;
+}
