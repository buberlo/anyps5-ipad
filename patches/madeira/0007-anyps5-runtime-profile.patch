diff --git a/app/Madeira/MadeiraApp.swift b/app/Madeira/MadeiraApp.swift
index 4a1b630..4e437d7 100644
--- a/app/Madeira/MadeiraApp.swift
+++ b/app/Madeira/MadeiraApp.swift
@@ -2,6 +2,32 @@ import SwiftUI
 
 @main
 struct MadeiraApp: App {
+    init() {
+        // This app has its own bundle/container. Seed the runtime profile once;
+        // subsequent user configuration is retained unchanged.
+        if let url = MadeiraConfig.url, !MadeiraConfig.present {
+            let profile = """
+            # AnyPS5 iPad runtime profile, version 1.
+            # Guest addresses are retained; physical pages are committed on demand.
+            env.MADEIRA_FEX_AVX = 1
+            env.APS5_GUEST_ARENA_LAZY = 1
+            env.MADEIRA_CONTROLS_XBOX_DEFAULT = 1
+            env.MADEIRA_FRAMEGEN = 0
+            d3d12 = 0
+            """
+            do {
+                try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+                try (profile + "\n").write(to: url, atomically: true, encoding: .utf8)
+            } catch {
+                NSLog("[anyps5] Could not create initial runtime profile: %@", String(describing: error))
+            }
+        }
+        // Touch controls read their defaults before Wine exports cfg env lines.
+        for name in ["MADEIRA_FEX_AVX", "APS5_GUEST_ARENA_LAZY", "MADEIRA_CONTROLS_XBOX_DEFAULT"] {
+            if let value = MadeiraConfig.get("env." + name) { setenv(name, value, 1) }
+        }
+    }
+
     var body: some Scene {
         WindowGroup {
             ContentView()
