+@MainActor enum AnyPS5RuntimeDiagnostics {
+    private static let writer = DispatchQueue(label: "com.anyps5.runtime-va", qos: .utility)
+    private static var launchGeneration: UInt64 = 0
+
+    nonisolated static func record(_ phase: String) {
+        DispatchQueue.main.async { capture(phase) }
+    }
+
+    nonisolated static func wineStarted() {
+        DispatchQueue.main.async {
+            launchGeneration &+= 1
+            let generation = launchGeneration
+            let baseline = madeira_get_present_count()
+            DispatchQueue.main.asyncAfter(deadline: .now() + 5) {
+                guard launchGeneration == generation, wine_process_is_running() != 0 else { return }
+                capture("wine_thread_running_after_5s")
+            }
+            pollFirstPresent(baseline: baseline, generation: generation, remaining: 120)
+        }
+    }
+
+    private static func pollFirstPresent(baseline: UInt64, generation: UInt64, remaining: Int) {
+        DispatchQueue.main.asyncAfter(deadline: .now() + 1) {
+            guard launchGeneration == generation else { return }
+            guard wine_process_is_running() != 0 else { capture("wine_thread_not_running"); return }
+            if madeira_get_present_count() > baseline {
+                capture("first_new_winevulkan_present_observed")
+            } else if remaining > 1 {
+                pollFirstPresent(baseline: baseline, generation: generation, remaining: remaining - 1)
+            } else {
+                capture("wine_running_without_new_present_120s")
+            }
+        }
+    }
+
+    private static func capture(_ phase: String) {
+        guard let documents = FileManager.default.urls(for: .documentDirectory, in: .userDomainMask).first else { return }
+        let signing = SigningStatus.current
+        let application = UIApplication.shared
+        let context: [String: Any] = [
+            "context_captured_unix_seconds": Date().timeIntervalSince1970,
+            "bundle_identifier": Bundle.main.bundleIdentifier ?? "unknown",
+            "bundle_version": Bundle.main.object(forInfoDictionaryKey: "CFBundleVersion") as? String ?? "unknown",
+            "build_stamp": BuildStamp.text,
+            "application_state": application.applicationState.rawValue,
+            "scene_activation_states": application.connectedScenes.map { $0.activationState.rawValue }.sorted(),
+            "thermal_state": ProcessInfo.processInfo.thermalState.rawValue,
+            "low_power_mode": ProcessInfo.processInfo.isLowPowerModeEnabled,
+            "wine_process_running_flag": wine_process_is_running() != 0,
+            "cs_flags_known": signing.known, "cs_flags": signing.flags, "cs_debugged": signing.debugged,
+            "debugger_attached": isDebuggerAttached(), "jit_pool_taken": StikJITHelper.poolTaken,
+            "jit_ready_for_launch": StikJITHelper.ready,
+            "jit_state_scope": "existing signing/debugger/pool flags; not an execution test",
+            "winevulkan_present_count": madeira_get_present_count(),
+            "present_scope": "Vulkan present results; not proof of visible gameplay"
+        ]
+        guard let data = try? JSONSerialization.data(withJSONObject: context, options: [.sortedKeys]),
+              let contextJSON = String(data: data, encoding: .utf8) else { return }
+        let path = documents.appendingPathComponent("runtime-native-va.jsonl").path
+        writer.async {
+            let result = aps5_runtime_snapshot(path, phase, contextJSON)
+            if result != 0 {
+                DispatchQueue.main.async {
+                    LogStore.shared.log("[anyps5-va] \(phase): snapshot partial/error \(result); inspect runtime-native-va.jsonl")
+                }
+            }
+        }
+    }
+}
