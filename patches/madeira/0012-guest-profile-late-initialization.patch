         if (!view || (view->protect & (SEC_IMAGE | VPROT_ARM64EC | VPROT_SYSTEM | VPROT_PLACEHOLDER))) return 0;
         vb = (uintptr_t)view->base;
         if (!view->size || view->size > UINTPTR_MAX - vb || vb + view->size <= a) return 0;
