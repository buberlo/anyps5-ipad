diff --git a/build/win32u-unix/vulkan_metal_ios.c b/build/win32u-unix/vulkan_metal_ios.c
new file mode 100644
index 0000000..375c0ec
--- /dev/null
+++ b/build/win32u-unix/vulkan_metal_ios.c
@@ -0,0 +1,183 @@
+/* winios Vulkan user-driver: VK_KHR_win32_surface -> VK_EXT_metal_surface.
+ *
+ * Madeira is one Mach-O. Wine's PE winevulkan.dll calls
+ * __wine_get_vulkan_driver, which dlopens the ICD (see vulkan_ios.c) and
+ * then asks the user driver for a surface. There is no winemac.drv unix
+ * library on iOS. This TU is linked into libwin32u_unix.a and registered
+ * from driver_ios.c as winios_pVulkanInit when the symbol is present.
+ *
+ * IOSDisplayShim selects the existing game CAMetalLayer or the desktop
+ * compositor's HWND layer. The surface retains it until destruction.
+ *
+ * Not compile-checked on Linux: it includes Wine's unix headers and is
+ * built by build/win32u-unix/build.sh with the iOS SDK. The loader beside
+ * it (moltenvk_static_loader.c) is compile-checked on Linux.
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "wine/gdi_driver.h"
+#include "wine/vulkan_driver.h"
+#include "moltenvk_static_loader.h"
+
+extern void *madeira_vulkan_layer_acquire(void *hwnd);
+extern void madeira_vulkan_layer_release(void *layer);
+
+struct ios_client_surface
+{
+    struct client_surface base;
+    void *layer;
+};
+
+static int g_use_metal_surface;
+static int g_surface_maintenance;
+
+static void ios_surface_destroy(struct client_surface *surface)
+{
+    struct ios_client_surface *ios = (struct ios_client_surface *)surface;
+    madeira_vulkan_layer_release(ios->layer);
+}
+
+static void ios_surface_detach(struct client_surface *surface)
+{
+    (void)surface;
+}
+
+static void ios_surface_update(struct client_surface *surface)
+{
+    (void)surface;
+}
+
+static void ios_surface_present(struct client_surface *surface, HDC hdc)
+{
+    (void)surface;
+    (void)hdc;
+}
+
+static const struct client_surface_funcs ios_surface_funcs =
+{
+    .destroy = ios_surface_destroy,
+    .detach = ios_surface_detach,
+    .update = ios_surface_update,
+    .present = ios_surface_present,
+};
+
+static VkResult ios_vulkan_surface_create(HWND hwnd, const struct vulkan_instance *instance, VkSurfaceKHR *handle,
+                                          struct client_surface **client)
+{
+    VkMetalSurfaceCreateInfoEXT info;
+    VkResult res;
+    void *layer;
+    struct ios_client_surface *surface;
+
+    if (!g_use_metal_surface || !instance || !instance->p_vkCreateMetalSurfaceEXT)
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+    layer = madeira_vulkan_layer_acquire(hwnd);
+    if (!layer) return VK_ERROR_INCOMPATIBLE_DRIVER;
+    surface = (struct ios_client_surface *)client_surface_create(sizeof(*surface), &ios_surface_funcs, hwnd);
+    if (!surface)
+    {
+        madeira_vulkan_layer_release(layer);
+        return VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+    surface->layer = layer;
+
+    memset(&info, 0, sizeof(info));
+    info.sType = VK_STRUCTURE_TYPE_METAL_SURFACE_CREATE_INFO_EXT;
+    info.pLayer = layer;
+    res = instance->p_vkCreateMetalSurfaceEXT(instance->host.instance, &info, NULL, handle);
+    if (res != VK_SUCCESS)
+    {
+        client_surface_release(&surface->base);
+        return res;
+    }
+    *client = &surface->base;
+    return VK_SUCCESS;
+}
+
+static VkBool32 ios_get_physical_device_presentation_support(struct vulkan_physical_device *physical_device, uint32_t index)
+{
+    (void)physical_device;
+    (void)index;
+    return g_use_metal_surface ? VK_TRUE : VK_FALSE;
+}
+
+static void ios_map_instance_extensions(struct vulkan_instance_extensions *extensions)
+{
+    if (!g_use_metal_surface) return;
+    /* Guest code asks for VK_KHR_win32_surface. The host ICD has
+     * VK_EXT_metal_surface. Wine's map is symmetric so a client that
+     * enabled the metal extension directly still sees win32. */
+    if (extensions->has_VK_KHR_win32_surface) extensions->has_VK_EXT_metal_surface = 1;
+    if (extensions->has_VK_EXT_metal_surface) extensions->has_VK_KHR_win32_surface = 1;
+    /* Wine clears the Win32 bit before its own maintenance-extension test.
+     * Metal's natural extent differs from a deliberately scaled HWND. */
+    if (extensions->has_VK_KHR_win32_surface && g_surface_maintenance)
+    {
+        extensions->has_VK_EXT_surface_maintenance1 = 1;
+        extensions->has_VK_KHR_get_surface_capabilities2 = 1;
+    }
+}
+
+static void ios_map_device_extensions(struct vulkan_device_extensions *extensions)
+{
+    (void)extensions;
+}
+
+static const struct vulkan_driver_funcs ios_vulkan_driver_funcs =
+{
+    .p_vulkan_surface_create = ios_vulkan_surface_create,
+    .p_get_physical_device_presentation_support = ios_get_physical_device_presentation_support,
+    .p_map_instance_extensions = ios_map_instance_extensions,
+    .p_map_device_extensions = ios_map_device_extensions,
+};
+
+UINT winios_pVulkanInit(UINT version, void *vulkan_handle, const struct vulkan_driver_funcs **driver_funcs)
+{
+    PFN_vkGetInstanceProcAddr get_proc;
+    PFN_vkEnumerateInstanceExtensionProperties enumerate;
+    VkExtensionProperties *extensions;
+    uint32_t count = 0;
+    int maintenance = 0, capabilities2 = 0;
+    VkResult result;
+
+    if (version != WINE_VULKAN_DRIVER_VERSION) return STATUS_INVALID_PARAMETER;
+    if (!driver_funcs) return STATUS_INVALID_PARAMETER;
+    *driver_funcs = NULL;
+    g_use_metal_surface = 0;
+    g_surface_maintenance = 0;
+    get_proc = (PFN_vkGetInstanceProcAddr)madeira_vk_dlsym(vulkan_handle, "vkGetInstanceProcAddr");
+    if (!get_proc) return STATUS_NOT_IMPLEMENTED;
+    enumerate = (PFN_vkEnumerateInstanceExtensionProperties)get_proc(VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+    if (!enumerate || enumerate(NULL, &count, NULL) != VK_SUCCESS || !count)
+        return STATUS_NOT_IMPLEMENTED;
+    extensions = calloc(count, sizeof(*extensions));
+    if (!extensions) return STATUS_NO_MEMORY;
+    result = enumerate(NULL, &count, extensions);
+    if (result == VK_SUCCESS)
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            if (!strcmp(extensions[i].extensionName, "VK_EXT_metal_surface")) g_use_metal_surface = 1;
+            if (!strcmp(extensions[i].extensionName, "VK_EXT_surface_maintenance1")) maintenance = 1;
+            if (!strcmp(extensions[i].extensionName, "VK_KHR_get_surface_capabilities2")) capabilities2 = 1;
+        }
+    g_surface_maintenance = maintenance && capabilities2;
+    free(extensions);
+    /* There is no VkInstance yet. Wine resolves vkCreateMetalSurfaceEXT on
+     * the host instance after applying our extension mapping. */
+    if (!g_use_metal_surface) return STATUS_NOT_IMPLEMENTED;
+    *driver_funcs = &ios_vulkan_driver_funcs;
+    return STATUS_SUCCESS;
+}
