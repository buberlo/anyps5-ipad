 import Foundation
 import SwiftUI
 
+// Named logs are independent snapshots. The active single-link file remains
+// readable by iOS file services while native writers keep their descriptors.
+// A pending name survives a crash; the next launch seals it before rotation.
+enum SessionLogArchive {
+    static func pendingURL(_ log: URL) -> URL {
+        log.deletingLastPathComponent().appendingPathComponent("madeira-log.archive-pending.txt")
+    }
+    static func snapshot(_ log: URL, clearPending: Bool = false) throws {
+        let pending = pendingURL(log)
+        guard FileManager.default.fileExists(atPath: pending.path) else { return }
+        let name = try String(contentsOf: pending, encoding: .utf8)
+        guard !name.isEmpty, name != ".txt", name.hasSuffix(".txt"),
+              !name.contains("/"), !name.contains("\\"), !name.contains("\n") else {
+            throw CocoaError(.fileReadCorruptFile)
+        }
+        let dir = log.deletingLastPathComponent().appendingPathComponent("logs")
+        try FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        // Avoid buffering a potentially large log in the app's early heap:
+        // JIT and guest images still need their fixed virtual address windows.
+        let fm = FileManager.default
+        let target = dir.appendingPathComponent(name)
+        let temporary = dir.appendingPathComponent(UUID().uuidString + ".archive-tmp")
+        defer { try? fm.removeItem(at: temporary) }
+        try fm.copyItem(at: log, to: temporary)
+        if fm.fileExists(atPath: target.path) {
+            _ = try fm.replaceItemAt(target, withItemAt: temporary)
+        } else {
+            try fm.moveItem(at: temporary, to: target)
+        }
+        if clearPending { try FileManager.default.removeItem(at: pending) }
+    }
+    static func begin(_ log: URL, name: String) throws {
+        // Finish an earlier session before replacing its pending archive name.
+        try snapshot(log, clearPending: true)
+        try name.write(to: pendingURL(log), atomically: true, encoding: .utf8)
+        try snapshot(log)
+    }
+}
