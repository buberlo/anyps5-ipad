diff --git a/build/ntdll-unix/mach_fault_redelivery.h b/build/ntdll-unix/mach_fault_redelivery.h
new file mode 100644
--- /dev/null
+++ b/build/ntdll-unix/mach_fault_redelivery.h
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef IOS_MACH_FAULT_REDELIVERY_H
+#define IOS_MACH_FAULT_REDELIVERY_H
+#include <stdint.h>
+#define IOS_REDELIVERY_THREADS 64u
+struct ios_redelivery_entry { uint64_t thread, pc, address; uint32_t count; };
+struct ios_redelivery_tracker {
+    struct ios_redelivery_entry entries[IOS_REDELIVERY_THREADS];
+    unsigned next;
+};
+/* One Mach exception-server caller. Other threads do not reset a failing
+ * thread's sequence; a different delivery on that thread does. Watched stores
+ * may recur at the same PC/address after intervening guest work. */
+static inline uint32_t ios_redelivery_record(struct ios_redelivery_tracker *t,
+                                            uint64_t thread, uint64_t pc,
+                                            uint64_t address, int exempt)
+{
+    struct ios_redelivery_entry *entry = 0, *empty = 0;
+    unsigned i;
+    for (i = 0; i < IOS_REDELIVERY_THREADS; ++i)
+    {
+        if (t->entries[i].count && t->entries[i].thread == thread) { entry = &t->entries[i]; break; }
+        if (!t->entries[i].count && !empty) empty = &t->entries[i];
+    }
+    if (exempt) { if (entry) entry->count = 0; return 0; }
+    if (!entry)
+    {
+        entry = empty ? empty : &t->entries[t->next++ % IOS_REDELIVERY_THREADS];
+        entry->count = 0;
+    }
+    if (!entry->count || entry->pc != pc || entry->address != address)
+    {
+        entry->thread = thread; entry->pc = pc; entry->address = address; entry->count = 1;
+    }
+    else if (entry->count != UINT32_MAX) ++entry->count;
+    return entry->count;
+}
+#endif
