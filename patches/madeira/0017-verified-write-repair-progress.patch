+/* AnyPS5's explicitly configured guest arena is x86 memory, not ARM code.
+ * Keep Wine's logical execution rights and FEX's SMC notifications intact,
+ * but do not remap shared GPU pages into the native executable pool. That
+ * loses section sharing and allocates one JIT alias for each 16-KiB page. */
+static int ios_anyps5_guest_arena_limits( uintptr_t *start, size_t *span )
+{
+    static int enabled;
+    static uintptr_t arena_start;
+    static size_t arena_span;
+    if (!enabled)
+    {
+        const char *lazy = getenv( "APS5_GUEST_ARENA_LAZY" );
+        const char *base = getenv( "APS5_GUEST_ARENA_BASE" );
+        const char *size = getenv( "APS5_GUEST_ARENA_SIZE" );
+        int saved_errno = errno;
+        char *end;
+        unsigned long long b = 0, n = 0;
+        if (lazy && !strcmp( lazy, "1" ) && base && size &&
+            *base && *size && !strchr( " \t\r\n+-", *base ) &&
+            !strchr( " \t\r\n+-", *size ))
+        {
+            errno = 0;
+            b = strtoull( base, &end, 0 );
+            if (!errno && !*end && b && b <= UINTPTR_MAX)
+            {
+                errno = 0;
+                n = strtoull( size, &end, 0 );
+                if (!errno && !*end && n && n <= SIZE_MAX && n <= UINTPTR_MAX - b &&
+                    !(b & host_page_mask) && !(n & host_page_mask))
+                {
+                    arena_start = (uintptr_t)b;
+                    arena_span = (size_t)n;
+                    enabled = 1;
+                }
+            }
+        }
+        errno = saved_errno;
+        /* The native runtime can query protections before the app/child has
+         * exported its profile. Cache success only; absence is not permanent. */
+        {
+            static unsigned int config_n;
+            if (config_n++ < 4 && !ios_in_mach_exc)
+                dprintf( 2, "[anyps5-guest-config] enabled=%d lazy=%s base=%s span=%s\n",
+                         enabled, lazy ? lazy : "(unset)", base ? base : "(unset)", size ? size : "(unset)" );
+        }
+    }
+    *start = arena_start;
+    *span = arena_span;
+    return enabled;
+}
+
+static int ios_anyps5_guest_arena_is_host_data( const void *base, size_t size )
+{
+    uintptr_t arena, b = (uintptr_t)base, e, a;
+    size_t span;
+    static unsigned int classify_n;
+    uintptr_t rx = (uintptr_t)ios_jit_rx_base_global;
+    uintptr_t rw = (uintptr_t)ios_jit_rw_base_global;
+    if (!size || !ios_anyps5_guest_arena_limits( &arena, &span ) ||
+        b < arena || size > span || b - arena > span - size) return 0;
+    {
+        static unsigned int candidate_n;
+        if (candidate_n++ < 4 && !ios_in_mach_exc)
+            dprintf( 2, "[anyps5-guest-candidate] %p+0x%lx ec_map=%d ec_alloc=%d\n",
+                     base, (unsigned long)size, !!arm64ec_view, ios_alloc_ec_code );
+    }
+    if (!arm64ec_view || ios_alloc_ec_code) return 0;
+    e = b + size;  /* the configured arena and containment checks exclude overflow */
+    if ((rx && e > rx && b < rx + ios_jit_pool_size_global) ||
+        (rw && e > rw && b < rw + ios_jit_pool_size_global)) return 0;
+    for (a = b; a < e; )
+    {
+        const struct file_view *view = find_view( (const void *)a, 1 );
+        uintptr_t vb;
+        if (classify_n++ < 24 && !ios_in_mach_exc)
+            dprintf( 2, "[anyps5-guest-classify] request=%p+0x%lx view=%p flags=0x%x\n",
+                     base, (unsigned long)size, view ? view->base : NULL, view ? view->protect : 0 );
+        if (!view || (view->protect & (SEC_IMAGE | VPROT_ARM64EC | VPROT_SYSTEM))) return 0;
+        /* Replaced section views retain PLACEHOLDER so unmap can restore it.
+         * Reject an empty placeholder, not a committed replacement mapping. */
+        if ((view->protect & VPROT_PLACEHOLDER) && !(view->protect & VPROT_COMMITTED)) return 0;
+        vb = (uintptr_t)view->base;
+        if (!view->size || view->size > UINTPTR_MAX - vb || vb + view->size <= a) return 0;
+        a = vb + view->size;
+    }
+    return 1;
+}
