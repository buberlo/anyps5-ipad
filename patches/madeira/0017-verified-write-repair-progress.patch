+static struct ios_redelivery_tracker ios_mach_redeliv;
+static pthread_mutex_t ios_mach_redeliv_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* A guest handler may repair an intentionally protected shared-data page,
+ * resume its store and re-arm that page on every frame. This is not one
+ * unrecoverable refault loop. NtProtectVirtualMemory calls us only after a
+ * successful read-only -> writable transition. Verify the actual backing
+ * before retiring that thread's delivery sequence; never trust logical
+ * Wine permissions alone. */
+void ios_mach_mark_write_repaired( uintptr_t base, size_t size )
+{
+    uint64_t thread = (uint64_t)pthread_mach_thread_np( pthread_self() );
+    mach_vm_address_t address = 0;
+    unsigned i;
+    int found = 0;
+
+    pthread_mutex_lock( &ios_mach_redeliv_lock );
+    for (i = 0; i < IOS_REDELIVERY_THREADS; ++i)
+    {
+        const struct ios_redelivery_entry *e = &ios_mach_redeliv.entries[i];
+        if (e->count && e->thread == thread && e->address >= base &&
+            e->address - base < size)
+        {
+            address = e->address;
+            found = 1;
+            break;
+        }
+    }
+    pthread_mutex_unlock( &ios_mach_redeliv_lock );
+    if (found)
+    {
+        mach_vm_address_t region = address;
+        mach_vm_size_t region_size = 0;
+        natural_t depth = 0;
+        vm_region_submap_info_data_64_t info;
+        kern_return_t kr;
+        do
+        {
+            mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_COUNT_64;
+            kr = mach_vm_region_recurse( mach_task_self(), &region, &region_size,
+                    &depth, (vm_region_recurse_info_t)&info, &count );
+            if (kr != KERN_SUCCESS || !info.is_submap) break;
+            ++depth;
+        } while (1);
+        if (kr == KERN_SUCCESS && address >= region &&
+            address - region < region_size && (info.protection & VM_PROT_WRITE))
+        {
+            pthread_mutex_lock( &ios_mach_redeliv_lock );
+            ios_redelivery_repaired( &ios_mach_redeliv, thread, base, size );
+            pthread_mutex_unlock( &ios_mach_redeliv_lock );
+        }
+    }
+}
