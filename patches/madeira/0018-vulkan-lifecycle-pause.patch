diff --git a/build/win32u-unix/vulkan_lifecycle.h b/build/win32u-unix/vulkan_lifecycle.h
new file mode 100644
--- /dev/null
+++ b/build/win32u-unix/vulkan_lifecycle.h
@@ -0,0 +1,41 @@
+/* Admission gate: UIKit closes it before backgrounding; entrants park rather
+ * than dropping a submission or reporting fabricated Vulkan success. */
+#ifndef APS5_VULKAN_LIFECYCLE_H
+#define APS5_VULKAN_LIFECYCLE_H
+#include <pthread.h>
+struct aps5_gpu_gate {
+    pthread_mutex_t lock;
+    pthread_cond_t changed;
+    unsigned running;
+    int active;
+};
+#define APS5_GPU_GATE_INITIALIZER { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, 0, 0 }
+static inline void aps5_gpu_enter(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    while (!g->active) pthread_cond_wait(&g->changed, &g->lock);
+    ++g->running;
+    pthread_mutex_unlock(&g->lock);
+}
+static inline void aps5_gpu_leave(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    if (!--g->running) pthread_cond_broadcast(&g->changed);
+    pthread_mutex_unlock(&g->lock);
+}
+/* Returns with admission closed and lock held; caller drains outstanding GPU
+ * work before releasing the lock, while UIKit still permits execution. */
+static inline void aps5_gpu_pause_lock(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    g->active = 0;
+    while (g->running) pthread_cond_wait(&g->changed, &g->lock);
+}
+static inline void aps5_gpu_resume(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    g->active = 1;
+    pthread_cond_broadcast(&g->changed);
+    pthread_mutex_unlock(&g->lock);
+}
+#endif
