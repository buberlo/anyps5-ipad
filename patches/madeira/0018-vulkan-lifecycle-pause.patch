diff --git a/build/win32u-unix/vulkan_lifecycle.h b/build/win32u-unix/vulkan_lifecycle.h
new file mode 100644
index 0000000..1d52cc2
--- /dev/null
+++ b/build/win32u-unix/vulkan_lifecycle.h
@@ -0,0 +1,41 @@
+/* Admission gate: UIKit closes it before backgrounding; entrants park rather
+ * than dropping a submission or reporting fabricated Vulkan success. */
+#ifndef APS5_VULKAN_LIFECYCLE_H
+#define APS5_VULKAN_LIFECYCLE_H
+#include <pthread.h>
+struct aps5_gpu_gate {
+    pthread_mutex_t lock;
+    pthread_cond_t changed;
+    unsigned running;
+    int active;
+};
+#define APS5_GPU_GATE_INITIALIZER { PTHREAD_MUTEX_INITIALIZER, PTHREAD_COND_INITIALIZER, 0, 0 }
+static inline void aps5_gpu_enter(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    while (!g->active) pthread_cond_wait(&g->changed, &g->lock);
+    ++g->running;
+    pthread_mutex_unlock(&g->lock);
+}
+static inline void aps5_gpu_leave(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    if (!--g->running) pthread_cond_broadcast(&g->changed);
+    pthread_mutex_unlock(&g->lock);
+}
+/* Returns with admission closed and lock held; caller drains outstanding GPU
+ * work before releasing the lock, while UIKit still permits execution. */
+static inline void aps5_gpu_pause_lock(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    g->active = 0;
+    while (g->running) pthread_cond_wait(&g->changed, &g->lock);
+}
+static inline void aps5_gpu_resume(struct aps5_gpu_gate *g)
+{
+    pthread_mutex_lock(&g->lock);
+    g->active = 1;
+    pthread_cond_broadcast(&g->changed);
+    pthread_mutex_unlock(&g->lock);
+}
+#endif
diff --git a/build/win32u-unix/vulkan_ios.c b/build/win32u-unix/vulkan_ios.c
new file mode 100644
index 0000000..54079ab
--- /dev/null
+++ b/build/win32u-unix/vulkan_ios.c
@@ -0,0 +1,300 @@
+/* iOS translation unit for dlls/win32u/vulkan.c.
+ *
+ * config_ios.h (passed with -include) #undefs SONAME_LIBVULKAN so the rest
+ * of the unix library keeps the "built without Vulkan" stubs. This file
+ * puts the macro back, then redirects dlopen/dlsym/dlclose onto
+ * moltenvk_static_loader.c before compiling upstream vulkan.c unchanged.
+ *
+ * SONAME is the literal "MoltenVK". The static build selects the pinned
+ * archive and supplies the host-only portability subset during device
+ * creation. Dynamic builds retain the normal loader dispatch.
+ */
+
+#define SONAME_LIBVULKAN "MoltenVK"
+
+#include "moltenvk_static_loader.h"
+#include <dlfcn.h>
+
+static void *madeira_vk_dlsym_ios(void *handle, const char *symbol);
+
+#define dlopen  madeira_vk_dlopen
+#define dlsym   madeira_vk_dlsym_ios
+#define dlclose madeira_vk_dlclose
+
+#define __wine_get_vulkan_driver madeira_get_vulkan_driver_base
+#include "vulkan.c"
+#undef __wine_get_vulkan_driver
+
+#undef dlopen
+#undef dlsym
+#undef dlclose
+
+#if defined(MADEIRA_VK_STATIC_LINK)
+/* Wine suppresses native Vulkan prototypes; these are the statically linked
+ * MoltenVK entry points, with the native ABI and full declared signatures. */
+extern VkResult VKAPI_CALL vkCreateDevice(VkPhysicalDevice, const VkDeviceCreateInfo *, const VkAllocationCallbacks *, VkDevice *);
+extern VkResult VKAPI_CALL vkEnumerateDeviceExtensionProperties(VkPhysicalDevice, const char *, uint32_t *, VkExtensionProperties *);
+extern void VKAPI_CALL vkDestroyDevice(VkDevice, const VkAllocationCallbacks *);
+extern VkResult VKAPI_CALL vkQueueSubmit(VkQueue, uint32_t, const VkSubmitInfo *, VkFence);
+extern VkResult VKAPI_CALL vkQueueSubmit2(VkQueue, uint32_t, const VkSubmitInfo2 *, VkFence);
+extern VkResult VKAPI_CALL vkQueueSubmit2KHR(VkQueue, uint32_t, const VkSubmitInfo2 *, VkFence);
+extern VkResult VKAPI_CALL vkQueuePresentKHR(VkQueue, const VkPresentInfoKHR *);
+extern VkResult VKAPI_CALL vkQueueWaitIdle(VkQueue);
+extern VkResult VKAPI_CALL vkDeviceWaitIdle(VkDevice);
+extern VkResult VKAPI_CALL vkAcquireNextImageKHR(VkDevice, VkSwapchainKHR, uint64_t, VkSemaphore, VkFence, uint32_t *);
+extern VkResult VKAPI_CALL vkAcquireNextImage2KHR(VkDevice, const VkAcquireNextImageInfoKHR *, uint32_t *);
+/* This Wine revision excludes the provisional portability-subset extension
+ * from its generated extension bitsets. Its host-create conversion therefore
+ * drops the name even when an application requests it. Add the advertised
+ * host requirement after that conversion, preserving the feature chain. */
+static VkResult VKAPI_CALL madeira_vkCreateDevice_base(VkPhysicalDevice physical,
+        const VkDeviceCreateInfo *info, const VkAllocationCallbacks *allocator, VkDevice *device)
+{
+    static const char subset[] = "VK_KHR_portability_subset";
+    VkExtensionProperties *properties = NULL;
+    uint32_t count = 0;
+    VkResult result;
+    int advertised = 0;
+    for (uint32_t i = 0; i < info->enabledExtensionCount; ++i)
+        if (!strcmp(info->ppEnabledExtensionNames[i], subset))
+            return vkCreateDevice(physical, info, allocator, device);
+    do
+    {
+        free(properties);
+        properties = NULL;
+        result = vkEnumerateDeviceExtensionProperties(physical, NULL, &count, NULL);
+        if (result != VK_SUCCESS) return result;
+        if (!count) return vkCreateDevice(physical, info, allocator, device);
+        properties = calloc(count, sizeof(*properties));
+        if (!properties) return VK_ERROR_OUT_OF_HOST_MEMORY;
+        result = vkEnumerateDeviceExtensionProperties(physical, NULL, &count, properties);
+    } while (result == VK_INCOMPLETE);
+    if (result == VK_SUCCESS)
+        for (uint32_t i = 0; i < count; ++i)
+            if (!strcmp(properties[i].extensionName, subset)) advertised = 1;
+    free(properties);
+    if (result != VK_SUCCESS) return result;
+    if (!advertised) return vkCreateDevice(physical, info, allocator, device);
+    const char **extensions = calloc((size_t)info->enabledExtensionCount + 1, sizeof(*extensions));
+    if (!extensions) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    for (uint32_t i = 0; i < info->enabledExtensionCount; ++i) extensions[i] = info->ppEnabledExtensionNames[i];
+    extensions[info->enabledExtensionCount] = subset;
+    VkDeviceCreateInfo host = *info;
+    host.enabledExtensionCount++;
+    host.ppEnabledExtensionNames = extensions;
+    result = vkCreateDevice(physical, &host, allocator, device);
+    free(extensions);
+    return result;
+}
+
+#include "vulkan_lifecycle.h"
+static struct aps5_gpu_gate aps5_gpu = APS5_GPU_GATE_INITIALIZER;
+struct aps5_gpu_device { VkDevice host; struct aps5_gpu_device *next; };
+static struct aps5_gpu_device *aps5_gpu_devices;
+static pthread_mutex_t aps5_gpu_devices_lock = PTHREAD_MUTEX_INITIALIZER;
+
+__attribute__((visibility("default"))) void aps5_vulkan_set_active(int active)
+{
+    if (active) {
+        aps5_gpu_resume(&aps5_gpu);
+        fprintf(stderr, "[anyps5-vulkan-lifecycle] resumed\n");
+        return;
+    }
+    aps5_gpu_pause_lock(&aps5_gpu);
+    pthread_mutex_lock(&aps5_gpu_devices_lock);
+    unsigned devices = 0;
+    for (struct aps5_gpu_device *d = aps5_gpu_devices; d; d = d->next) {
+        /* Direct static MoltenVK call bypasses the closed admission gate. */
+        VkResult result = vkDeviceWaitIdle(d->host);
+        fprintf(stderr, "[anyps5-vulkan-lifecycle] drain result=%d\n", result);
+        ++devices;
+    }
+    pthread_mutex_unlock(&aps5_gpu_devices_lock);
+    pthread_mutex_unlock(&aps5_gpu.lock);
+    fprintf(stderr, "[anyps5-vulkan-lifecycle] paused devices=%u\n", devices);
+}
+
+static VkResult VKAPI_CALL madeira_vkCreateDevice(VkPhysicalDevice physical,
+        const VkDeviceCreateInfo *info, const VkAllocationCallbacks *allocator, VkDevice *device)
+{
+    struct aps5_gpu_device *entry = calloc(1, sizeof(*entry));
+    if (!entry) return VK_ERROR_OUT_OF_HOST_MEMORY;
+    aps5_gpu_enter(&aps5_gpu);
+    VkResult result = madeira_vkCreateDevice_base(physical, info, allocator, device);
+    if (result == VK_SUCCESS) {
+        entry->host = *device;
+        pthread_mutex_lock(&aps5_gpu_devices_lock);
+        entry->next = aps5_gpu_devices;
+        aps5_gpu_devices = entry;
+        pthread_mutex_unlock(&aps5_gpu_devices_lock);
+    } else free(entry);
+    aps5_gpu_leave(&aps5_gpu);
+    return result;
+}
+
+static void VKAPI_CALL aps5_vkDestroyDevice(VkDevice device, const VkAllocationCallbacks *allocator)
+{
+    aps5_gpu_enter(&aps5_gpu);
+    pthread_mutex_lock(&aps5_gpu_devices_lock);
+    struct aps5_gpu_device **at = &aps5_gpu_devices;
+    while (*at && (*at)->host != device) at = &(*at)->next;
+    if (*at) { struct aps5_gpu_device *old = *at; *at = old->next; free(old); }
+    pthread_mutex_unlock(&aps5_gpu_devices_lock);
+    vkDestroyDevice(device, allocator);
+    aps5_gpu_leave(&aps5_gpu);
+}
+#define APS5_GPU_RESULT(name, signature, arguments) \
+static VkResult VKAPI_CALL aps5_##name signature \
+{ aps5_gpu_enter(&aps5_gpu); VkResult result = name arguments; aps5_gpu_leave(&aps5_gpu); return result; }
+APS5_GPU_RESULT(vkQueueSubmit, (VkQueue q, uint32_t n, const VkSubmitInfo *s, VkFence f), (q,n,s,f))
+APS5_GPU_RESULT(vkQueueSubmit2, (VkQueue q, uint32_t n, const VkSubmitInfo2 *s, VkFence f), (q,n,s,f))
+APS5_GPU_RESULT(vkQueueSubmit2KHR, (VkQueue q, uint32_t n, const VkSubmitInfo2 *s, VkFence f), (q,n,s,f))
+APS5_GPU_RESULT(vkQueuePresentKHR, (VkQueue q, const VkPresentInfoKHR *i), (q,i))
+APS5_GPU_RESULT(vkQueueWaitIdle, (VkQueue q), (q))
+APS5_GPU_RESULT(vkDeviceWaitIdle, (VkDevice d), (d))
+APS5_GPU_RESULT(vkAcquireNextImageKHR, (VkDevice d, VkSwapchainKHR s, uint64_t t, VkSemaphore m, VkFence f, uint32_t *i), (d,s,t,m,f,i))
+APS5_GPU_RESULT(vkAcquireNextImage2KHR, (VkDevice d, const VkAcquireNextImageInfoKHR *a, uint32_t *i), (d,a,i))
+#undef APS5_GPU_RESULT
+
+static PFN_vkVoidFunction aps5_lifecycle_proc(const char *name, PFN_vkVoidFunction proc)
+{
+    if (!proc || !name) return proc;
+#define APS5_GPU_PROC(n) if (!strcmp(name, #n)) return (PFN_vkVoidFunction)aps5_##n
+    APS5_GPU_PROC(vkQueueSubmit); APS5_GPU_PROC(vkQueueSubmit2); APS5_GPU_PROC(vkQueueSubmit2KHR);
+    APS5_GPU_PROC(vkQueuePresentKHR); APS5_GPU_PROC(vkQueueWaitIdle); APS5_GPU_PROC(vkDeviceWaitIdle);
+    APS5_GPU_PROC(vkAcquireNextImageKHR); APS5_GPU_PROC(vkAcquireNextImage2KHR); APS5_GPU_PROC(vkDestroyDevice);
+#undef APS5_GPU_PROC
+    return proc;
+}
+static PFN_vkVoidFunction VKAPI_CALL madeira_vkGetDeviceProcAddr(VkDevice device, const char *name)
+{
+    PFN_vkGetDeviceProcAddr get_proc = (PFN_vkGetDeviceProcAddr)madeira_vk_dlsym(vulkan_handle, "vkGetDeviceProcAddr");
+    return aps5_lifecycle_proc(name, get_proc(device, name));
+}
+
+static PFN_vkVoidFunction VKAPI_CALL madeira_vkGetInstanceProcAddr(VkInstance instance, const char *name)
+{
+    PFN_vkGetInstanceProcAddr get_proc = (PFN_vkGetInstanceProcAddr)madeira_vk_dlsym(vulkan_handle, "vkGetInstanceProcAddr");
+    PFN_vkVoidFunction proc = get_proc(instance, name);
+    if (proc && name && !strcmp(name, "vkCreateDevice")) return (PFN_vkVoidFunction)madeira_vkCreateDevice;
+    return aps5_lifecycle_proc(name, proc);
+}
+#endif
+
+static void *madeira_vk_dlsym_ios(void *handle, const char *symbol)
+{
+    void *proc = madeira_vk_dlsym(handle, symbol);
+#if defined(MADEIRA_VK_STATIC_LINK)
+    if (proc && symbol && !strcmp(symbol, "vkGetInstanceProcAddr")) return (void *)madeira_vkGetInstanceProcAddr;
+    if (proc && symbol && !strcmp(symbol, "vkGetDeviceProcAddr")) return (void *)madeira_vkGetDeviceProcAddr;
+#endif
+    return proc;
+}
+
+/* A Wine HWND is deliberately scaled into Madeira's fullscreen game layer.
+ * Negotiate real surface/device maintenance support instead of suppressing
+ * MoltenVK's SUBOPTIMAL result or its natural-extent check. */
+static VkResult VKAPI_CALL madeira_scaled_host_swapchain(VkDevice device,
+        const VkSwapchainCreateInfoKHR *info, const VkAllocationCallbacks *allocator, VkSwapchainKHR *ret)
+{
+    PFN_vkCreateSwapchainKHR create = (PFN_vkCreateSwapchainKHR)p_vkGetDeviceProcAddr(device, "vkCreateSwapchainKHR");
+    return create(device, info, allocator, ret);
+}
+
+static VkResult madeira_client_create_device(VkPhysicalDevice physical,
+        const VkDeviceCreateInfo *info, const VkAllocationCallbacks *allocator, VkDevice *ret)
+{
+    struct vulkan_physical_device *pd = vulkan_physical_device_from_handle(physical);
+    struct vulkan_instance *instance = pd->instance;
+    VkPhysicalDeviceSwapchainMaintenance1FeaturesEXT maintenance = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SWAPCHAIN_MAINTENANCE_1_FEATURES_EXT};
+    VkPhysicalDeviceFeatures2 features = {.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &maintenance};
+    VkDeviceCreateInfo host = *info;
+    int enabled = 0, existing = 0;
+    VkResult result;
+    if (instance->extensions.has_VK_EXT_surface_maintenance1 && pd->extensions.has_VK_EXT_swapchain_maintenance1)
+    {
+        PFN_vkGetPhysicalDeviceFeatures2 query = (PFN_vkGetPhysicalDeviceFeatures2)
+            p_vkGetInstanceProcAddr(instance->host.instance, "vkGetPhysicalDeviceFeatures2");
+        if (!query) query = (PFN_vkGetPhysicalDeviceFeatures2)
+            p_vkGetInstanceProcAddr(instance->host.instance, "vkGetPhysicalDeviceFeatures2KHR");
+        if (query) query(pd->host.physical_device, &features);
+        if (maintenance.swapchainMaintenance1)
+        {
+            for (const VkBaseInStructure *next = info->pNext; next; next = next->pNext)
+                if (next->sType == maintenance.sType)
+                {
+                    existing = 1;
+                    enabled = ((const VkPhysicalDeviceSwapchainMaintenance1FeaturesEXT *)next)->swapchainMaintenance1;
+                }
+            if (!existing)
+            {
+                maintenance.pNext = (void *)host.pNext;
+                host.pNext = &maintenance;
+                enabled = 1;
+            }
+        }
+    }
+    result = win32u_vkCreateDevice(physical, &host, allocator, ret);
+    if (result == VK_SUCCESS && enabled)
+    {
+        /* Per-device marker: no global device registry or handle lifetime race.
+         * The native function itself passes through to the real ICD. */
+        struct vulkan_device *device = vulkan_device_from_handle(*ret);
+        if (device->extensions.has_VK_EXT_swapchain_maintenance1)
+            device->p_vkCreateSwapchainKHR = madeira_scaled_host_swapchain;
+    }
+    return result;
+}
+
+static VkResult madeira_client_create_swapchain(VkDevice client,
+        const VkSwapchainCreateInfoKHR *info, const VkAllocationCallbacks *allocator, VkSwapchainKHR *ret)
+{
+    struct vulkan_device *device = vulkan_device_from_handle(client);
+    struct vulkan_physical_device *pd = device->physical_device;
+    struct vulkan_instance *instance = pd->instance;
+    struct surface *surface = surface_from_handle(info->surface);
+    VkSwapchainPresentScalingCreateInfoEXT scaling = {
+        .sType = VK_STRUCTURE_TYPE_SWAPCHAIN_PRESENT_SCALING_CREATE_INFO_EXT,
+        .pNext = info->pNext, .scalingBehavior = VK_PRESENT_SCALING_STRETCH_BIT_EXT};
+    VkSurfacePresentModeEXT mode = {.sType = VK_STRUCTURE_TYPE_SURFACE_PRESENT_MODE_EXT, .presentMode = info->presentMode};
+    VkPhysicalDeviceSurfaceInfo2KHR surface_info = {
+        .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SURFACE_INFO_2_KHR, .pNext = &mode};
+    VkSurfacePresentScalingCapabilitiesEXT support = {.sType = VK_STRUCTURE_TYPE_SURFACE_PRESENT_SCALING_CAPABILITIES_EXT};
+    VkSurfaceCapabilities2KHR capabilities = {.sType = VK_STRUCTURE_TYPE_SURFACE_CAPABILITIES_2_KHR, .pNext = &support};
+    VkSwapchainCreateInfoKHR host = *info;
+    if (!surface || device->p_vkCreateSwapchainKHR != madeira_scaled_host_swapchain ||
+        !instance->p_vkGetPhysicalDeviceSurfaceCapabilities2KHR)
+        return win32u_vkCreateSwapchainKHR(client, info, allocator, ret);
+    /* Preserve explicit application scaling rather than duplicating its sType. */
+    for (const VkBaseInStructure *next = info->pNext; next; next = next->pNext)
+        if (next->sType == scaling.sType) return win32u_vkCreateSwapchainKHR(client, info, allocator, ret);
+    surface_info.surface = surface->obj.host.surface;
+    VkResult result = instance->p_vkGetPhysicalDeviceSurfaceCapabilities2KHR(
+        pd->host.physical_device, &surface_info, &capabilities);
+    if (result != VK_SUCCESS) return result;
+    if (!(support.supportedPresentScaling & VK_PRESENT_SCALING_STRETCH_BIT_EXT) ||
+        info->imageExtent.width < support.minScaledImageExtent.width ||
+        info->imageExtent.height < support.minScaledImageExtent.height ||
+        info->imageExtent.width > support.maxScaledImageExtent.width ||
+        info->imageExtent.height > support.maxScaledImageExtent.height)
+        return win32u_vkCreateSwapchainKHR(client, info, allocator, ret);
+    host.pNext = &scaling;
+    fprintf(stderr, "[anyps5-vulkan-scaling] supported stretch extent=%ux%u; maintenance feature enabled\n",
+            info->imageExtent.width, info->imageExtent.height);
+    return win32u_vkCreateSwapchainKHR(client, &host, allocator, ret);
+}
+
+static pthread_once_t madeira_scaling_once = PTHREAD_ONCE_INIT;
+static void madeira_install_scaling(void)
+{
+    vulkan_funcs.p_vkCreateDevice = madeira_client_create_device;
+    vulkan_funcs.p_vkCreateSwapchainKHR = madeira_client_create_swapchain;
+}
+
+const struct vulkan_funcs *__wine_get_vulkan_driver(UINT version)
+{
+    const struct vulkan_funcs *funcs = madeira_get_vulkan_driver_base(version);
+    if (funcs) pthread_once(&madeira_scaling_once, madeira_install_scaling);
+    return funcs;
+}
