+                    fprintf(stderr, "[anyps5-native] {\"schema\":1,\"monotonic_ns\":%llu,\"epoch\":%llu,\"swapchain_id\":%llu,\"swapchain_displayed_total\":%llu", (unsigned long long)now, (unsigned long long)aps5_display_epoch, (unsigned long long)s->identity, (unsigned long long)s->stats.count);
+                    static const char *names[4] = {"submit", "present", "acquire", "idle"};
