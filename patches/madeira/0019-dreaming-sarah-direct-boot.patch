+// BEGIN ANYPS5 SINGLE GAME BOOT
+/// A single cold-start transaction. A connected VPN never counts as JIT success.
+/// Dependencies make asynchronous VPN/JIT callbacks testable without a device.
+@MainActor final class SingleGameBoot: ObservableObject {
+    enum Phase: Equatable {
+        case idle, checking, connecting, waitingForReturn, enablingJIT, ready, starting, running
+        case failed(String)
+    }
+    struct Dependencies {
+        var active: () -> Bool
+        var jitReady: () -> Bool
+        var preflight: () throws -> Void
+        var probe: (@escaping (Bool) -> Void) -> Void
+        var connect: (@escaping (Result<Void, Error>) -> Void) -> Void
+        var waitForConnection: (@escaping (Bool) -> Void) -> Void
+        var enable: (@escaping (Result<Void, Error>) -> Void) -> Void
+        var launch: () -> Void
+    }
+    @Published private(set) var phase: Phase = .idle
+    private(set) var launchIssued = false
+    private var generation = 0
+    private var connectionStarted = false
+    private var needsConnection = false
+    private let dependencies: Dependencies
+    init(_ dependencies: Dependencies) { self.dependencies = dependencies }
+
+    func start() {
+        guard phase == .idle, dependencies.active() else { return }
+        generation += 1
+        do { try dependencies.preflight() }
+        catch { phase = .failed(error.localizedDescription); return }
+        if dependencies.jitReady() { phase = .ready; launchWhenActive(); return }
+        let token = generation
+        phase = .checking
+        dependencies.probe { [weak self] reachable in
+            guard let self, generation == token, phase == .checking else { return }
+            if reachable { activateJIT() }
+            else {
+                needsConnection = true
+                if dependencies.active() { connectVPN() } else { phase = .waitingForReturn }
+            }
+        }
+    }
+    func becameActive() {
+        switch phase {
+        case .idle: start()
+        case .connecting: break // an in-flight OS permission/connection is not complete
+        case .waitingForReturn:
+            if connectionStarted { waitForVPN() }
+            else if needsConnection { connectVPN() }
+            else { activateJIT() }
+        case .ready: launchWhenActive()
+        case .running:
+            if !dependencies.jitReady() {
+                phase = .idle
+                connectionStarted = false
+                needsConnection = false
+                start()
+            }
+        default: break
+        }
+    }
+    private func connectVPN() {
+        guard !connectionStarted else { return }
+        connectionStarted = true
+        let token = generation
+        phase = .connecting
+        dependencies.connect { [weak self] result in
+            guard let self, generation == token, phase == .connecting else { return }
+            switch result {
+            case .failure(let error): phase = .failed(error.localizedDescription)
+            case .success:
+                // An embedded tunnel needs no external-app handoff. Verify its
+                // exact route immediately, or defer until the OS alert closes.
+                if dependencies.active() { waitForVPN() }
+                else { phase = .waitingForReturn }
+            }
+        }
+    }
+    private func waitForVPN() {
+        let token = generation
+        phase = .checking
+        dependencies.waitForConnection { [weak self] reachable in
+            guard let self, generation == token, phase == .checking else { return }
+            if reachable { activateJIT() }
+            else { phase = .failed("Die lokale Startverbindung erreicht das iPad nicht. Versuche es erneut.") }
+        }
+    }
+    private func activateJIT() {
+        // The app may have become inactive during a background network probe.
+        guard dependencies.active() else { phase = .waitingForReturn; return }
+        if dependencies.jitReady() { phase = .ready; launchWhenActive(); return }
+        let token = generation
+        phase = .enablingJIT
+        dependencies.enable { [weak self] result in
+            guard let self, generation == token, phase == .enablingJIT else { return }
+            switch result {
+            case .success:
+                guard dependencies.jitReady() else {
+                    phase = .failed("JIT wurde nicht aktiviert. Versuche es erneut."); return
+                }
+                phase = .ready
+                launchWhenActive()
+            case .failure(let error): phase = .failed(error.localizedDescription)
+            }
+        }
+    }
+    private func launchWhenActive() {
+        guard phase == .ready, dependencies.active() else { return }
+        // Recheck at the actual transition, not just at an earlier callback.
+        guard dependencies.jitReady() else { activateJIT(); return }
+        if launchIssued { phase = .running; return }
+        launchIssued = true
+        phase = .starting
+        dependencies.launch()
+    }
+    func rendered() { if phase == .starting { phase = .running } }
+    func stopped(_ message: String) {
+        guard launchIssued else { return }
+        phase = .failed(message)
+    }
+    func retry() {
+        guard case .failed = phase, !launchIssued else { return }
+        generation += 1  // ignore callbacks from the previous request
+        connectionStarted = false
+        needsConnection = false
+        phase = .idle
+        start()
+    }
+}
