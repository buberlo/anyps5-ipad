diff --git a/app/AnyPS5Tunnel/PacketTunnelProvider.swift b/app/AnyPS5Tunnel/PacketTunnelProvider.swift
new file mode 100644
--- /dev/null
+++ b/app/AnyPS5Tunnel/PacketTunnelProvider.swift
@@ -0,0 +1,143 @@
+import Darwin
+import Foundation
+import Network
+import NetworkExtension
+
+/// Based on LocalDevVPN's packet reflection; attribution is in legal/LOCALDEVVPN-NOTICE.txt.
+/// JIT runs in a separate embedded Madeira helper, whose sockets can
+/// traverse this VPN without stopping its packet loop when the host is debugged.
+final class PacketTunnelProvider: NEPacketTunnelProvider {
+    private let stateLock = NSLock()
+    private var tunnelIsRunning = false
+    private var state = "idle"
+    private var message = "Tunnel has not started."
+    private var logs: [String] = []
+    private var packetCount: UInt64 = 0
+    private var reflectedPacketCount: UInt64 = 0
+    private var tcpSYNCount: UInt64 = 0
+    private var packetBytes: UInt64 = 0
+    private var interfaceName = ""
+    private var interfaceIndex: UInt32 = 0
+
+    override func startTunnel(options: [String: NSObject]?, completionHandler: @escaping (Error?) -> Void) {
+        // Route only the reflected peer. DDI/TSS Internet connections keep the
+        // normal network, using LocalDevVPN's exact default interface addresses.
+        let ipv4 = NEIPv4Settings(addresses: ["10.7.1.1"], subnetMasks: ["255.255.255.255"])
+        ipv4.includedRoutes = [NEIPv4Route(destinationAddress: "10.7.0.1", subnetMask: "255.255.255.255")]
+        ipv4.excludedRoutes = [.default()]
+        let settings = NEPacketTunnelNetworkSettings(tunnelRemoteAddress: "10.7.0.1")
+        settings.ipv4Settings = ipv4
+        setTunnelNetworkSettings(settings) { [weak self] error in
+            guard let self else { completionHandler(error); return }
+            self.stateLock.lock()
+            if let error {
+                self.state = "failed"
+                self.message = String("Cannot start local tunnel: \(error.localizedDescription)".prefix(512))
+                self.logs = [self.message]
+                self.stateLock.unlock()
+                completionHandler(error)
+                return
+            }
+            self.tunnelIsRunning = true
+            self.interfaceName = self.virtualInterface?.name ?? ""
+            self.interfaceIndex = self.virtualInterface.flatMap { UInt32(exactly: $0.index) } ?? 0
+            self.packetCount = 0
+            self.reflectedPacketCount = 0
+            self.tcpSYNCount = 0
+            self.packetBytes = 0
+            self.state = "idle"
+            self.message = "Local tunnel ready."
+            self.logs = ["Local tunnel ready on \(self.interfaceName), interface index \(self.interfaceIndex)."]
+            self.stateLock.unlock()
+            self.readPackets()
+            completionHandler(nil)
+        }
+    }
+
+    override func stopTunnel(with reason: NEProviderStopReason, completionHandler: @escaping () -> Void) {
+        stateLock.lock()
+        tunnelIsRunning = false
+        state = "idle"
+        message = "Local tunnel stopped."
+        logs = [message]
+        stateLock.unlock()
+        completionHandler()
+    }
+
+    override func handleAppMessage(_ messageData: Data, completionHandler: ((Data?) -> Void)? = nil) {
+        guard messageData.count <= 1024 * 1024,
+              let request = try? JSONDecoder().decode(Request.self, from: messageData) else {
+            completionHandler?(response(ok: false, detail: "Invalid JSON request."))
+            return
+        }
+        switch request.command {
+        case "ping", "status":
+            completionHandler?(response(ok: true))
+        case "enableJIT":
+            completionHandler?(response(ok: false, detail: "JIT requests must use the embedded helper extension."))
+        default:
+            completionHandler?(response(ok: false, detail: "Unsupported command."))
+        }
+    }
+
+    private func readPackets() {
+        packetFlow.readPackets { [weak self] packets, protocols in
+            guard let self else { return }
+            self.stateLock.lock()
+            let running = self.tunnelIsRunning
+            self.packetCount += UInt64(packets.count)
+            self.packetBytes += packets.reduce(UInt64(0)) { $0 + UInt64($1.count) }
+            self.stateLock.unlock()
+            guard running else { return }
+            var reflectedPackets: [Data] = []
+            var reflectedProtocols: [NSNumber] = []
+            var synCount: UInt64 = 0
+            for (index, packet) in packets.enumerated() {
+                guard index < protocols.count, protocols[index].int32Value == AF_INET,
+                      packet.count >= 20, packet[0] >> 4 == 4 else { continue }
+                let headerLength = Int(packet[0] & 0x0f) * 4
+                let isFirstFragment = packet[6] & 0x1f == 0 && packet[7] == 0
+                if packet[9] == IPPROTO_TCP, isFirstFragment,
+                   headerLength >= 20, packet.count >= headerLength + 14,
+                   packet[headerLength + 13] & 0x02 != 0 {
+                    synCount += 1
+                }
+                var reflected = packet
+                // Swapping source/destination preserves IP and transport checksum
+                // sums. Byte copies avoid any UInt32 alignment assumption.
+                for offset in 0..<4 {
+                    let source = reflected[12 + offset]
+                    reflected[12 + offset] = reflected[16 + offset]
+                    reflected[16 + offset] = source
+                }
+                reflectedPackets.append(reflected)
+                reflectedProtocols.append(protocols[index])
+            }
+            self.stateLock.lock()
+            self.tcpSYNCount += synCount
+            self.reflectedPacketCount += UInt64(reflectedPackets.count)
+            self.stateLock.unlock()
+            if !reflectedPackets.isEmpty {
+                self.packetFlow.writePackets(reflectedPackets, withProtocols: reflectedProtocols)
+            }
+            self.readPackets()
+        }
+    }
+
+    private func response(ok: Bool, detail: String? = nil) -> Data? {
+        stateLock.lock()
+        let value: [String: Any] = [
+            "ok": ok, "state": state, "message": detail ?? message, "logs": logs,
+            "diagnostics": ["packetsRead": packetCount, "packetsReflected": reflectedPacketCount,
+                            "packetBytes": packetBytes, "tcpSYNPackets": tcpSYNCount,
+                            "interfaceName": interfaceName, "interfaceIndex": interfaceIndex,
+                            "tunnelRunning": tunnelIsRunning]
+        ]
+        stateLock.unlock()
+        return try? JSONSerialization.data(withJSONObject: value, options: [.sortedKeys])
+    }
+
+    private struct Request: Decodable {
+        let command: String
+    }
+}
