+            try await active.saveToPreferences()
+            try await active.loadFromPreferences()
+        }
+        manager = active
+        try await disconnect()
+        try active.connection.startVPNTunnel()
+        let deadline = ProcessInfo.processInfo.systemUptime + 40
+        while active.connection.status != .connected {
+            guard ProcessInfo.processInfo.systemUptime < deadline else {
+                stop()
+                throw failure("Die lokale Verbindung wurde nicht bereit. Erlaube die VPN-Freigabe und versuche es erneut.")
+            }
+            try await Task.sleep(nanoseconds: 200_000_000)
+        }
+        LogStore.shared.log("[jit-tunnel] embedded provider connected")
+    }
+    private func interface() async throws -> (name: String, index: UInt32) {
+        guard let session = manager?.connection as? NETunnelProviderSession,
+              session.status == .connected else { throw failure("Die lokale Startverbindung ist unterbrochen.") }
+        let data: Data = try await withCheckedThrowingContinuation { continuation in
+            var completed = false
+            func finish(_ result: Result<Data, Error>) {
+                guard !completed else { return }; completed = true
+                continuation.resume(with: result)
+            }
+            do {
+                try session.sendProviderMessage(Data("{\"command\":\"ping\"}".utf8)) { response in
+                    DispatchQueue.main.async {
+                        if let response { finish(.success(response)) }
+                        else { finish(.failure(self.failure("Die lokale Startverbindung antwortet nicht."))) }
+                    }
+                }
+            } catch { finish(.failure(error)) }
+            DispatchQueue.main.asyncAfter(deadline: .now() + 3) {
+                finish(.failure(self.failure("Zeitüberschreitung der lokalen Startverbindung.")))
+            }
+        }
+        guard let value = try JSONSerialization.jsonObject(with: data) as? [String: Any],
+              value["ok"] as? Bool == true, let diag = value["diagnostics"] as? [String: Any],
+              diag["tunnelRunning"] as? Bool == true,
+              let name = diag["interfaceName"] as? String, name.hasPrefix("utun"),
+              let number = diag["interfaceIndex"] as? NSNumber,
+              let index = UInt32(exactly: number.uint64Value), index > 0 else {
+            throw failure("Die lokale Startverbindung meldet keine gültige Schnittstelle.")
+        }
+        expectedInterface = (name, index)
+        return (name, index)
+    }
+    func reachable() async -> Bool {
+        guard let expected = try? await interface() else { return false }
+        return await AnyPS5TunnelRouteProbe.checkAsync(expectedInterface: expected.name, expectedIndex: expected.index).reachable
+    }
+    func waitForRoute() async -> Bool {
+        guard let expected = try? await interface() else { return false }
+        let deadline = ProcessInfo.processInfo.systemUptime + 15
+        repeat {
+            guard manager?.connection.status == .connected else { return false }
+            let result = await AnyPS5TunnelRouteProbe.checkAsync(expectedInterface: expected.name, expectedIndex: expected.index)
+            if result.reachable {
+                LogStore.shared.log("[jit-route] own tunnel=1 lockdownd connected=1")
+                return true
+            }
+            if ProcessInfo.processInfo.systemUptime >= deadline {
+                LogStore.shared.log("[jit-route] own tunnel unreachable: \(result.detail)", level: .error)
+                return false
+            }
+            do { try await Task.sleep(nanoseconds: 150_000_000) } catch { return false }
+        } while true
+    }
+    func stop() {
+        // Only the profile belonging to this app; no global VPN toggle.
+        manager?.connection.stopVPNTunnel()
+        expectedInterface = nil
+    }
+    func disconnect() async throws {
+        guard let manager else { return }
+        stop()
+        let deadline = ProcessInfo.processInfo.systemUptime + 15
+        while manager.connection.status != .disconnected && manager.connection.status != .invalid {
+            guard ProcessInfo.processInfo.systemUptime < deadline else {
+                throw failure("Die lokale Startverbindung konnte nicht beendet werden. Öffne die App erneut.")
+            }
+            try await Task.sleep(nanoseconds: 100_000_000)
+        }
+        LogStore.shared.log("[jit-tunnel] own provider disconnected")
     }
