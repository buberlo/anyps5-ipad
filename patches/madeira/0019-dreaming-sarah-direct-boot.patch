+/// Private game data stays in the app container, outside public build artifacts.
+/// The exact installed title is selected independently of the old library UI.
+@MainActor enum DreamingSarahApp {
+    static let relativePath = "DreamingSarah-PPSA02929-01_000_000/game.exe"
+    static let entry: LibraryEntry = {
+        var entry = LibraryEntry(title: "Dreaming Sarah", relativePath: relativePath, bits: 64)
+        entry.resolution = "1280x720"
+        entry.display = "fit"
+        entry.launchMode = "direct"
+        entry.avx = true
+        entry.frameGeneration = false
+        entry.touchControls = true
+        entry.config = "env.APS5_FIXED_FUNCTION_INTERPOLATION = 1\n"
+        return entry
+    }()
+    static let boot: SingleGameBoot = SingleGameBoot(.init(
+        active: { UIApplication.shared.applicationState == .active },
+        jitReady: { StikJITHelper.ready },
+        preflight: {
+            _ = try LibraryModel.executable(relativePath)
+            try entry.validate()
+            guard SigningStatus.current.debuggable else {
+                throw LibraryError.message("Diese Installation erlaubt kein JIT. Installiere die mit deinem Entwicklerkonto signierte App.")
+            }
+            if !StikJITHelper.ready, !JITPairingFileStore.isImported {
+                throw LibraryError.message("Die gespeicherte Kopplung für dieses iPad fehlt. Richte sie für diese Installation einmalig ein.")
+            }
+        },
+        probe: { done in
+            Task { done(await AnyPS5StartTunnel.shared.reachable()) }
+        },
+        connect: { done in
+            Task {
+                do { try await AnyPS5StartTunnel.shared.connect(); done(.success(())) }
+                catch { done(.failure(error)) }
+            }
+        },
+        waitForConnection: { done in
+            Task { done(await AnyPS5StartTunnel.shared.waitForRoute()) }
+        },
+        enable: { done in
+            // Prefer the helper that already succeeded on this paired device;
+            // never detour through StikDebug's app picker or Madeira setup UI.
+            JITCoordinator.shared.enableBuiltIn(completion: done)
+        },
+        launch: { startGame() }
+    ))
+
+    private static func startGame() {
+        let library = LibraryModel.shared
+        guard library.current == nil, wine_process_is_running() == 0,
+              wineserver_is_running() == 0, !StikJITHelper.poolTaken else {
+            boot.stopped("Bitte schließe die App und öffne sie erneut."); return
+        }
+        entry.configureLaunch()
+        entry.applyEnvironment()
+        LogStore.shared.startSessionLog(program: "game.exe")
+        library.begin(entry, remember: false)
+        TouchControlsModel.shared.editing = false
+        LibraryController.shared.configure(enabled: false, ownsInput: false)
+        GamepadInput.shared.beginPadSession()
+        GamepadInput.shared.reserveSessionSlot(touchControls: true)
+        ws_log_quiet = 1
+        let prefix = LibraryModel.documents.appendingPathComponent("wine").path
+        DispatchQueue.global(qos: .userInitiated).async {
+            // Keep the memory layout, pool and early detach of the tested path.
+            // No Steam host, installer, remote renderer or diagnostic canary.
+            let configured = MadeiraConfig.get("pool").flatMap { Int($0.trimmingCharacters(in: .whitespacesAndNewlines)) }
+            let poolMB = configured.flatMap { (256...1152).contains($0) ? $0 : nil } ?? 896
+            winios_phase("pool-alloc-begin")
+            guard let pool = StikJITHelper.allocatePool(poolSize: poolMB * 1024 * 1024) else {
+                fail(StikJITHelper.poolFailure ?? "JIT-Speicher konnte nicht angelegt werden."); return
+            }
+            setenv("WINE_IOS_JIT_RX", String(format: "%lx", Int(bitPattern: pool.rx)), 1)
+            setenv("WINE_IOS_JIT_RW", String(format: "%lx", Int(bitPattern: pool.rw)), 1)
+            setenv("WINE_IOS_JIT_SIZE", String(format: "%lx", pool.size), 1)
+            winios_phase("pool-ready")
+            StikJITHelper.detachDebugger()
+            winios_phase("detach-done")
+            DispatchQueue.main.async {
+                Task {
+                    do {
+                        try await JITCoordinator.shared.finishBuiltIn()
+                        try await AnyPS5StartTunnel.shared.disconnect()
+                        // iOS permission alerts may have interrupted the host.
+                        while UIApplication.shared.applicationState != .active {
+                            try await Task.sleep(nanoseconds: 100_000_000)
+                        }
+                        startWine(prefix)
+                    } catch { fail(error.localizedDescription) }
+                }
+            }
+        }
+    }
+    private nonisolated static func startWine(_ prefix: String) {
+        DispatchQueue.global(qos: .userInitiated).async {
+            guard wineserver_start(prefix) == 0 else { fail("Der Spielprozess konnte nicht vorbereitet werden."); return }
+            let deadline = CFAbsoluteTimeGetCurrent() + 2
+            while wineserver_is_ready() == 0, wineserver_is_running() != 0,
+                  CFAbsoluteTimeGetCurrent() < deadline { Thread.sleep(forTimeInterval: 0.01) }
+            guard wineserver_is_ready() != 0 else {
+                wineserver_stop(); fail("Der Spielprozess wurde nicht rechtzeitig bereit."); return
+            }
+            winios_phase("wine-start")
+            guard wine_process_start(prefix) == 0 else {
+                wineserver_stop(); fail("Dreaming Sarah konnte nicht gestartet werden."); return
+            }
+            LogStore.shared.log("[single-game] Dreaming Sarah started; automatic JIT ready", level: .success)
+            AnyPS5RuntimeDiagnostics.wineStarted()
+        }
+    }
+
+    private nonisolated static func fail(_ message: String) {
+        LogStore.shared.log("[single-game] \(message)", level: .error)
+        DispatchQueue.main.async {
+            LibraryModel.shared.launchFailed(message)
+            boot.stopped(message)
+            AnyPS5StartTunnel.shared.stop()
+        }
+    }
+}
