diff --git a/app/Madeira/MadeiraApp.swift b/app/Madeira/MadeiraApp.swift
index 4f3f895..8c030c1 100644
--- a/app/Madeira/MadeiraApp.swift
+++ b/app/Madeira/MadeiraApp.swift
@@ -6,6 +6,34 @@ struct MadeiraApp: App {
         // ml1172: read the screen on the main thread; library entries, whose
         // default Resolution comes from it, are also made on other threads.
         _ = ResolutionChoices.screen
+        // This app has its own bundle/container. Seed the runtime profile once;
+        // subsequent user configuration is retained unchanged.
+        if let url = MadeiraConfig.url, !MadeiraConfig.present {
+            let profile = """
+            # AnyPS5 iPad runtime profile, version 1.
+            # Guest addresses are retained; physical pages are committed on demand.
+            env.MADEIRA_FEX_AVX = 1
+            env.APS5_GUEST_ARENA_LAZY = 1
+            env.APS5_GUEST_ARENA_BASE = 0x7400000000
+            env.APS5_GUEST_ARENA_SIZE = 0x100000000
+            env.APS5_GUEST_ARENA_CHUNK = 0x10000000
+            env.MADEIRA_CONTROLS_XBOX_DEFAULT = 1
+            env.MADEIRA_FRAMEGEN = 0
+            d3d12 = 0
+            """
+            do {
+                try FileManager.default.createDirectory(at: url.deletingLastPathComponent(), withIntermediateDirectories: true)
+                try (profile + "\n").write(to: url, atomically: true, encoding: .utf8)
+            } catch {
+                NSLog("[anyps5] Could not create initial runtime profile: %@", String(describing: error))
+            }
+        }
+        // Touch controls read their defaults before Wine exports cfg env lines.
+        for name in ["MADEIRA_FEX_AVX", "APS5_GUEST_ARENA_LAZY", "APS5_GUEST_ARENA_BASE",
+                     "APS5_GUEST_ARENA_SIZE", "APS5_GUEST_ARENA_CHUNK", "MADEIRA_CONTROLS_XBOX_DEFAULT"] {
+            if let value = MadeiraConfig.get("env." + name) { setenv(name, value, 1) }
+        }
+
     }
 
     var body: some Scene {
@@ -17,8 +45,8 @@ struct MadeiraApp: App {
                     HardwareInput.shared.start()
                     JITNetworkShortcut.shared.restoreLeftover()   // also starts its network path monitor
                 }
-                // madeira://jit-network/... (the Madeira JIT shortcut returning, JITNetwork.swift),
-                // else madeira://play?exe=... (Home Screen shortcuts, SavesAndShortcuts.swift).
+                // anyps5ipad://jit-network/... (the Madeira JIT shortcut returning, JITNetwork.swift),
+                // else anyps5ipad://play?exe=... (Home Screen shortcuts, SavesAndShortcuts.swift).
                 .onOpenURL { url in if !JITNetworkShortcut.shared.handle(url) { ShortcutRouter.shared.handle(url) } }
         }
     }
