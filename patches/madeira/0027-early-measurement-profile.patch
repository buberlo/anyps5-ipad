diff --git a/app/Madeira/Library.swift b/app/Madeira/Library.swift
index 1f8bd51..804a862 100644
--- a/app/Madeira/Library.swift
+++ b/app/Madeira/Library.swift
@@ -545,6 +545,16 @@ struct LibraryEntry: Codable, Identifiable {
         } catch {
             LogStore.shared.log("[game-cfg] this game's config could not be written: \(error.localizedDescription)")
         }
+        // Native reporters and FEX read these before Wine imports its late cfg.
+        // Export the selected host-only switches before the JIT pool is taken.
+        // General game env lines still use WineProcessBridge's normal parser.
+        for name in ["APS5_MEASURE", "APS5_PERF_REPORT", "FEX_TSOENABLED",
+                     "FEX_HALFBARRIERTSOENABLED", "FEX_VECTORTSOENABLED",
+                     "FEX_MEMCPYSETTSOENABLED", "FEX_MULTIBLOCK", "FEX_VOLATILEMETADATA"] {
+            if let value = MadeiraConfig.gameValue("env." + name) ?? MadeiraConfig.get("env." + name) {
+                setenv(name, value, 1)
+            }
+        }
         fputs("[frontend] launch profile applied\n", stderr)
         if usesLaunchOptions {
             fputs("[library] ml1163 start=\(runsInDesktop ? "desktop" : "direct") batch=\(isBatch ? 1 : 0) services=\(servicesScript != nil ? 1 : 0) cwd=\(launchDirectory)\n", stderr)
