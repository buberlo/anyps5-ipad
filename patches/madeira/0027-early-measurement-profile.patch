+                     "APS5_MEASURE", "APS5_PERF_REPORT", "FEX_TSOENABLED", "FEX_HALFBARRIERTSOENABLED",
+                     "FEX_VECTORTSOENABLED", "FEX_MEMCPYSETTSOENABLED", "FEX_MULTIBLOCK", "FEX_VOLATILEMETADATA"] {
             if let value = MadeiraConfig.get("env." + name) { setenv(name, value, 1) }
         }
 
