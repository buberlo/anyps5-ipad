diff --git a/build/ntdll-unix/aps5_atomic_fault.h b/build/ntdll-unix/aps5_atomic_fault.h
new file mode 100644
index 0000000..42cfdb5
--- /dev/null
+++ b/build/ntdll-unix/aps5_atomic_fault.h
@@ -0,0 +1,19 @@
+#ifndef APS5_ATOMIC_FAULT_H
+#define APS5_ATOMIC_FAULT_H
+#include <stdint.h>
+// LSE atomics are read-modify-write even when the syndrome labels the
+// read phase. The ordinary write-fault handler must still check page ownership
+// and permissions; this only reports the instruction's access kind.
+static inline int aps5_arm64_rmw(uint32_t insn)
+{
+    if ((insn & 0x3fa07c00u) == 0x08a07c00u) return 1; // CAS/CASA/CASL/CASAL
+    if ((insn & 0xbfa07c00u) == 0x08207c00u) { // CASP and its A/L variants
+        // Pair forms require even comparison and replacement registers.
+        return (((insn >> 16) | insn) & 1u) == 0;
+    }
+    // LSE LDADD/LDCLR/LDEOR/LDSET/min/max and SWP, all sizes and A/L modes.
+    // Opcode 0xc is LDAPR: a genuine load, deliberately excluded.
+    if ((insn & 0x3b200c00u) == 0x38200000u && ((insn >> 12) & 15u) <= 8u) return 1;
+    return 0;
+}
+#endif
