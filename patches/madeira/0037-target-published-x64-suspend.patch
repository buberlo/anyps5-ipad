  */
+#ifdef WINE_IOS
+#define IOS_X64_SUSPEND_EXCEPTION 0xe0425355u
+static int ios_x64_signal_is_ec( ULONG_PTR pc )
+{
+    extern uint64_t ios_jit_reverse_translate( uint64_t, uint64_t * );
+    uint64_t pe = ios_jit_reverse_translate( pc, NULL );
+    return is_ec_code( pe ? pe : pc );
+}
+
+int ios_x64_signal_suspend_enabled;
+static int ios_x64_signal_trace;
+static __thread int ios_x64_signal_reconstruct;
+static __thread struct {
+    struct syscall_frame *frame;
+    ULONG_PTR pc, sp;
+    UINT64 status;
+    int ready;
+} ios_x64_signal_wait;
+
+/* A context taken inside a native syscall contains its arguments, before the
+ * syscall has produced its return value. Preserve the actual result when the
+ * original syscall completes, then put it back when the guest handler resumes
+ * that syscall's return instruction. Do not invent a successful wait result. */
+UINT64 ios_x64_signal_status( UINT64 status, struct syscall_frame *frame )
+{
+    if (ios_x64_signal_wait.frame == frame && !ios_x64_signal_wait.ready)
+    {
+        ios_x64_signal_wait.status = status;
+        ios_x64_signal_wait.ready = 1;
+        if (ios_x64_signal_trace) dprintf( 2, "[x64-signal] native syscall completed result=%llx original_pc=%llx\n",
+                 (unsigned long long)status, (unsigned long long)ios_x64_signal_wait.pc );
+    }
+    return status;
+}
+
+void ios_x64_signal_restore_status( CONTEXT *context )
+{
+    if (!ios_x64_signal_suspend_enabled) return;
+    if (ios_x64_signal_wait.ready && context->Pc == ios_x64_signal_wait.pc &&
+        context->Sp == ios_x64_signal_wait.sp)
+    {
+        context->X0 = ios_x64_signal_wait.status;
+        ios_x64_signal_wait.frame = NULL;
+        ios_x64_signal_wait.ready = 0;
+        if (ios_x64_signal_trace) dprintf( 2, "[x64-signal] restored actual syscall result=%llx\n",
+                 (unsigned long long)context->X0 );
+    }
+}
+
+
+/* FEX's existing exception rethrow reconstructs the interrupted guest state
+ * into its ordinary Windows ARM64EC exception frame. Consume only our armed
+ * private exception; never publish the native JIT PC as an x86 RIP. */
+int ios_x64_signal_context( CONTEXT *redirect, CONTEXT *guest )
+{
+    struct { CONTEXT context; UINT64 pad[4]; EXCEPTION_RECORD record; } frame;
+    mach_vm_size_t read = 0;
+    TEB *teb;
+    if (!ios_x64_signal_suspend_enabled || !ios_x64_signal_reconstruct) return 0;
+    if (mach_vm_read_overwrite( mach_task_self(), redirect->Sp, sizeof(frame),
+                              (mach_vm_address_t)&frame, &read ) || read != sizeof(frame) ||
+        frame.record.ExceptionCode != IOS_X64_SUSPEND_EXCEPTION) return 0;
+    ios_x64_signal_reconstruct = 0;
+    teb = NtCurrentTeb();
+    if (!teb || !teb->ChpeV2CpuAreaInfo) return 0;
+    *guest = frame.context;
+    teb->ChpeV2CpuAreaInfo->InSimulation = 0;
+    teb->ChpeV2CpuAreaInfo->InSyscallCallback = 0;
+    if (ios_x64_signal_trace) dprintf( 2, "[x64-signal] reconstructed pc=%llx sp=%llx flags=%x\n",
+             (unsigned long long)guest->Pc, (unsigned long long)guest->Sp,
+             (unsigned)guest->ContextFlags );
+    return 1;
+}
