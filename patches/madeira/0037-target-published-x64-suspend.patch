+#include <pthread.h>
+
+/* Default-off diagnostic: Wine pseudo-processes share this native task. */
+int ios_signal_suspend_x64( struct thread *thread )
+{
+    static int enabled = -1;
+    static unsigned reports;
+    pthread_t target;
+    int result;
+    if (enabled < 0)
+    {
+        const char *e = getenv( "APS5_X64_SIGNAL_SUSPEND" );
+        enabled = e && e[0] == '1';
+    }
+    if (!enabled || thread == current || !thread->teb ||
+        thread->process->machine != IMAGE_FILE_MACHINE_AMD64 ||
+        !is_process_init_done( thread->process ) || thread->unix_pid != getpid() ||
+        thread->unix_tid == (unsigned)-1) return 0;
+    if (!(target = pthread_from_mach_thread_np( thread->unix_tid ))) return 0;
+    result = pthread_kill( target, SIGUSR1 );
+    if (reports++ < 8)
+        fprintf( stderr, "[x64-signal] tid=%04x port=%x signal=%d result=%d\n",
+                 thread->id, thread->unix_tid, SIGUSR1, result );
+    return !result;
 }
 
