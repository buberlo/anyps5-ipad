diff --git a/build/ntdll-unix/aps5_veh_state.h b/build/ntdll-unix/aps5_veh_state.h
new file mode 100644
--- /dev/null
+++ b/build/ntdll-unix/aps5_veh_state.h
@@ -0,0 +1,14 @@
+/* Versioned private AnyPS5/Madeira access-violation state transport.
+ * operation 0 reads the latest matching current-thread snapshot; operation 1
+ * prepares one continuation. token and exception PC/SP/address must match.
+ * This structure contains no guest pointers to native CPU state. */
+#ifndef APS5_VEH_STATE_H
+#define APS5_VEH_STATE_H
+#include <stdint.h>
+#define APS5_THREAD_VEH_STATE 0x7fff4151u
+struct aps5_veh_state_info {
+    uint32_t version, operation, code, direction, flags, has_avx;
+    uint64_t rip, rsp, address, resume_rip, resume_rsp, token;
+    uint64_t ymm_upper[32];
+};
+#endif
