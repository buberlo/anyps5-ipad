+    aps5_report_append(&line, "[anyps5-display] {\"schema\":1,\"source\":\"VK_GOOGLE_display_timing\",\"monotonic_ns\":%llu,\"displayed_total\":%llu,\"samples\":%u,\"mean_ns\":%llu,\"p95_ns\":%llu,\"p99_ns\":%llu,\"refresh_ns\":%llu,\"missed_vblanks\":%llu,\"width\":%u,\"height\":%u,\"active\":%d,\"epoch\":%llu,\"swapchain_id\":%llu,\"swapchain_displayed_total\":%llu,\"actual_ns\":%llu,\"histogram_step_ns\":%llu,\"interval_histogram\":[", (unsigned long long)now, (unsigned long long)aps5_vulkan_displayed_count(), s->stats.used, (unsigned long long)mean, (unsigned long long)p95, (unsigned long long)p99, (unsigned long long)s->stats.refresh_ns, (unsigned long long)s->stats.missed_vblanks, s->width, s->height, aps5_display_active, (unsigned long long)aps5_display_epoch, (unsigned long long)s->identity, (unsigned long long)s->stats.count, (unsigned long long)s->stats.last_ns, (unsigned long long)APS5_HISTOGRAM_STEP_NS);
+    for (unsigned bucket = 0; bucket < APS5_HISTOGRAM_BINS; ++bucket)
