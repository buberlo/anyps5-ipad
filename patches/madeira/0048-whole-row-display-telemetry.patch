+/* A uint64_t histogram bucket needs at most 20 digits and one comma. The
+ * extra 2048 bytes cover the fixed schema and every other field at its widest
+ * value. Build the whole row before touching stderr: native dprintf/write
+ * callers bypass stdio's FILE lock, and stderr is an O_APPEND regular file. */
+#define APS5_REPORT_LINE_CAPACITY (2048 + APS5_HISTOGRAM_BINS * 21)
+struct aps5_report_line {
+    char bytes[APS5_REPORT_LINE_CAPACITY];
+    size_t used;
+    int valid;
+};
+static void __attribute__((format(printf, 2, 3))) aps5_report_append(
+        struct aps5_report_line *line, const char *format, ...)
+{
+    if (!line->valid) return;
+    va_list args;
+    va_start(args, format);
+    int length = vsnprintf(line->bytes + line->used, sizeof(line->bytes) - line->used, format, args);
+    va_end(args);
+    if (length < 0 || (size_t)length >= sizeof(line->bytes) - line->used) {
+        line->valid = 0;
+        return;
+    }
+    line->used += (size_t)length;
+}
+static int aps5_report_emit(const struct aps5_report_line *line)
+{
+    if (!line->valid || !line->used) return 0;
+    ssize_t written;
+    do { written = write(STDERR_FILENO, line->bytes, line->used); }
+    while (written < 0 && errno == EINTR);
+    /* Do not append a short-write tail: another writer can intervene and turn
+     * corrupt output into an apparently valid report. Keep parser rejection. */
+    return written == (ssize_t)line->used;
+}
 static uint64_t aps5_now_ns(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec; }
