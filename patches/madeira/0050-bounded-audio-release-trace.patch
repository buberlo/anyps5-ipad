+}
+static void ios_release_trace_record(struct ios_stream *s, UINT32 requested,
+                                     UINT32 actual, UINT32 flags, uint64_t wr)
+{
+    struct aps5_release_trace *trace = atomic_load_explicit(&g_audio_release_trace, memory_order_acquire);
+    struct aps5_release_format format;
+    struct aps5_release_stamp stamp;
+    size_t available;
+    if (!trace) return;
+    format = ios_release_trace_format(s);
+    stamp.monotonic_ns = aps5_release_now_ns();
+    stamp.postmix_epoch = atomic_load_explicit(&g_dev.cb_epoch, memory_order_acquire);
+    stamp.raw_write_pos = wr;
+    stamp.raw_play_pos = atomic_load_explicit(&s->play_pos, memory_order_acquire);
+    stamp.requested_frames = requested;
+    stamp.actual_frames = actual;
+    stamp.flags = flags;
+    available = s->frame_bytes && s->scratch_frames <= SIZE_MAX / s->frame_bytes
+                ? (size_t)s->scratch_frames * s->frame_bytes : 0;
+    aps5_release_record(trace, (uintptr_t)s, s->render_scratch, available, &format, &stamp);
+}
 
