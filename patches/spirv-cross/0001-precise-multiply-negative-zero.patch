+    vec<T, Cols> res = vec<T, Cols>(T(-0.0));
     for (uint i = Rows; i > 0; --i)
     {
         vec<T, Cols> tmp(0);
@@ -69,7 +69,7 @@ template<typename T, int Cols, int Rows>
