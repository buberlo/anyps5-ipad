 template<typename T>
 [[clang::optnone]] T spvFMul(T l, T r)
 {
-    return fma(l, r, T(0));
+    return fma(l, r, T(-0.0));
 }
 
 template<typename T, int Cols, int Rows>
 [[clang::optnone]] vec<T, Cols> spvFMulVectorMatrix(vec<T, Rows> v, matrix<T, Cols, Rows> m)
