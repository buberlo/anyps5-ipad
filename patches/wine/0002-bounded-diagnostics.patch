         }
     }
 
+    madeira_exception_diagnostics = madeira_diagnostic_switch(L"MADEIRA_DIAGNOSTICS") ||
+                                  madeira_diagnostic_switch(L"MADEIRA_EXCEPTION_DIAGNOSTICS");
+    if (madeira_exception_diagnostics)
+    {
+        madeira_exception_start_ms = user_shared_data->TickCount.LowPart;
+        madeira_exception_duration_ms = madeira_exception_seconds() * 1000;
+    }
+
     return STATUS_SUCCESS;
 }
 
