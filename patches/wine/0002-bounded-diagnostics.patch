+/* Read before execution, never query CRT environment locks in an exception. */
+static BOOL madeira_exception_diagnostics;
+static ULONG madeira_exception_start_ms, madeira_exception_duration_ms;
+static BOOL madeira_diagnostic_switch(const WCHAR *key)
+{
+    UNICODE_STRING name, value;
+    WCHAR buffer[2];
+    RtlInitUnicodeString(&name, key);
+    value.Buffer = buffer;
+    value.Length = 0;
+    value.MaximumLength = sizeof(buffer);
+    return !RtlQueryEnvironmentVariable_U(NULL, &name, &value) &&
+           value.Length == sizeof(WCHAR) && buffer[0] == '1';
+}
+static ULONG madeira_exception_seconds(void)
+{
+    UNICODE_STRING name, value;
+    WCHAR buffer[32];
+    ULONG seconds = 0, i;
+    RtlInitUnicodeString(&name, L"MADEIRA_DIAGNOSTICS_SECONDS");
+    value.Buffer = buffer;
+    value.Length = 0;
+    value.MaximumLength = sizeof(buffer);
+    if (RtlQueryEnvironmentVariable_U(NULL, &name, &value) || !value.Length) return 30;
+    for (i = 0; i < value.Length / sizeof(WCHAR); ++i)
+    {
+        if (buffer[i] < '0' || buffer[i] > '9') return 30;
+        if (seconds <= 60) seconds = seconds * 10 + buffer[i] - '0';
+    }
+    return !seconds ? 30 : seconds > 60 ? 60 : seconds;
+}
+static BOOL madeira_exception_diagnostics_enabled(void)
+{
+    /* Shared tick data: no CRT locks, syscall, allocation or log in a handler.
+     * Unsigned subtraction remains correct across the 32-bit tick wrap. */
+    return madeira_exception_diagnostics &&
+        (ULONG)(user_shared_data->TickCount.LowPart - madeira_exception_start_ms) < madeira_exception_duration_ms;
+}
