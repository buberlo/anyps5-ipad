diff --git a/include/wine/madeira_diagnostics.h b/include/wine/madeira_diagnostics.h
new file mode 100644
index 00000000..7b62a758
--- /dev/null
+++ b/include/wine/madeira_diagnostics.h
@@ -0,0 +1,66 @@
+/* Madeira host diagnostics policy. SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef __WINE_MADEIRA_DIAGNOSTICS_H
+#define __WINE_MADEIRA_DIAGNOSTICS_H
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/* Diagnostic switches are opt-in: absence, empty, 0, and misspellings stay off.
+ * Set before runtime startup; gameplay never changes the process environment. */
+static inline int madeira_diagnostics_value(const char *value)
+{
+    return value && value[0] == '1' && value[1] == 0;
+}
+static inline unsigned madeira_diagnostics_seconds(void)
+{
+    const char *value = getenv("MADEIRA_DIAGNOSTICS_SECONDS");
+    char *end;
+    unsigned long seconds;
+    if (!value || *value < '0' || *value > '9') return 30;
+    seconds = strtoul(value, &end, 10);
+    if (*end || !seconds) return 30;
+    return seconds > 60 ? 60 : (unsigned)seconds;
+}
+static inline double madeira_diagnostics_now(void)
+{
+    struct timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now)) return 0;
+    return now.tv_sec + now.tv_nsec / 1e9;
+}
+static inline double madeira_diagnostics_deadline(void)
+{
+    double now = madeira_diagnostics_now();
+    return now ? now + madeira_diagnostics_seconds() : 0;
+}
+/* One bounded capture per host translation unit/process. Even logging gates
+ * expire; enabling diagnostics cannot leave a sampler logging all session. */
+static inline int madeira_diagnostics_enabled(const char *feature)
+{
+    static unsigned long long deadline_ns;
+    unsigned long long expected = 0, deadline, now;
+    if (!madeira_diagnostics_value(getenv("MADEIRA_DIAGNOSTICS")) &&
+        !madeira_diagnostics_value(getenv(feature))) return 0;
+    now = (unsigned long long)(madeira_diagnostics_now() * 1e9);
+    if (!now) return 0; /* A failed monotonic clock cannot enable unlimited tracing. */
+    deadline = __atomic_load_n(&deadline_ns, __ATOMIC_RELAXED);
+    if (!deadline) {
+        deadline = now + (unsigned long long)madeira_diagnostics_seconds() * 1000000000ULL;
+        if (!__atomic_compare_exchange_n(&deadline_ns, &expected, deadline, 0,
+                                        __ATOMIC_RELAXED, __ATOMIC_RELAXED)) deadline = expected;
+    }
+    return now < deadline;
+}
+/* Only complete, single FEX DEBUG/INFO records. Unknown records, errors,
+ * asserts, multiline messages and partial records always remain visible. */
+static inline int madeira_fex_verbose_record(const char *text, size_t length)
+{
+    size_t i = 2, digits = 0;
+    if (length < 6 || (text[0] != 'D' && text[0] != 'I') || text[1] != ' ') return 0;
+    while (i < length && ((text[i] >= '0' && text[i] <= '9') ||
+           (text[i] >= 'A' && text[i] <= 'F') || (text[i] >= 'a' && text[i] <= 'f')))
+    { ++i; ++digits; }
+    if (!digits || i >= length || text[i] != ' ' || text[length - 1] != '\n') return 0;
+    return memchr(text, '\n', length - 1) == NULL;
+}
+#endif
