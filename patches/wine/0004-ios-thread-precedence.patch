diff --git a/server/ios_thread_precedence.h b/server/ios_thread_precedence.h
new file mode 100644
--- /dev/null
+++ b/server/ios_thread_precedence.h
@@ -0,0 +1,109 @@
+/* Local iOS precedence bridge. Existing QoS and ECO policies are unchanged. */
+#ifndef WINE_IOS_THREAD_PRECEDENCE_H
+#define WINE_IOS_THREAD_PRECEDENCE_H
+
+#include <stdlib.h>
+#include <string.h>
+#ifndef IOS_THREAD_PRECEDENCE_MOCK_MACH
+#include <mach/mach.h>
+#include <mach/thread_policy.h>
+#endif
+
+static int ios_precedence_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *value = getenv("MADEIRA_IOS_THREAD_PRECEDENCE");
+        enabled = value && !strcmp(value, "1");
+    }
+    return enabled;
+}
+
+static unsigned int ios_precedence_error(kern_return_t error)
+{
+    if (error == KERN_SUCCESS) return STATUS_SUCCESS;
+    if (error == KERN_NO_ACCESS || error == KERN_PROTECTION_FAILURE) return STATUS_ACCESS_DENIED;
+    if (error == KERN_INVALID_ARGUMENT) return STATUS_INVALID_PARAMETER;
+    if (error == KERN_TERMINATED || error == KERN_INVALID_NAME || error == KERN_INVALID_RIGHT)
+        return STATUS_THREAD_IS_TERMINATING;
+    if (error == KERN_NOT_SUPPORTED) return STATUS_NOT_SUPPORTED;
+    return STATUS_UNSUCCESSFUL;
+}
+
+/* Called only during the client/server startup handshake, never by a later
+ * priority request. Hold the send right for the server thread object's lifetime
+ * so a departed client's recycled port name cannot select a different thread. */
+static unsigned int ios_precedence_retain(int unix_tid, mach_port_t *owned_port,
+                                          unsigned long long *identity)
+{
+    struct thread_identifier_info info;
+    mach_msg_type_number_t count = THREAD_IDENTIFIER_INFO_COUNT;
+    mach_msg_type_name_t type;
+    kern_return_t error;
+    if (unix_tid == -1 || !unix_tid || *owned_port) return STATUS_INVALID_HANDLE;
+    error = mach_port_extract_right(mach_task_self(), (mach_port_name_t)unix_tid,
+                                   MACH_MSG_TYPE_COPY_SEND, owned_port, &type);
+    if (error != KERN_SUCCESS) return ios_precedence_error(error);
+    /* Even validation failures retain ownership until object destruction. */
+    if (type != MACH_MSG_TYPE_PORT_SEND || !*owned_port || *owned_port == MACH_PORT_DEAD)
+        return STATUS_INVALID_HANDLE;
+    error = thread_info(*owned_port, THREAD_IDENTIFIER_INFO, (thread_info_t)&info, &count);
+    if (error != KERN_SUCCESS) return ios_precedence_error(error);
+    if (count != THREAD_IDENTIFIER_INFO_COUNT || !info.thread_id) return STATUS_INVALID_HANDLE;
+    *identity = info.thread_id;
+    return STATUS_SUCCESS;
+}
+
+static unsigned int ios_precedence_apply(mach_port_t port, unsigned long long identity, int importance)
+{
+    struct thread_identifier_info info;
+    struct thread_precedence_policy previous, observed, requested;
+    mach_msg_type_number_t count = THREAD_IDENTIFIER_INFO_COUNT;
+    boolean_t defaults = FALSE;
+    kern_return_t error;
+    unsigned int status;
+    if (!port || port == MACH_PORT_DEAD || !identity) return STATUS_INVALID_HANDLE;
+    if (importance < -31 || importance > 32) return STATUS_NOT_SUPPORTED;
+    error = thread_info(port, THREAD_IDENTIFIER_INFO, (thread_info_t)&info, &count);
+    if (error != KERN_SUCCESS) return ios_precedence_error(error);
+    if (count != THREAD_IDENTIFIER_INFO_COUNT || info.thread_id != identity) return STATUS_INVALID_HANDLE;
+    count = THREAD_PRECEDENCE_POLICY_COUNT;
+    error = thread_policy_get(port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&previous,
+                              &count, &defaults);
+    if (error != KERN_SUCCESS) return ios_precedence_error(error);
+    if (count != THREAD_PRECEDENCE_POLICY_COUNT || defaults) return STATUS_UNSUCCESSFUL;
+    requested.importance = importance;
+    error = thread_policy_set(port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&requested,
+                              THREAD_PRECEDENCE_POLICY_COUNT);
+    if (error != KERN_SUCCESS) return ios_precedence_error(error);
+    count = THREAD_PRECEDENCE_POLICY_COUNT;
+    defaults = FALSE;
+    error = thread_policy_get(port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&observed,
+                              &count, &defaults);
+    if (error == KERN_SUCCESS && count == THREAD_PRECEDENCE_POLICY_COUNT && !defaults &&
+        observed.importance == importance) return STATUS_SUCCESS;
+    status = error == KERN_SUCCESS ? STATUS_UNSUCCESSFUL : ios_precedence_error(error);
+    /* A failed readback never counts as success. Restore the previous single
+     * policy and verify it; callers also keep their previous Wine metadata. */
+    error = thread_policy_set(port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&previous,
+                              THREAD_PRECEDENCE_POLICY_COUNT);
+    if (error != KERN_SUCCESS) return STATUS_UNSUCCESSFUL;
+    count = THREAD_PRECEDENCE_POLICY_COUNT;
+    defaults = FALSE;
+    error = thread_policy_get(port, THREAD_PRECEDENCE_POLICY, (thread_policy_t)&observed,
+                              &count, &defaults);
+    if (error != KERN_SUCCESS || count != THREAD_PRECEDENCE_POLICY_COUNT || defaults ||
+        observed.importance != previous.importance) return STATUS_UNSUCCESSFUL;
+    return status;
+}
+
+static unsigned int ios_precedence_release(mach_port_t *owned_port)
+{
+    kern_return_t error;
+    if (!*owned_port) return STATUS_SUCCESS;
+    error = mach_port_deallocate(mach_task_self(), *owned_port);
+    if (error == KERN_SUCCESS) *owned_port = MACH_PORT_NULL;
+    return ios_precedence_error(error);
+}
+#endif
