+/* Explicit requests only: bootstrap applies are deliberately not logged. The
+ * bounded policy readback is evidence of Mach precedence, not a QoS or latency
+ * guarantee. A queued prebootstrap request has no native readback yet. */
+static void ios_trace_explicit_priority(struct thread *thread, const char *kind,
+                                       int requested, long long nt_priority, unsigned int status)
+{
+    static int trace_enabled = -1;
+    static unsigned int changes;
+    long long effective = nt_priority;
+    int applied, importance_valid;
+    if (!ios_precedence_enabled()) return;
+    if (trace_enabled == -1)
+    {
+        const char *value = getenv("MADEIRA_IOS_THREAD_PRECEDENCE_TRACE");
+        trace_enabled = value && !strcmp(value, "1");
+    }
+    if (!trace_enabled || changes >= 32) return;
+    ++changes;
+    if (!thread->disable_boost && effective < LOW_REALTIME_PRIORITY)
+    {
+        if (get_process_first_thread(thread->process) == thread) ++effective;
+        effective = min(effective, LOW_REALTIME_PRIORITY - 1);
+    }
+    applied = !status && thread->state == RUNNING && thread->unix_tid != -1 &&
+              thread->ios_priority_port && thread->ios_priority_identity;
+    importance_valid = effective >= 1 && effective < LOW_REALTIME_PRIORITY;
+    fprintf(stderr, "[ios-thread-priority] explicit=%s tid=%04x requested=%d effective=%lld importance=%d importance-valid=%d status=%08x precedence-readback-match=%d queued-before-bootstrap=%d\n",
+            kind, thread->id, requested, effective,
+            importance_valid ? get_mach_importance((int)effective) : 0, importance_valid, status,
+            applied, !status && thread->unix_tid == -1);
+}
+#endif
 
